# KhananDrishti Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/khanandrishti

# Google Gemini AI API Key (optional — API falls back to deterministic simulation if not set)
GEMINI_API_KEY=

# CORS Allowed Origin (frontend URL)
CORS_ORIGIN=http://localhost:5173
