    replacement_chunks {
      target_content: "import React, { useState } from \"react\";\nimport { MineSite, StatutoryViolation, UserRole, Subsidiary } from \"../types\";\nimport {\n  ShieldCheck,\n  AlertTriangle,\n  Flame,\n  Activity,\n  Award,\n  TrendingUp,\n  Clock,\n  ArrowUpRight,\n  Sparkles,\n  Layers,\n  FileCheck2,\n  HardHat,\n  ChevronRight,\n  Filter,\n  CheckCircle,\n  AlertOctagon,\n  Download,\n  Eye,\n} from \"lucide-react\";\n\ninterface CommandHubProps {\n  currentRole: UserRole;\n  selectedMine: MineSite;\n  allMines: MineSite[];\n  violations: StatutoryViolation[];\n  onSelectMine: (mineId: string) => void;\n  onNavigateTab: (tab: string) => void;\n}\n\nexport const CommandHub: React.FC<CommandHubProps> = ({\n  currentRole,\n  selectedMine,\n  allMines,\n  violations,\n  onSelectMine,\n  onNavigateTab,\n}) => {\n  const [filterCategory, setFilterCategory] = useState<string>(\"ALL\");\n\n  // Calculate aggregates\n  const totalProduction = allMines.reduce((acc, m) => acc + m.currentProductionMT, 0);\n  const totalEcCap = allMines.reduce((acc, m) => acc + m.ecCapMTPA, 0);\n  const avgCompliance = Math.round(\n    allMines.reduce((acc, m) => acc + m.complianceScore, 0) / allMines.length\n  );\n  const openViolationsCount = violations.filter(\n    (v) => v.status === \"Open\" || v.status === \"Escalated_Level2\" || v.status === \"Escalated_Level3\"\n  ).length;\n  const criticalViolations = violations.filter((v) => v.severity === \"Critical\");\n\n  const filteredViolations =\n    filterCategory === \"ALL\"\n      ? violations\n      : violations.filter((v) => v.category === filterCategory);\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Role-Specific Context Banner */}\n      <div className=\"bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 border border-slate-700/70 rounded-2xl p-4 sm:p-5 shadow-lg flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n        <div className=\"flex items-center space-x-3.5\">\n          <div className=\"p-3 bg-amber-500/10 border border-amber-500/30 rounded-xl text-amber-400\">\n            {currentRole === \"mine_official\" && <HardHat className=\"w-6 h-6\" />}\n            {currentRole === \"corporate_hq\" && <Award className=\"w-6 h-6\" />}\n            {currentRole === \"regulatory_authority\" && <AlertOctagon className=\"w-6 h-6 text-red-400\" />}\n          </div>\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"text-xs font-bold uppercase tracking-wider text-amber-400\">\n                {currentRole === \"mine_official\" && \"Active Colliery Portal \342\200\242 On-Site Operations\"}\n                {currentRole === \"corporate_hq\" && \"Corporate Multi-Subsidiary Command Center\"}\n                {currentRole === \"regulatory_authority\" && \"DGMS / MoEFCC Statutory Surveillance Console\"}\n              </span>\n              <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping\" />\n            </div>\n            <h2 className=\"text-lg sm:text-xl font-bold text-white mt-0.5\">\n              {currentRole === \"mine_official\"\n                ? `${selectedMine.name} (${selectedMine.subsidiary}) - Mine Safety & Compliance Health`\n                : \"Pan-India Coal Mining Governance & Statutory Compliance Index\"}\n            </h2>\n            <p className=\"text-xs text-slate-400 mt-0.5\">\n              Targeting zero fatal accidents, 100% digital Form-B registers, and real-time environmental clearance ceiling adherence.\n            </p>\n          </div>\n        </div>\n\n        <div className=\"flex flex-wrap items-center gap-2 self-stretch md:self-auto\">\n          <button\n            onClick={() => onNavigateTab(\"field_inspection\")}\n            className=\"flex-1 md:flex-none flex items-center justify-center space-x-2 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-bold px-4 py-2 rounded-xl text-xs shadow-lg shadow-amber-500/20 transition-all cursor-pointer\"\n          >\n            <HardHat className=\"w-4 h-4\" />\n            <span>Launch Geo-Inspection</span>\n          </button>\n          <button\n            onClick={() => onNavigateTab(\"ai_sentinel\")}\n            className=\"flex-1 md:flex-none flex items-center justify-center space-x-2 bg-slate-800 hover:bg-slate-700 text-amber-300 border border-slate-600 px-4 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer\"\n          >\n            <Sparkles className=\"w-4 h-4 text-amber-400\" />\n            <span>AI Risk Radar</span>\n          </button>\n        </div>\n      </div>\n\n      {/* 4 Core Statutory KPI Cards */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n        {/* KPI 1: Compliance Health Score */}\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-4 sm:p-5 relative overflow-hidden group hover:border-amber-500/40 transition-all shadow-md\">\n          <div className=\"flex justify-between items-start\">\n            <span className=\"text-xs font-semibold text-slate-400 uppercase tracking-wider\">\n              Statutory Compliance Index\n            </span>\n            <span className=\"p-2 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20\">\n              <ShieldCheck className=\"w-4 h-4\" />\n            </span>\n          </div>\n          <div className=\"mt-3 flex items-baseline space-x-2\">\n            <span className=\"text-3xl font-black text-white\">\n              {currentRole === \"mine_official\" ? selectedMine.complianceScore : avgCompliance}%\n            </span>\n            <span className=\"text-xs font-semibold text-emerald-400 flex items-center\">\n              <TrendingUp className=\"w-3 h-3 mr-0.5\" /> +2.8% MoM\n            </span>\n          </div>\n          <div className=\"mt-2 flex items-center justify-between text-xs text-slate-400\">\n            <span>Ministry Star Rating:</span>\n            <div className=\"flex items-center text-amber-400\">\n              {Array.from({ length: selectedMine.starRating }).map((_, i) => (\n                <Award key={i} className=\"w-3.5 h-3.5 fill-amber-400\" />\n              ))}\n              <span className=\"ml-1 text-[11px] font-bold text-amber-300\">\n                ({selectedMine.starRating}-Star Mine)\n              </span>\n            </div>\n          </div>\n          <div className=\"w-full bg-slate-800 h-1.5 rounded-full mt-3 overflow-hidden\">\n            <div\n              className=\"bg-gradient-to-r from-emerald-500 to-amber-400 h-full rounded-full transition-all duration-700\"\n              style={{\n                width: `${currentRole === \"mine_official\" ? selectedMine.complianceScore : avgCompliance}%`,\n              }}\n            />\n          </div>\n        </div>\n\n        {/* KPI 2: Open Violations & Notices */}\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-4 sm:p-5 relative overflow-hidden group hover:border-red-500/40 transition-all shadow-md\">\n          <div className=\"flex justify-between items-start\">\n            <span className=\"text-xs font-semibold text-slate-400 uppercase tracking-wider\">\n              Open Statutory Notices\n            </span>\n            <span className=\"p-2 rounded-lg bg-red-500/10 text-red-400 border border-red-500/20\">\n              <AlertTriangle className=\"w-4 h-4\" />\n            </span>\n          </div>\n          <div className=\"mt-3 flex items-baseline space-x-2\">\n            <span className=\"text-3xl font-black text-white\">\n              {currentRole === \"mine_official\" ? selectedMine.activeViolations : openViolationsCount}\n            </span>\n            <span className=\"text-xs font-semibold text-red-400\">\n              {criticalViolations.length} Critical (DGMS Sec 22)\n            </span>\n          </div>\n          <div className=\"mt-2 text-xs text-slate-400 flex items-center justify-between\">\n            <span>Pending Action Taken Reports:</span>\n            <span className=\"text-amber-400 font-bold\">2 ATRs due &lt; 7 days</span>\n          </div>\n          <div className=\"w-full bg-slate-800 h-1.5 rounded-full mt-3 overflow-hidden\">\n            <div className=\"bg-red-500 h-full rounded-full\" style={{ width: \"35%\" }} />\n          </div>\n        </div>\n\n        {/* KPI 3: Production vs Approved EC Cap */}\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-4 sm:p-5 relative overflow-hidden group hover:border-amber-500/40 transition-all shadow-md\">\n          <div className=\"flex justify-between items-start\">\n            <span className=\"text-xs font-semibold text-slate-400 uppercase tracking-wider\">\n              Production vs EC Cap\n            </span>\n            <span className=\"p-2 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20\">\n              <Activity className=\"w-4 h-4\" />\n            </span>\n          </div>\n          <div className=\"mt-3 flex items-baseline space-x-2\">\n            <span className=\"text-3xl font-black text-white\">\n              {currentRole === \"mine_official\"\n                ? `${selectedMine.currentProductionMT} MT`\n                : `${totalProduction.toFixed(1)} MT`}\n            </span>\n            <span className=\"text-xs text-slate-400\">\n              / {currentRole === \"mine_official\" ? selectedMine.ecCapMTPA : totalEcCap} MTPA\n            </span>\n          </div>\n          <div className=\"mt-2 text-xs text-slate-400 flex items-center justify-between\">\n            <span>Capacity Utilization:</span>\n            <span className=\"text-emerald-400 font-bold\">\n              {Math.round(\n                ((currentRole === \"mine_official\" ? selectedMine.currentProductionMT : totalProduction) /\n                  (currentRole === \"mine_official\" ? selectedMine.ecCapMTPA : totalEcCap)) *\n                  100\n              )}\n              % (Legally Compliant)\n            </span>\n          </div>\n          <div className=\"w-full bg-slate-800 h-1.5 rounded-full mt-3 overflow-hidden\">\n            <div className=\"bg-amber-400 h-full rounded-full\" style={{ width: \"78%\" }} />\n          </div>\n        </div>\n\n        {/* KPI 4: Environmental & Sensor Sentinel */}\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-4 sm:p-5 relative overflow-hidden group hover:border-blue-500/40 transition-all shadow-md\">\n          <div className=\"flex justify-between items-start\">\n            <span className=\"text-xs font-semibold text-slate-400 uppercase tracking-wider\">\n              IoT Sensor Telemetry\n            </span>\n            <span className=\"p-2 rounded-lg bg-blue-500/10 text-blue-400 border border-blue-500/20\">\n              <Flame className=\"w-4 h-4\" />\n            </span>\n          </div>\n          <div className=\"mt-3 grid grid-cols-2 gap-2 text-xs\">\n            <div className=\"bg-slate-950/60 p-1.5 rounded border border-slate-800\">\n              <span className=\"text-slate-500 block text-[10px]\">Dust PM10</span>\n              <span className=\"font-bold text-slate-200\">\n                {selectedMine.telemetry.dustPm10} \302\265g/m\302\263\n              </span>\n            </div>\n            <div className=\"bg-slate-950/60 p-1.5 rounded border border-slate-800\">\n              <span className=\"text-slate-500 block text-[10px]\">OB Slope Disp.</span>\n              <span\n                className={`font-bold ${\n                  selectedMine.telemetry.slopeDisplacementMm > 10 ? \"text-red-400\" : \"text-emerald-400\"\n                }`}\n              >\n                {selectedMine.telemetry.slopeDisplacementMm} mm\n              </span>\n            </div>\n          </div>\n          <div className=\"mt-2 text-[11px] text-slate-400 flex items-center justify-between\">\n            <span>Water pH: <strong className=\"text-slate-200\">{selectedMine.telemetry.waterPh}</strong></span>\n            <span>Noise: <strong className=\"text-slate-200\">{selectedMine.telemetry.noiseDb} dB</strong></span>\n          </div>\n          <div className=\"w-full bg-slate-800 h-1.5 rounded-full mt-2.5 overflow-hidden\">\n            <div className=\"bg-blue-400 h-full rounded-full\" style={{ width: \"90%\" }} />\n          </div>\n        </div>\n      </div>\n\n      {/* Main Grid: Multi-Mine League Table + Statutory Notices & Escalations */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Left 2 Cols: Multi-Mine Compliance League Table */}\n        <div className=\"lg:col-span-2 bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg flex flex-col justify-between\">\n          <div>\n            <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-slate-800\">\n              <div>\n                <h3 className=\"text-base font-bold text-white flex items-center gap-2\">\n                  <Layers className=\"w-4 h-4 text-amber-400\" />\n                  <span>Subsidiary & Mine Compliance Benchmarking</span>\n                </h3>\n                <p className=\"text-xs text-slate-400\">\n                  Ranking across Coal India subsidiaries based on DGMS audits, MoEFCC ATRs, and Star Rating indicators.\n                </p>\n              </div>\n              <button\n                onClick={() => onNavigateTab(\"gis_map\")}\n                className=\"text-xs text-amber-400 hover:text-amber-300 font-semibold flex items-center space-x-1\"\n              >\n                <span>View GIS Map</span>\n                <ArrowUpRight className=\"w-3.5 h-3.5\" />\n              </button>\n            </div>\n\n            {/* Table */}\n            <div className=\"overflow-x-auto mt-4\">\n              <table className=\"w-full text-left text-xs\">\n                <thead>\n                  <tr className=\"text-slate-400 border-b border-slate-800\">\n                    <th className=\"pb-3 font-semibold\">Mine / Project</th>\n                    <th className=\"pb-3 font-semibold\">Subsidiary</th>\n                    <th className=\"pb-3 font-semibold\">Type</th>\n                    <th className=\"pb-3 font-semibold\">Star Rating</th>\n                    <th className=\"pb-3 font-semibold\">Compliance Index</th>\n                    <th className=\"pb-3 font-semibold\">Open Violations</th>\n                    <th className=\"pb-3 font-semibold text-right\">Action</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-slate-800/60\">\n                  {allMines.map((mine) => {\n                    const isSelected = mine.id === selectedMine.id;\n                    return (\n                      <tr\n                        key={mine.id}\n                        onClick={() => onSelectMine(mine.id)}\n                        className={`hover:bg-slate-800/50 cursor-pointer transition-all ${\n                          isSelected ? \"bg-amber-500/10\" : \"\"\n                        }`}\n                      >\n                        <td className=\"py-3 font-medium text-slate-100 flex items-center space-x-2\">\n                          <span\n                            className={`w-2 h-2 rounded-full ${\n                              mine.status === \"Operational\"\n                                ? \"bg-emerald-400\"\n                                : mine.status === \"Restricted_Notice\"\n                                ? \"bg-red-500 animate-pulse\"\n                                : \"bg-amber-400\"\n                            }`}\n                          />\n                          <span className=\"truncate max-w-[170px]\">{mine.name}</span>\n                        </td>\n                        <td className=\"py-3\">\n                          <span className=\"px-2 py-0.5 rounded text-[11px] font-bold bg-slate-800 text-amber-300 border border-slate-700\">\n                            {mine.subsidiary}\n                          </span>\n                        </td>\n                        <td className=\"py-3 text-slate-400\">{mine.type}</td>\n                        <td className=\"py-3\">\n                          <div className=\"flex items-center text-amber-400\">\n                            <span className=\"font-bold mr-1\">{mine.starRating}</span>\n                            <Award className=\"w-3.5 h-3.5 fill-amber-400\" />\n                          </div>\n                        </td>\n                        <td className=\"py-3\">\n                          <div className=\"flex items-center space-x-2\">\n                            <span className=\"font-bold text-slate-200\">{mine.complianceScore}%</span>\n                            <div className=\"w-16 bg-slate-800 h-1.5 rounded-full overflow-hidden\">\n                              <div\n                                className={`h-full rounded-full ${\n                                  mine.complianceScore >= 90\n                                    ? \"bg-emerald-400\"\n                                    : mine.complianceScore >= 80\n                                    ? \"bg-amber-400\"\n                                    : \"bg-red-400\"\n                                }`}\n                                style={{ width: `${mine.complianceScore}%` }}\n                              />\n                            </div>\n                          </div>\n                        </td>\n                        <td className=\"py-3\">\n                          <span\n                            className={`px-2 py-0.5 rounded text-[11px] font-bold ${\n                              mine.activeViolations === 0\n                                ? \"bg-emerald-950 text-emerald-300 border border-emerald-800\"\n                                : mine.activeViolations > 3\n                                ? \"bg-red-950 text-red-300 border border-red-800\"\n                                : \"bg-amber-950 text-amber-300 border border-amber-800\"\n                            }`}\n                          >\n                            {mine.activeViolations} Active\n                          </span>\n                        </td>\n                        <td className=\"py-3 text-right\">\n                          <button\n                            onClick={(e) => {\n                              e.stopPropagation();\n                              onSelectMine(mine.id);\n                              onNavigateTab(\"gis_map\");\n                            }}\n                            className=\"p-1 hover:bg-slate-700 rounded text-slate-400 hover:text-white\"\n                            title=\"Inspect in GIS View\"\n                          >\n                            <Eye className=\"w-4 h-4\" />\n                          </button>\n                        </td>\n                      </tr>\n                    );\n                  })}\n                </tbody>\n              </table>\n            </div>\n          </div>\n\n          <div className=\"mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400\">\n            <span>\n              Showing {allMines.length} key projects across Jharkhand, Chhattisgarh, MP & Odisha\n            </span>\n            <button\n              onClick={() => onNavigateTab(\"statutory_registers\")}\n              className=\"text-amber-400 hover:text-amber-300 font-medium\"\n            >\n              Open Form IV / IX Registers \342\206\222\n            </button>\n          </div>\n        </div>\n\n        {/* Right Col: Statutory Deadlines & Action Taken Reports (ATRs) */}\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg flex flex-col justify-between\">\n          <div>\n            <div className=\"flex items-center justify-between pb-3 border-b border-slate-800\">\n              <h3 className=\"text-base font-bold text-white flex items-center gap-2\">\n                <Clock className=\"w-4 h-4 text-amber-400\" />\n                <span>Statutory Expiry & ATR Timers</span>\n              </h3>\n              <span className=\"text-[10px] bg-red-500/20 text-red-400 border border-red-500/30 px-2 py-0.5 rounded font-bold uppercase\">\n                Legal Deadlines\n              </span>\n            </div>\n\n            <div className=\"mt-4 space-y-3\">\n              {/* Item 1 */}\n              <div className=\"p-3 bg-slate-950/70 border border-red-900/50 rounded-xl\">\n                <div className=\"flex items-start justify-between\">\n                  <span className=\"text-[11px] font-bold text-red-400 uppercase tracking-wider\">\n                    DGMS Sec 22(3) Ramp Notice\n                  </span>\n                  <span className=\"text-[10px] bg-red-950 text-red-300 border border-red-800 px-1.5 py-0.2 rounded font-mono font-bold\">\n                    14 Days Remaining\n                  </span>\n                </div>\n                <p className=\"text-xs font-semibold text-slate-200 mt-1\">\n                  Rajmahal OCP: Haul Road 1:16 Gradient Rectification ATR\n                </p>\n                <p className=\"text-[11px] text-slate-400 mt-0.5\">\n                  Assigned to: Er. Subroto Mukherjee \342\200\242 Requires Drone orthophoto survey submission.\n                </p>\n                <div className=\"mt-2.5 flex items-center justify-between text-xs pt-2 border-t border-slate-800/80\">\n                  <span className=\"text-slate-500\">Notice Ref: S-22(3)/418</span>\n                  <button\n                    onClick={() => onNavigateTab(\"workflow_audit\")}\n                    className=\"text-amber-400 hover:text-amber-300 font-semibold\"\n                  >\n                    Draft ATR \342\206\222\n                  </button>\n                </div>\n              </div>\n\n              {/* Item 2 */}\n              <div className=\"p-3 bg-slate-950/70 border border-amber-900/50 rounded-xl\">\n                <div className=\"flex items-start justify-between\">\n                  <span className=\"text-[11px] font-bold text-amber-400 uppercase tracking-wider\">\n                    MoEFCC EC Half-Yearly ATR\n                  </span>\n                  <span className=\"text-[10px] bg-amber-950 text-amber-300 border border-amber-800 px-1.5 py-0.2 rounded font-mono font-bold\">\n                    6 Days Remaining\n                  </span>\n                </div>\n                <p className=\"text-xs font-semibold text-slate-200 mt-1\">\n                  Gevra Mega OC: CAAQMS 6-month continuous data & green belt survival audit\n                </p>\n                <p className=\"text-[11px] text-slate-400 mt-0.5\">\n                  Assigned to: Nodal Environment Officer (SECL) \342\200\242 PARIVESH portal upload pending.\n                </p>\n                <div className=\"mt-2.5 flex items-center justify-between text-xs pt-2 border-t border-slate-800/80\">\n                  <span className=\"text-slate-500\">Condition: Specific IV</span>\n                  <button\n                    onClick={() => onNavigateTab(\"statutory_registers\")}\n                    className=\"text-amber-400 hover:text-amber-300 font-semibold\"\n                  >\n                    Review Report \342\206\222\n                  </button>\n                </div>\n              </div>\n\n              {/* Item 3 */}\n              <div className=\"p-3 bg-slate-950/70 border border-slate-800 rounded-xl\">\n                <div className=\"flex items-start justify-between\">\n                  <span className=\"text-[11px] font-bold text-slate-400 uppercase tracking-wider\">\n                    SPCB Consent to Operate (CTO)\n                  </span>\n                  <span className=\"text-[10px] bg-slate-800 text-slate-300 border border-slate-700 px-1.5 py-0.2 rounded font-mono font-bold\">\n                    28 Days\n                  </span>\n                </div>\n                <p className=\"text-xs font-semibold text-slate-200 mt-1\">\n                  Kusmunda OCP: Effluent treatment plant (ETP) heavy metal discharge test report\n                </p>\n                <div className=\"mt-2.5 flex items-center justify-between text-xs pt-2 border-t border-slate-800/80\">\n                  <span className=\"text-slate-500\">Water Act 1974</span>\n                  <span className=\"text-emerald-400 font-medium\">90% Prepared</span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"mt-4 pt-3 border-t border-slate-800 text-center\">\n            <button\n              onClick={() => onNavigateTab(\"workflow_audit\")}\n              className=\"w-full py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold rounded-xl border border-slate-700 transition-all\"\n            >\n              View Full Escalation Matrix & CAPA Logs\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Real-Time Live Violations & Corrective Action Feed */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-800\">\n          <div>\n            <h3 className=\"text-base font-bold text-white flex items-center gap-2\">\n              <AlertTriangle className=\"w-4 h-4 text-amber-400\" />\n              <span>Real-Time Statutory Violations, Hazards & Corrective Actions</span>\n            </h3>\n            <p className=\"text-xs text-slate-400\">\n              Digitally tracked from field inspections with geo-coordinates, regulatory citations, and assigned compliance officers.\n            </p>\n          </div>\n\n          {/* Filter Pills */}\n          <div className=\"flex items-center space-x-1 bg-slate-950 p-1 rounded-lg border border-slate-800 text-xs\">\n            <button\n              onClick={() => setFilterCategory(\"ALL\")}\n              className={`px-2.5 py-1 rounded-md font-medium transition-all ${\n                filterCategory === \"ALL\" ? \"bg-amber-500 text-slate-950 font-bold\" : \"text-slate-400 hover:text-white\"\n              }`}\n            >\n              All ({violations.length})\n            </button>\n            <button\n              onClick={() => setFilterCategory(\"Safety_DGMS\")}\n              className={`px-2.5 py-1 rounded-md font-medium transition-all ${\n                filterCategory === \"Safety_DGMS\"\n                  ? \"bg-amber-500 text-slate-950 font-bold\"\n                  : \"text-slate-400 hover:text-white\"\n              }`}\n            >\n              DGMS Safety\n            </button>\n            <button\n              onClick={() => setFilterCategory(\"Environment_MoEFCC\")}\n              className={`px-2.5 py-1 rounded-md font-medium transition-all ${\n                filterCategory === \"Environment_MoEFCC\"\n                  ? \"bg-amber-500 text-slate-950 font-bold\"\n                  : \"text-slate-400 hover:text-white\"\n              }`}\n            >\n              Environment / SPCB\n            </button>\n            <button\n              onClick={() => setFilterCategory(\"Labour_MinesAct\")}\n              className={`px-2.5 py-1 rounded-md font-medium transition-all ${\n                filterCategory === \"Labour_MinesAct\"\n                  ? \"bg-amber-500 text-slate-950 font-bold\"\n                  : \"text-slate-400 hover:text-white\"\n              }`}\n            >\n              Labour / PME\n            </button>\n          </div>\n        </div>\n\n        {/* Violations Cards */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mt-4\">\n          {filteredViolations.map((v) => (\n            <div\n              key={v.id}\n              className={`bg-slate-950/70 rounded-xl p-4 border transition-all hover:border-slate-600 flex flex-col justify-between ${\n                v.severity === \"Critical\"\n                  ? \"border-red-900/60 shadow-md shadow-red-950/20\"\n                  : v.severity === \"High\"\n                  ? \"border-amber-900/60\"\n                  : \"border-slate-800\"\n              }`}\n            >\n              <div>\n                <div className=\"flex items-center justify-between text-xs\">\n                  <span className=\"font-mono text-slate-400\">{v.id}</span>\n                  <span\n                    className={`px-2 py-0.5 rounded text-[10px] font-bold uppercase ${\n                      v.severity === \"Critical\"\n                        ? \"bg-red-500/20 text-red-400 border border-red-500/30\"\n                        : v.severity === \"High\"\n                        ? \"bg-amber-500/20 text-amber-400 border border-amber-500/30\"\n                        : \"bg-blue-500/20 text-blue-400 border border-blue-500/30\"\n                    }`}\n                  >\n                    {v.severity} Severity\n                  </span>\n                </div>\n\n                <h4 className=\"text-sm font-bold text-white mt-2\">\n                  {v.mineName} ({v.subsidiary})\n                </h4>\n                <div className=\"text-[11px] font-semibold text-amber-400 mt-0.5\">\n                  {v.clause}\n                </div>\n                <p className=\"text-xs text-slate-300 mt-2 line-clamp-3 leading-relaxed\">\n                  {v.description}\n                </p>\n\n                {v.actionTaken && (\n                  <div className=\"mt-3 p-2 bg-slate-900/90 rounded-lg border border-slate-800 text-[11px]\">\n                    <strong className=\"text-emerald-400 block\">Action Taken:</strong>\n                    <span className=\"text-slate-300\">{v.actionTaken}</span>\n                  </div>\n                )}\n              </div>\n\n              <div className=\"mt-4 pt-3 border-t border-slate-800/80 text-[11px] text-slate-400 flex items-center justify-between\">\n                <span>Deadline: <strong className=\"text-slate-200\">{v.statutoryDeadline}</strong></span>\n                <span\n                  className={`font-semibold ${\n                    v.status === \"Verified_Closed\"\n                      ? \"text-emerald-400\"\n                      : v.status === \"ATR_Submitted\"\n                      ? \"text-blue-400\"\n                      : \"text-red-400\"\n                  }`}\n                >\n                  {v.status.replace(\"_\", \" \")}\n                </span>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React, { useState } from \"react\";\nimport { MineSite, StatutoryViolation, UserRole } from \"../types\";\nimport {\n  ShieldCheck,\n  AlertTriangle,\n  Flame,\n  Activity,\n  Award,\n  TrendingUp,\n  Clock,\n  ArrowUpRight,\n  Sparkles,\n  Layers,\n  HardHat,\n  Eye,\n} from \"lucide-react\";\n\ninterface CommandHubProps {\n  currentRole: UserRole;\n  selectedMine: MineSite;\n  allMines: MineSite[];\n  violations: StatutoryViolation[];\n  onSelectMine: (mineId: string) => void;\n  onNavigateTab: (tab: string) => void;\n}\n\nexport const CommandHub: React.FC<CommandHubProps> = ({\n  currentRole,\n  selectedMine,\n  allMines,\n  violations,\n  onSelectMine,\n  onNavigateTab,\n}) => {\n  const [filterCategory, setFilterCategory] = useState<string>(\"ALL\");\n\n  // Calculate aggregates\n  const totalProduction = allMines.reduce((acc, m) => acc + m.currentProductionMT, 0);\n  const totalEcCap = allMines.reduce((acc, m) => acc + m.ecCapMTPA, 0);\n  const avgCompliance = Math.round(\n    allMines.reduce((acc, m) => acc + m.complianceScore, 0) / allMines.length\n  );\n  const openViolationsCount = violations.filter(\n    (v) => v.status === \"Open\" || v.status === \"Escalated_Level2\" || v.status === \"Escalated_Level3\"\n  ).length;\n  const criticalViolations = violations.filter((v) => v.severity === \"Critical\");\n\n  const filteredViolations =\n    filterCategory === \"ALL\"\n      ? violations\n      : violations.filter((v) => v.category === filterCategory);\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Editorial Lead Section Banner */}\n      <div className=\"bg-[#090909] border border-[#222] p-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 relative overflow-hidden\">\n        <div className=\"space-y-2 max-w-3xl\">\n          <div className=\"flex items-center space-x-3\">\n            <span className=\"text-[10px] uppercase font-bold tracking-[0.25em] text-[#FF4D00]\">\n              {currentRole === \"mine_official\" && \"Colliery Operational Authority\"}\n              {currentRole === \"corporate_hq\" && \"Corporate Governance Division\"}\n              {currentRole === \"regulatory_authority\" && \"DGMS Statutory Surveillance Desk\"}\n            </span>\n            <span className=\"w-1.5 h-1.5 bg-[#FF4D00] rounded-full animate-pulse\"></span>\n          </div>\n\n          <h2 className=\"font-serif italic text-2xl sm:text-3xl text-[#ECECEC] tracking-tight\">\n            {currentRole === \"mine_official\"\n              ? `${selectedMine.name} (${selectedMine.subsidiary}) \342\200\224 Statutory Safety & Production Health`\n              : \"Pan-India Coal Mining Governance & Statutory Compliance Index\"}\n          </h2>\n\n          <p className=\"text-xs text-[#888] font-sans leading-relaxed\">\n            Zero fatal incident mandate, 100% biometric Form-B digital registers, continuous CAAQMS environmental telemetry, and real-time EC extraction cap adherence.\n          </p>\n        </div>\n\n        <div className=\"flex flex-wrap items-center gap-3 shrink-0\">\n          <button\n            onClick={() => onNavigateTab(\"field_inspection\")}\n            className=\"px-4 py-2 bg-[#FF4D00] text-black font-bold text-xs uppercase tracking-wider hover:bg-[#ff6929] transition-all cursor-pointer flex items-center space-x-2\"\n          >\n            <HardHat className=\"w-3.5 h-3.5\" />\n            <span>Launch Geo-Inspection</span>\n          </button>\n          <button\n            onClick={() => onNavigateTab(\"ai_sentinel\")}\n            className=\"px-4 py-2 bg-[#111] border border-[#333] text-[#ECECEC] hover:bg-white hover:text-black font-medium text-xs uppercase tracking-wider transition-all cursor-pointer flex items-center space-x-2\"\n          >\n            <Sparkles className=\"w-3.5 h-3.5 text-[#FF4D00]\" />\n            <span>AI Risk Radar</span>\n          </button>\n        </div>\n      </div>\n\n      {/* 4 Core Editorial Metric Cards */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n        {/* Metric 1 */}\n        <div className=\"bg-[#090909] border border-[#222] border-l-2 border-l-emerald-500 p-5\">\n          <div className=\"flex justify-between items-start\">\n            <span className=\"text-[10px] font-bold text-[#888] uppercase tracking-[0.2em]\">\n              Statutory Compliance\n            </span>\n            <ShieldCheck className=\"w-4 h-4 text-emerald-400\" />\n          </div>\n          <div className=\"mt-3 flex items-baseline space-x-2\">\n            <span className=\"font-serif italic text-3xl text-[#ECECEC]\">\n              {currentRole === \"mine_official\" ? selectedMine.complianceScore : avgCompliance}%\n            </span>\n            <span className=\"text-[11px] font-mono text-emerald-400 flex items-center\">\n              <TrendingUp className=\"w-3 h-3 mr-0.5\" /> +2.8% MoM\n            </span>\n          </div>\n          <div className=\"mt-2 text-xs text-[#777] flex items-center justify-between\">\n            <span>Ministry Star Rating:</span>\n            <div className=\"flex items-center text-[#FF4D00]\">\n              {Array.from({ length: selectedMine.starRating }).map((_, i) => (\n                <Award key={i} className=\"w-3 h-3 fill-[#FF4D00]\" />\n              ))}\n              <span className=\"ml-1 text-[11px] font-mono font-bold text-[#ECECEC]\">\n                ({selectedMine.starRating}-Star)\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* Metric 2 */}\n        <div className=\"bg-[#090909] border border-[#222] border-l-2 border-l-red-500 p-5\">\n          <div className=\"flex justify-between items-start\">\n            <span className=\"text-[10px] font-bold text-[#888] uppercase tracking-[0.2em]\">\n              Statutory Notices\n            </span>\n            <AlertTriangle className=\"w-4 h-4 text-red-500\" />\n          </div>\n          <div className=\"mt-3 flex items-baseline space-x-2\">\n            <span className=\"font-serif italic text-3xl text-[#ECECEC]\">\n              {currentRole === \"mine_official\" ? selectedMine.activeViolations : openViolationsCount}\n            </span>\n            <span className=\"text-[11px] font-mono text-red-400\">\n              {criticalViolations.length} Critical\n            </span>\n          </div>\n          <div className=\"mt-2 text-xs text-[#777] flex items-center justify-between\">\n            <span>Action Taken Reports:</span>\n            <span className=\"text-[#FF4D00] font-mono font-semibold\">2 ATRs due &lt; 7d</span>\n          </div>\n        </div>\n\n        {/* Metric 3 */}\n        <div className=\"bg-[#090909] border border-[#222] border-l-2 border-l-[#FF4D00] p-5\">\n          <div className=\"flex justify-between items-start\">\n            <span className=\"text-[10px] font-bold text-[#888] uppercase tracking-[0.2em]\">\n              Production / EC Cap\n            </span>\n            <Activity className=\"w-4 h-4 text-[#FF4D00]\" />\n          </div>\n          <div className=\"mt-3 flex items-baseline space-x-2\">\n            <span className=\"font-serif italic text-3xl text-[#ECECEC]\">\n              {currentRole === \"mine_official\"\n                ? `${selectedMine.currentProductionMT} MT`\n                : `${totalProduction.toFixed(1)} MT`}\n            </span>\n            <span className=\"text-xs text-[#666] font-mono\">\n              / {currentRole === \"mine_official\" ? selectedMine.ecCapMTPA : totalEcCap} MTPA\n            </span>\n          </div>\n          <div className=\"mt-2 text-xs text-[#777] flex items-center justify-between\">\n            <span>Capacity Util:</span>\n            <span className=\"text-emerald-400 font-mono font-semibold\">\n              {Math.round(\n                ((currentRole === \"mine_official\" ? selectedMine.currentProductionMT : totalProduction) /\n                  (currentRole === \"mine_official\" ? selectedMine.ecCapMTPA : totalEcCap)) *\n                  100\n              )}\n              % (Compliant)\n            </span>\n          </div>\n        </div>\n\n        {/* Metric 4 */}\n        <div className=\"bg-[#090909] border border-[#222] border-l-2 border-l-blue-500 p-5\">\n          <div className=\"flex justify-between items-start\">\n            <span className=\"text-[10px] font-bold text-[#888] uppercase tracking-[0.2em]\">\n              Pit Sensors Telemetry\n            </span>\n            <Flame className=\"w-4 h-4 text-blue-400\" />\n          </div>\n          <div className=\"mt-3 grid grid-cols-2 gap-2 text-xs\">\n            <div className=\"bg-[#111] p-2 border border-[#222]\">\n              <span className=\"text-[9px] uppercase tracking-wider text-[#666] block\">Dust PM10</span>\n              <span className=\"font-mono font-bold text-[#ECECEC]\">\n                {selectedMine.telemetry.dustPm10} \302\265g/m\302\263\n              </span>\n            </div>\n            <div className=\"bg-[#111] p-2 border border-[#222]\">\n              <span className=\"text-[9px] uppercase tracking-wider text-[#666] block\">Slope Radar</span>\n              <span\n                className={`font-mono font-bold ${\n                  selectedMine.telemetry.slopeDisplacementMm > 10 ? \"text-red-400\" : \"text-emerald-400\"\n                }`}\n              >\n                {selectedMine.telemetry.slopeDisplacementMm} mm\n              </span>\n            </div>\n          </div>\n          <div className=\"mt-2 text-[10px] text-[#666] flex items-center justify-between font-mono\">\n            <span>pH: {selectedMine.telemetry.waterPh}</span>\n            <span>Noise: {selectedMine.telemetry.noiseDb} dB</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Grid: Benchmarking League Table + Statutory Deadlines */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Table View */}\n        <div className=\"lg:col-span-2 bg-[#090909] border border-[#222] p-6 flex flex-col justify-between\">\n          <div>\n            <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-[#222]\">\n              <div>\n                <h3 className=\"font-serif italic text-2xl text-[#ECECEC]\">\n                  Subsidiary & Colliery Benchmark Index\n                </h3>\n                <p className=\"text-xs text-[#888] mt-0.5\">\n                  Audit ranks based on DGMS notices, MoEFCC compliance filings, and Ministry 5-Star parameters.\n                </p>\n              </div>\n              <button\n                onClick={() => onNavigateTab(\"gis_map\")}\n                className=\"text-[10px] uppercase tracking-wider border border-[#333] px-3 py-1 text-[#888] hover:bg-white hover:text-black transition-all flex items-center space-x-1\"\n              >\n                <span>GIS Spatial View</span>\n                <ArrowUpRight className=\"w-3 h-3 ml-1\" />\n              </button>\n            </div>\n\n            <div className=\"overflow-x-auto mt-4\">\n              <table className=\"w-full text-left border-collapse\">\n                <thead>\n                  <tr className=\"border-b border-[#222] text-[10px] uppercase tracking-widest text-[#555]\">\n                    <th className=\"pb-3 font-bold\">Colliery</th>\n                    <th className=\"pb-3 font-bold\">Subsidiary</th>\n                    <th className=\"pb-3 font-bold\">Type</th>\n                    <th className=\"pb-3 font-bold\">Star Rating</th>\n                    <th className=\"pb-3 font-bold\">Compliance</th>\n                    <th className=\"pb-3 font-bold\">Notices</th>\n                    <th className=\"pb-3 font-bold text-right\">Inspect</th>\n                  </tr>\n                </thead>\n                <tbody className=\"text-xs divide-y divide-[#181818]\">\n                  {allMines.map((mine) => {\n                    const isSelected = mine.id === selectedMine.id;\n                    return (\n                      <tr\n                        key={mine.id}\n                        onClick={() => onSelectMine(mine.id)}\n                        className={`hover:bg-[#121212] cursor-pointer transition-colors ${\n                          isSelected ? \"bg-[#141414]\" : \"\"\n                        }`}\n                      >\n                        <td className=\"py-3 font-medium text-[#ECECEC] flex items-center space-x-2\">\n                          <span\n                            className={`w-1.5 h-1.5 rounded-full ${\n                              mine.status === \"Operational\"\n                                ? \"bg-emerald-500\"\n                                : mine.status === \"Restricted_Notice\"\n                                ? \"bg-red-500 animate-pulse\"\n                                : \"bg-[#FF4D00]\"\n                            }`}\n                          />\n                          <span className=\"truncate max-w-[160px]\">{mine.name}</span>\n                        </td>\n                        <td className=\"py-3 font-mono text-[11px] text-[#999]\">\n                          {mine.subsidiary}\n                        </td>\n                        <td className=\"py-3 text-[#777]\">{mine.type}</td>\n                        <td className=\"py-3 font-mono text-[#FF4D00]\">\n                          {mine.starRating}\342\230\205\n                        </td>\n                        <td className=\"py-3 font-mono font-bold text-[#ECECEC]\">\n                          {mine.complianceScore}%\n                        </td>\n                        <td className=\"py-3\">\n                          <span\n                            className={`px-2 py-0.5 text-[10px] font-mono uppercase font-bold border ${\n                              mine.activeViolations === 0\n                                ? \"bg-emerald-950/40 text-emerald-400 border-emerald-800/40\"\n                                : mine.activeViolations > 3\n                                ? \"bg-red-950/40 text-red-400 border-red-800/40\"\n                                : \"bg-orange-950/40 text-orange-400 border-orange-800/40\"\n                            }`}\n                          >\n                            {mine.activeViolations} Active\n                          </span>\n                        </td>\n                        <td className=\"py-3 text-right\">\n                          <button\n                            onClick={(e) => {\n                              e.stopPropagation();\n                              onSelectMine(mine.id);\n                              onNavigateTab(\"gis_map\");\n                            }}\n                            className=\"p-1 hover:text-[#FF4D00] text-[#666] transition-colors\"\n                          >\n                            <Eye className=\"w-3.5 h-3.5\" />\n                          </button>\n                        </td>\n                      </tr>\n                    );\n                  })}\n                </tbody>\n              </table>\n            </div>\n          </div>\n\n          <div className=\"mt-4 pt-3 border-t border-[#222] flex items-center justify-between text-xs text-[#666]\">\n            <span className=\"text-[11px]\">8 Subsidiaries Monitored</span>\n            <button\n              onClick={() => onNavigateTab(\"statutory_registers\")}\n              className=\"text-[#FF4D00] hover:underline font-mono text-[11px]\"\n            >\n              Open Form IV / IX Registers \342\206\222\n            </button>\n          </div>\n        </div>\n\n        {/* Right Side: Legal Timers */}\n        <div className=\"bg-[#090909] border border-[#222] p-6 flex flex-col justify-between\">\n          <div>\n            <div className=\"flex items-center justify-between pb-3 border-b border-[#222]\">\n              <h3 className=\"font-serif italic text-2xl text-[#ECECEC] flex items-center gap-2\">\n                <Clock className=\"w-4 h-4 text-[#FF4D00]\" />\n                <span>Statutory Expiries</span>\n              </h3>\n              <span className=\"text-[9px] uppercase tracking-widest text-red-500 font-bold border border-red-900/50 bg-red-950/30 px-2 py-0.5\">\n                Strict Timers\n              </span>\n            </div>\n\n            <div className=\"mt-4 space-y-4\">\n              <div className=\"p-4 bg-[#111] border-l-2 border-red-500\">\n                <div className=\"flex items-center justify-between text-[10px]\">\n                  <span className=\"text-red-500 uppercase font-bold tracking-widest\">DGMS Sec 22(3)</span>\n                  <span className=\"font-mono text-red-400\">14 Days Due</span>\n                </div>\n                <p className=\"text-sm font-medium text-[#ECECEC] mt-1\">\n                  Rajmahal OCP: Haul Road 1:16 Gradient Rectification ATR\n                </p>\n                <p className=\"text-xs text-[#777] mt-1 font-sans\">\n                  Assigned: Er. Subroto Mukherjee \342\200\242 Requires drone orthophoto survey submission.\n                </p>\n              </div>\n\n              <div className=\"p-4 bg-[#111] border-l-2 border-orange-500\">\n                <div className=\"flex items-center justify-between text-[10px]\">\n                  <span className=\"text-orange-500 uppercase font-bold tracking-widest\">MoEFCC EC Clearance</span>\n                  <span className=\"font-mono text-orange-400\">6 Days Due</span>\n                </div>\n                <p className=\"text-sm font-medium text-[#ECECEC] mt-1\">\n                  Gevra Mega OC: CAAQMS 6-Month Telemetry Audit\n                </p>\n                <p className=\"text-xs text-[#777] mt-1 font-sans\">\n                  Assigned: Nodal Environment Officer (SECL) \342\200\242 PARIVESH upload pending.\n                </p>\n              </div>\n\n              <div className=\"p-4 bg-[#111] border-l-2 border-blue-500\">\n                <div className=\"flex items-center justify-between text-[10px]\">\n                  <span className=\"text-blue-500 uppercase font-bold tracking-widest\">SPCB CTO Renewal</span>\n                  <span className=\"font-mono text-blue-400\">28 Days</span>\n                </div>\n                <p className=\"text-sm font-medium text-[#ECECEC] mt-1\">\n                  Kusmunda OCP: Effluent Discharge ETP Quality Test\n                </p>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"mt-4 pt-3 border-t border-[#222]\">\n            <button\n              onClick={() => onNavigateTab(\"workflow_audit\")}\n              className=\"w-full py-2 bg-[#111] hover:bg-white hover:text-black border border-[#333] text-[#ECECEC] text-[10px] uppercase tracking-widest font-semibold transition-all\"\n            >\n              View Escalation Matrix & CAPA Logs\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Real-Time Live Violations & Corrective Action Feed */}\n      <div className=\"bg-[#090909] border border-[#222] p-6\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-[#222]\">\n          <div>\n            <h3 className=\"font-serif italic text-2xl text-[#ECECEC]\">\n              Statutory Hazards & Corrective Actions Feed\n            </h3>\n            <p className=\"text-xs text-[#888] mt-0.5\">\n              Live geo-tagged observation entries under Coal Mines Regulations 2017 & Mines Act 1952.\n            </p>\n          </div>\n\n          {/* Filter Pills */}\n          <div className=\"flex items-center space-x-1 border border-[#222] p-0.5 bg-[#050505] text-xs\">\n            {[\"ALL\", \"Safety_DGMS\", \"Environment_MoEFCC\", \"Labour_MinesAct\"].map((cat) => (\n              <button\n                key={cat}\n                onClick={() => setFilterCategory(cat)}\n                className={`px-3 py-1 text-[10px] uppercase tracking-wider font-semibold transition-all ${\n                  filterCategory === cat\n                    ? \"bg-[#1A1A1A] border-b-2 border-[#FF4D00] text-white\"\n                    : \"text-[#777] hover:text-[#ECECEC]\"\n                }`}\n              >\n                {cat === \"ALL\" ? `All (${violations.length})` : cat.replace(\"_\", \" \")}\n              </button>\n            ))}\n          </div>\n        </div>\n\n        {/* Violations Cards */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mt-6\">\n          {filteredViolations.map((v) => (\n            <div\n              key={v.id}\n              className={`p-5 bg-[#0E0E0E] border border-[#222] flex flex-col justify-between ${\n                v.severity === \"Critical\"\n                  ? \"border-l-2 border-l-red-500\"\n                  : v.severity === \"High\"\n                  ? \"border-l-2 border-l-orange-500\"\n                  : \"border-l-2 border-l-blue-500\"\n              }`}\n            >\n              <div>\n                <div className=\"flex items-center justify-between text-xs\">\n                  <span className=\"font-mono text-[#888] text-[11px]\">{v.id}</span>\n                  <span\n                    className={`text-[9px] uppercase font-bold tracking-widest px-2 py-0.5 ${\n                      v.severity === \"Critical\"\n                        ? \"text-red-400 bg-red-950/40 border border-red-900/50\"\n                        : v.severity === \"High\"\n                        ? \"text-orange-400 bg-orange-950/40 border border-orange-900/50\"\n                        : \"text-blue-400 bg-blue-950/40 border border-blue-900/50\"\n                    }`}\n                  >\n                    {v.severity}\n                  </span>\n                </div>\n\n                <h4 className=\"text-sm font-semibold text-[#ECECEC] mt-2\">\n                  {v.mineName} ({v.subsidiary})\n                </h4>\n                <div className=\"text-xs font-mono text-[#FF4D00] mt-0.5\">\n                  {v.clause}\n                </div>\n                <p className=\"text-xs text-[#888] mt-2 leading-relaxed\">\n                  {v.description}\n                </p>\n\n                {v.actionTaken && (\n                  <div className=\"mt-3 p-3 bg-[#141414] border border-[#222] text-xs\">\n                    <span className=\"text-emerald-400 block font-semibold text-[11px] uppercase tracking-wider\">\n                      ATR Status:\n                    </span>\n                    <span className=\"text-[#AAA] font-sans text-xs\">{v.actionTaken}</span>\n                  </div>\n                )}\n              </div>\n\n              <div className=\"mt-4 pt-3 border-t border-[#1C1C1C] text-[11px] flex items-center justify-between text-[#666]\">\n                <span>Due: <strong className=\"text-[#ECECEC] font-mono\">{v.statutoryDeadline}</strong></span>\n                <span\n                  className={`font-semibold ${\n                    v.status === \"Verified_Closed\"\n                      ? \"text-emerald-400\"\n                      : v.status === \"ATR_Submitted\"\n                      ? \"text-blue-400\"\n                      : \"text-red-400\"\n                  }`}\n                >\n                  {v.status.replace(\"_\", \" \")}\n                </span>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};"
    }
    diff {
      end_line: 609
