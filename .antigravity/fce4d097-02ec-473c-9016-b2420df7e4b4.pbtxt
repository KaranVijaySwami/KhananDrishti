  file_change {
    absolute_path_uri: "file:///src/components/FieldInspection.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { MineSite, InspectionRecord } from \"../types\";\nimport {\n  HardHat,\n  MapPin,\n  Camera,\n  CheckCircle2,\n  AlertTriangle,\n  Upload,\n  Radio,\n  FileCheck,\n  Clock,\n  Wifi,\n  WifiOff,\n  Sparkles,\n  ShieldAlert,\n  Send,\n  RefreshCw,\n  Eye,\n  Crosshair,\n} from \"lucide-react\";\n\ninterface FieldInspectionProps {\n  selectedMine: MineSite;\n  isOnline: boolean;\n  offlineQueueCount: number;\n  onAddInspection: (record: InspectionRecord) => void;\n  inspections: InspectionRecord[];\n}\n\nexport const FieldInspection: React.FC<FieldInspectionProps> = ({\n  selectedMine,\n  isOnline,\n  offlineQueueCount,\n  onAddInspection,\n  inspections,\n}) => {\n  const [gpsLocked, setGpsLocked] = useState<boolean>(true);\n  const [currentCoords, setCurrentCoords] = useState({\n    lat: selectedMine.lat + (Math.random() * 0.004 - 0.002),\n    lng: selectedMine.lng + (Math.random() * 0.004 - 0.002),\n    accuracy: 1.6,\n    altitudeRL: 214.5,\n  });\n\n  const [inspectorName, setInspectorName] = useState<string>(\"Er. Rajesh Verma\");\n  const [designation, setDesignation] = useState<string>(\"Colliery Safety Officer (1st Class Mine Manager)\");\n  const [inspectionType, setInspectionType] = useState<InspectionRecord[\"inspectionType\"]>(\"DGMS_Statutory\");\n  const [benchOrLevel, setBenchOrLevel] = useState<string>(\"South-East Bench 12 (RL 210m)\");\n  const [seamName, setSeamName] = useState<string>(\"Seam IV/V Interburden\");\n  const [evidencePhoto, setEvidencePhoto] = useState<string | null>(\n    \"https://images.unsplash.com/photo-1578328819058-b69f3a3b0f6b?w=600&auto=format&fit=crop&q=60\"\n  );\n  const [isSubmitting, setIsSubmitting] = useState<boolean>(false);\n  const [submissionSuccess, setSubmissionSuccess] = useState<string | null>(null);\n\n  // Dynamic statutory checklist items\n  const [checklist, setChecklist] = useState<\n    {\n      checkPoint: string;\n      statutoryRef: string;\n      status: \"Pass\" | \"Fail\" | \"Observation\";\n      remarks: string;\n    }[]\n  >([\n    {\n      checkPoint: \"Haul Road Gradient maintains <= 1 in 16 ratio on active ramp\",\n      statutoryRef: \"CMR 2017 Reg 107(1)\",\n      status: \"Pass\",\n      remarks: \"Gradient verified via digital inclinometer at 1 in 16.2.\",\n    },\n    {\n      checkPoint: \"Safety Berm / Parapet wall height >= largest tyre diameter (3.5m)\",\n      statutoryRef: \"CMR 2017 Reg 107(3)\",\n      status: \"Pass\",\n      remarks: \"Continuous compacted rock berm of 3.8m measured along pit edge.\",\n    },\n    {\n      checkPoint: \"Highwall and OB dump slope stability radar monitoring active\",\n      statutoryRef: \"DGMS Tech Circular (Safety) 04/2020\",\n      status: \"Pass\",\n      remarks: \"Real-time radar ping active; displacement below 0.2mm/hr.\",\n    },\n    {\n      checkPoint: \"Auto Fire Detection & Suppression (AFDSS) in Heavy HEMM\",\n      statutoryRef: \"DGMS Standard for Heavy Earthmoving Machinery\",\n      status: \"Pass\",\n      remarks: \"Nitrogen pressure indicator in green band on Shovel #04.\",\n    },\n    {\n      checkPoint: \"Dust Suppression Mist Cannons & Mobile Sprinklers Operating\",\n      statutoryRef: \"MoEFCC EC Condition Specific-IV\",\n      status: \"Observation\",\n      remarks: \"Ramp 2 sprinkler truck scheduled next round in 20 minutes.\",\n    },\n    {\n      checkPoint: \"First Aid Station & Emergency Stretcher with Oxygen kit available\",\n      statutoryRef: \"Mines Rules 1955 Rule 44\",\n      status: \"Pass\",\n      remarks: \"Fully stocked at Bench 12 substation.\",\n    },\n  ]);\n\n  const handleStatusChange = (index: number, newStatus: \"Pass\" | \"Fail\" | \"Observation\") => {\n    setChecklist((prev) => {\n      const copy = [...prev];\n      copy[index].status = newStatus;\n      return copy;\n    });\n  };\n\n  const handleRemarkChange = (index: number, remarks: string) => {\n    setChecklist((prev) => {\n      const copy = [...prev];\n      copy[index].remarks = remarks;\n      return copy;\n    });\n  };\n\n  const handleRefreshGps = () => {\n    setCurrentCoords({\n      lat: selectedMine.lat + (Math.random() * 0.003 - 0.0015),\n      lng: selectedMine.lng + (Math.random() * 0.003 - 0.0015),\n      accuracy: +(1.2 + Math.random() * 0.8).toFixed(1),\n      altitudeRL: +(210 + Math.random() * 15).toFixed(1),\n    });\n    setGpsLocked(true);\n  };\n\n  const handleSubmitAudit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setIsSubmitting(true);\n\n    const passedCount = checklist.filter((c) => c.status === \"Pass\").length;\n    const failedCount = checklist.filter((c) => c.status === \"Fail\").length;\n\n    const newRecord: InspectionRecord = {\n      id: `INSP-2026-${Date.now().toString().slice(-4)}`,\n      mineId: selectedMine.id,\n      mineName: selectedMine.name,\n      inspectorName,\n      inspectorDesignation: designation,\n      inspectionType,\n      date: new Date().toISOString().split(\"T\")[0],\n      geoTag: {\n        lat: currentCoords.lat,\n        lng: currentCoords.lng,\n        accuracyM: currentCoords.accuracy,\n        benchOrLevel,\n        seam: seamName,\n      },\n      checklistSummary: {\n        totalItems: checklist.length,\n        passed: passedCount,\n        failed: failedCount,\n      },\n      items: checklist,\n      hazardsFound: checklist\n        .filter((c) => c.status === \"Fail\" || c.status === \"Observation\")\n        .map((c) => `${c.checkPoint}: ${c.remarks}`),\n      photoUrls: evidencePhoto ? [evidencePhoto] : [],\n      offlineCreated: !isOnline,\n      syncedAt: isOnline ? new Date().toISOString() : undefined,\n      digitalSignatureHash: `sha256-${Math.random().toString(36).substring(2, 15)}${Math.random().toString(36).substring(2, 15)}`,\n    };\n\n    setTimeout(() => {\n      onAddInspection(newRecord);\n      setIsSubmitting(false);\n      setSubmissionSuccess(\n        isOnline\n          ? `Audit Record ${newRecord.id} successfully synced to CIL National Portal & DGMS Cloud with SHA-256 Digital Signature!`\n          : `Audit Record ${newRecord.id} saved securely to Offline Storage Queue. It will auto-sync immediately upon network re-establishment.`\n      );\n    }, 600);\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Top Banner: Geo-Tag Status & Mobile Mode */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n        <div className=\"flex items-center space-x-3.5\">\n          <div className=\"p-3 bg-amber-500/10 border border-amber-500/30 rounded-xl text-amber-400\">\n            <HardHat className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"text-xs font-bold uppercase tracking-wider text-amber-400\">\n                Digital Field Inspection & Safety Audit System\n              </span>\n              <span\n                className={`px-2 py-0.5 rounded text-[10px] font-bold ${\n                  isOnline\n                    ? \"bg-emerald-500/20 text-emerald-300 border border-emerald-500/30\"\n                    : \"bg-red-500/20 text-red-300 border border-red-500/30 animate-pulse\"\n                }`}\n              >\n                {isOnline ? \"Cloud Sync Active\" : \"Offline Mode Active\"}\n              </span>\n            </div>\n            <h2 className=\"text-lg font-bold text-white mt-0.5\">\n              Geo-Tagged & Time-Stamped Statutory Inspection Form\n            </h2>\n            <p className=\"text-xs text-slate-400\">\n              Form IV / Form IX compliance under Coal Mines Regulations 2017 & Directorate General of Mines Safety (DGMS).\n            </p>\n          </div>\n        </div>\n\n        {/* Live GPS Lock Box */}\n        <div className=\"bg-slate-950 p-3 rounded-xl border border-slate-800 flex items-center space-x-3 text-xs\">\n          <div className=\"p-2 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20\">\n            <Crosshair className=\"w-4 h-4\" />\n          </div>\n          <div>\n            <div className=\"flex items-center space-x-1 text-slate-300 font-mono text-[11px]\">\n              <MapPin className=\"w-3 h-3 text-red-400\" />\n              <span>{currentCoords.lat.toFixed(5)}\302\260N, {currentCoords.lng.toFixed(5)}\302\260E</span>\n            </div>\n            <div className=\"text-[10px] text-slate-500 flex items-center space-x-2 mt-0.5\">\n              <span>RL: {currentCoords.altitudeRL}m</span>\n              <span>\342\200\242</span>\n              <span className=\"text-emerald-400\">Accuracy: \302\261{currentCoords.accuracy}m</span>\n            </div>\n          </div>\n          <button\n            type=\"button\"\n            onClick={handleRefreshGps}\n            className=\"p-1.5 hover:bg-slate-800 rounded-lg text-slate-400 hover:text-white\"\n            title=\"Recalibrate High-Precision GNSS GPS\"\n          >\n            <RefreshCw className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n      </div>\n\n      {submissionSuccess && (\n        <div className=\"p-4 bg-emerald-950/70 border border-emerald-600/40 rounded-xl text-emerald-200 text-xs flex items-center justify-between animate-in fade-in\">\n          <div className=\"flex items-center space-x-2\">\n            <CheckCircle2 className=\"w-5 h-5 text-emerald-400 shrink-0\" />\n            <span>{submissionSuccess}</span>\n          </div>\n          <button\n            onClick={() => setSubmissionSuccess(null)}\n            className=\"text-emerald-400 hover:text-white font-bold ml-4\"\n          >\n            \342\234\225\n          </button>\n        </div>\n      )}\n\n      {/* Main Form & Inspection Logs */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Form Col (2 Cols) */}\n        <form\n          onSubmit={handleSubmitAudit}\n          className=\"lg:col-span-2 bg-slate-900/90 border border-slate-800 rounded-2xl p-5 sm:p-6 shadow-xl space-y-5\"\n        >\n          {/* Metadata Section */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs\">\n            <div>\n              <label className=\"block text-slate-400 mb-1 font-semibold\">Inspector / Officer Name</label>\n              <input\n                type=\"text\"\n                value={inspectorName}\n                onChange={(e) => setInspectorName(e.target.value)}\n                required\n                className=\"w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-slate-100 focus:outline-none focus:border-amber-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-slate-400 mb-1 font-semibold\">Designation & FMC License</label>\n              <input\n                type=\"text\"\n                value={designation}\n                onChange={(e) => setDesignation(e.target.value)}\n                required\n                className=\"w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-slate-100 focus:outline-none focus:border-amber-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-slate-400 mb-1 font-semibold\">Inspection Category</label>\n              <select\n                value={inspectionType}\n                onChange={(e) => setInspectionType(e.target.value as any)}\n                className=\"w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-slate-100 focus:outline-none focus:border-amber-500\"\n              >\n                <option value=\"DGMS_Statutory\">DGMS Statutory Safety Audit</option>\n                <option value=\"Internal_Safety_Audit\">Internal Mine Safety Officer Round</option>\n                <option value=\"MoEFCC_Enviro\">MoEFCC Environmental & EC Audit</option>\n                <option value=\"HEMM_Fitness\">HEMM Heavy Machinery Physical Fitness</option>\n                <option value=\"Surprise_Check\">Colliery Overman Surprise Check</option>\n              </select>\n            </div>\n            <div>\n              <label className=\"block text-slate-400 mb-1 font-semibold\">Mining Bench / Working Seam</label>\n              <input\n                type=\"text\"\n                value={benchOrLevel}\n                onChange={(e) => setBenchOrLevel(e.target.value)}\n                required\n                className=\"w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-slate-100 focus:outline-none focus:border-amber-500\"\n              />\n            </div>\n          </div>\n\n          {/* Statutory Checklist Section */}\n          <div className=\"pt-3 border-t border-slate-800\">\n            <div className=\"flex items-center justify-between mb-3\">\n              <h3 className=\"text-sm font-bold text-white flex items-center gap-2\">\n                <FileCheck className=\"w-4 h-4 text-amber-400\" />\n                <span>Statutory Observation Checklist (Coal Mines Regulations 2017)</span>\n              </h3>\n              <span className=\"text-xs text-slate-400\">\n                {checklist.filter((c) => c.status === \"Pass\").length} / {checklist.length} Passed\n              </span>\n            </div>\n\n            <div className=\"space-y-3\">\n              {checklist.map((item, idx) => (\n                <div\n                  key={idx}\n                  className=\"bg-slate-950/70 border border-slate-800 rounded-xl p-3.5 space-y-2 text-xs\"\n                >\n                  <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n                    <div>\n                      <span className=\"font-semibold text-slate-200 block\">{item.checkPoint}</span>\n                      <span className=\"text-[10px] font-mono text-amber-400\">{item.statutoryRef}</span>\n                    </div>\n\n                    {/* Status Toggle Pills */}\n                    <div className=\"flex items-center space-x-1.5 shrink-0\">\n                      <button\n                        type=\"button\"\n                        onClick={() => handleStatusChange(idx, \"Pass\")}\n                        className={`px-2.5 py-1 rounded font-bold text-[11px] transition-all ${\n                          item.status === \"Pass\"\n                            ? \"bg-emerald-500 text-slate-950 shadow\"\n                            : \"bg-slate-900 text-slate-400 hover:text-white\"\n                        }`}\n                      >\n                        Pass\n                      </button>\n                      <button\n                        type=\"button\"\n                        onClick={() => handleStatusChange(idx, \"Observation\")}\n                        className={`px-2.5 py-1 rounded font-bold text-[11px] transition-all ${\n                          item.status === \"Observation\"\n                            ? \"bg-amber-500 text-slate-950 shadow\"\n                            : \"bg-slate-900 text-slate-400 hover:text-white\"\n                        }`}\n                      >\n                        Observation\n                      </button>\n                      <button\n                        type=\"button\"\n                        onClick={() => handleStatusChange(idx, \"Fail\")}\n                        className={`px-2.5 py-1 rounded font-bold text-[11px] transition-all ${\n                          item.status === \"Fail\"\n                            ? \"bg-red-500 text-white shadow\"\n                            : \"bg-slate-900 text-slate-400 hover:text-white\"\n                        }`}\n                      >\n                        Violation\n                      </button>\n                    </div>\n                  </div>\n\n                  <input\n                    type=\"text\"\n                    value={item.remarks}\n                    onChange={(e) => handleRemarkChange(idx, e.target.value)}\n                    placeholder=\"Enter observation findings or measurements...\"\n                    className=\"w-full bg-slate-900 border border-slate-800 rounded-lg px-2.5 py-1.5 text-slate-300 text-xs focus:outline-none focus:border-slate-600\"\n                  />\n                </div>\n              ))}\n            </div>\n          </div>\n\n          {/* Photo / Evidence Upload */}\n          <div className=\"pt-3 border-t border-slate-800\">\n            <label className=\"block text-xs font-semibold text-slate-300 mb-2\">\n              Geo-Tagged Field Photo Evidence & Visual Proof\n            </label>\n            <div className=\"flex flex-col sm:flex-row items-center gap-4\">\n              {evidencePhoto ? (\n                <div className=\"relative w-36 h-24 rounded-xl overflow-hidden border border-slate-700\">\n                  <img\n                    src={evidencePhoto}\n                    alt=\"Inspection Evidence\"\n                    className=\"w-full h-full object-cover\"\n                    referrerPolicy=\"no-referrer\"\n                  />\n                  <button\n                    type=\"button\"\n                    onClick={() => setEvidencePhoto(null)}\n                    className=\"absolute top-1 right-1 bg-red-600/80 text-white rounded-full p-1 text-[10px]\"\n                  >\n                    \342\234\225\n                  </button>\n                </div>\n              ) : (\n                <div className=\"w-36 h-24 rounded-xl border-2 border-dashed border-slate-700 flex flex-col items-center justify-center text-slate-500 text-xs text-center p-2\">\n                  <Camera className=\"w-6 h-6 mb-1 text-slate-600\" />\n                  <span>No Photo</span>\n                </div>\n              )}\n\n              <div className=\"space-y-1.5 flex-1 text-xs\">\n                <button\n                  type=\"button\"\n                  onClick={() =>\n                    setEvidencePhoto(\n                      \"https://images.unsplash.com/photo-1541888946425-d0fbb186156a?w=600&auto=format&fit=crop&q=60\"\n                    )\n                  }\n                  className=\"px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg border border-slate-700 font-medium flex items-center space-x-1.5\"\n                >\n                  <Camera className=\"w-3.5 h-3.5 text-amber-400\" />\n                  <span>Capture Field Camera Sample</span>\n                </button>\n                <p className=\"text-[11px] text-slate-500\">\n                  Photos are automatically embedded with EXIF GPS tags, bench RL level, and UTC timestamp.\n                </p>\n              </div>\n            </div>\n          </div>\n\n          {/* Submit Button */}\n          <div className=\"pt-4 border-t border-slate-800 flex items-center justify-between\">\n            <span className=\"text-xs text-slate-400 font-mono\">\n              Digital Signature: SHA-256 Enabled\n            </span>\n            <button\n              type=\"submit\"\n              disabled={isSubmitting}\n              className=\"flex items-center space-x-2 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-bold px-6 py-2.5 rounded-xl text-xs shadow-lg shadow-amber-500/20 transition-all cursor-pointer disabled:opacity-50\"\n            >\n              {isSubmitting ? (\n                <span>Generating Cryptographic Record...</span>\n              ) : (\n                <>\n                  <Send className=\"w-4 h-4\" />\n                  <span>\n                    {isOnline ? \"Submit Statutory Inspection Record\" : \"Save to Offline Queue\"}\n                  </span>\n                </>\n              )}\n            </button>\n          </div>\n        </form>\n\n        {/* Right Col: Recent Field Logs & Offline Queue Status */}\n        <div className=\"space-y-4\">\n          {/* Offline Queue Widget */}\n          <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-lg\">\n            <div className=\"flex items-center justify-between pb-3 border-b border-slate-800\">\n              <h3 className=\"text-xs font-bold uppercase tracking-wider text-slate-300 flex items-center gap-1.5\">\n                {isOnline ? (\n                  <Wifi className=\"w-3.5 h-3.5 text-emerald-400\" />\n                ) : (\n                  <WifiOff className=\"w-3.5 h-3.5 text-red-400\" />\n                )}\n                <span>Offline Sync Pipeline</span>\n              </h3>\n              <span className=\"text-[10px] font-mono text-slate-400\">\n                {offlineQueueCount} in Local Queue\n              </span>\n            </div>\n            <p className=\"text-xs text-slate-400 mt-2 leading-relaxed\">\n              When working deep in opencast pits or underground galleries where 4G/intranet is unavailable, inspection records and photos are cached locally in encrypted IndexedDB.\n            </p>\n          </div>\n\n          {/* Recent Synced Inspections List */}\n          <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-lg\">\n            <div className=\"flex items-center justify-between pb-3 border-b border-slate-800\">\n              <h3 className=\"text-xs font-bold uppercase tracking-wider text-slate-300\">\n                Recent Mine Safety Audits\n              </h3>\n              <span className=\"text-[10px] text-amber-400 font-bold\">{inspections.length} Logs</span>\n            </div>\n\n            <div className=\"mt-3 space-y-3\">\n              {inspections.map((insp) => (\n                <div key={insp.id} className=\"bg-slate-950 p-3 rounded-xl border border-slate-800 text-xs space-y-1\">\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"font-mono font-bold text-amber-400\">{insp.id}</span>\n                    <span className=\"text-[10px] text-slate-500\">{insp.date}</span>\n                  </div>\n                  <p className=\"text-slate-200 font-medium truncate\">{insp.inspectorName}</p>\n                  <p className=\"text-[11px] text-slate-400\">\n                    Location: {insp.geoTag.benchOrLevel}\n                  </p>\n                  <div className=\"flex items-center justify-between pt-1 text-[10px]\">\n                    <span className=\"text-emerald-400 font-semibold\">\n                      {insp.checklistSummary.passed} Passed / {insp.checklistSummary.failed} Failed\n                    </span>\n                    <span className=\"text-slate-500 font-mono\">\n                      {insp.digitalSignatureHash.slice(0, 10)}...\n                    </span>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
