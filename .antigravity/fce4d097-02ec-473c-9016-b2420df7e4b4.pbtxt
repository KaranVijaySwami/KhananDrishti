ring;\n  inspectorDesignation: string;\n  inspectionType: \"DGMS_Statutory\" | \"Internal_Safety_Audit\" | \"MoEFCC_Enviro\" | \"HEMM_Fitness\" | \"Surprise_Check\";\n  date: string;\n  geoTag: {\n    lat: number;\n    lng: number;\n    accuracyM: number;\n    benchOrLevel: string;\n    seam: string;\n  };\n  checklistSummary: {\n    totalItems: number;\n    passed: number;\n    failed: number;\n  };\n  items: {\n    checkPoint: string;\n    status: \"Pass\" | \"Fail\" | \"Observation\";\n    statutoryRef: string;\n    remarks: string;\n  }[];\n  hazardsFound: string[];\n  photoUrls: string[];\n  offlineCreated?: boolean;\n  syncedAt?: string;\n  digitalSignatureHash: string;\n}\n\nexport interface ContractorRecord {\n  id: string;\n  contractorName: string;\n  contractCode: string;\n  subsidiary: Subsidiary;\n  mineId: string;\n  totalWorkers: number;\n  formBCompliantPct: number;\n  pmeValidPct: number; // Periodic Medical Exam\n  vtcCertifiedPct: number; // Vocational Training Centre\n  safetyInductionScore: number;\n  activeMachineryCount: number;\n  safetyViolationsLast90Days: number;\n  status: \"Compliant\" | \"Warning_Notice\" | \"Suspended\";\n  supervisorName: string;\n  contactNumber: string;\n}\n\nexport interface StatutoryRegisterFormB {\n  workerId: string;\n  name: string;\n  category: \"HEMM_Operator\" | \"Driller\" | \"Blaster\" | \"Electrician\" | \"Mining_Sirdar\" | \"General_Labour\";\n  contractorId: string;\n  contractorName: string;\n  aadhaarMasked: string;\n  pmeDate: string;\n  pmeNextDue: string;\n  vtcCertificateNo: string;\n  attendancePct: number;\n  safetyInductionDate: string;\n  status: \"Active_Authorized\" | \"PME_Overdue_Blocked\" | \"Training_Lapse\";\n}\n\nexport interface AuditLogEntry {\n  id: string;\n  timestamp: string;\n  actor: string;\n  role: string;\n  action: string;\n  targetRef: string;\n  tamperProofHash: string;\n  previousHash: string;\n  verified: boolean;\n}\n\nexport interface OcrExtractionResult {\n  issuingAuthority: string;\n  referenceNumber: string;\n  subject: string;\n  issueDate: string;\n  statutoryDeadline: string;\n  riskRating: string;\n  covenants: {\n    clause: string;\n    requirement: string;\n    status: string;\n  }[];\n  actionItems: {\n    task: string;\n    assignedTo: string;\n    targetDate: string;\n    priority: SeverityLevel;\n  }[];\n}\n"
