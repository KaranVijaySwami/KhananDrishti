  file_change {
    absolute_path_uri: "file:///src/components/Header.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React from \"react\";\nimport { UserRole, Subsidiary, MineSite } from \"../types\";\nimport {\n  ShieldAlert,\n  Building2,\n  Scale,\n  HardHat,\n  Radio,\n  Wifi,\n  WifiOff,\n  AlertTriangle,\n  Flame,\n  CheckCircle2,\n  ChevronDown,\n  Layers,\n  MapPin,\n  FileText,\n  Bot,\n  Users,\n  GitCommit,\n  Server,\n  Zap,\n} from \"lucide-react\";\n\ninterface HeaderProps {\n  currentRole: UserRole;\n  setRole: (role: UserRole) => void;\n  selectedSubsidiary: Subsidiary | \"ALL\";\n  setSubsidiary: (sub: Subsidiary | \"ALL\") => void;\n  selectedMine: MineSite;\n  setSelectedMineId: (id: string) => void;\n  allMines: MineSite[];\n  activeTab: string;\n  setActiveTab: (tab: string) => void;\n  isOnline: boolean;\n  setIsOnline: (online: boolean) => void;\n  offlineQueueCount: number;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  currentRole,\n  setRole,\n  selectedSubsidiary,\n  setSubsidiary,\n  selectedMine,\n  setSelectedMineId,\n  allMines,\n  activeTab,\n  setActiveTab,\n  isOnline,\n  setIsOnline,\n  offlineQueueCount,\n}) => {\n  const filteredMines =\n    selectedSubsidiary === \"ALL\"\n      ? allMines\n      : allMines.filter((m) => m.subsidiary === selectedSubsidiary);\n\n  return (\n    <header className=\"sticky top-0 z-50 bg-slate-900/95 backdrop-blur-md border-b border-slate-800 shadow-2xl\">\n      {/* Top Statutory Ticker */}\n      <div className=\"bg-gradient-to-r from-amber-950/80 via-slate-900 to-amber-950/80 border-b border-amber-900/40 px-4 py-1.5 text-xs text-slate-300 flex items-center justify-between\">\n        <div className=\"flex items-center space-x-3 overflow-hidden\">\n          <span className=\"flex items-center space-x-1 font-semibold text-amber-400 shrink-0 uppercase tracking-wider text-[11px] bg-amber-950/90 px-2 py-0.5 rounded border border-amber-800/50\">\n            <Radio className=\"w-3 h-3 animate-pulse text-red-400\" />\n            <span>National Mining Sentinel</span>\n          </span>\n          <p className=\"truncate text-slate-300 text-[11px]\">\n            <strong className=\"text-amber-200\">Alert Ref [DGMS/2026/S-22(3)]:</strong> Rajmahal OCP East Flank haul gradient rectified to 1:16 \342\200\242 Monsoonal slope stability radar online in Gevra & Kusmunda \342\200\242 CIL Multi-Mine Star Rating 2025-26 cycle audit live.\n          </p>\n        </div>\n\n        <div className=\"flex items-center space-x-4 shrink-0 text-[11px]\">\n          {/* Offline/Online toggle switch */}\n          <button\n            onClick={() => setIsOnline(!isOnline)}\n            className={`flex items-center space-x-1.5 px-2.5 py-0.5 rounded-full border transition-all ${\n              isOnline\n                ? \"bg-emerald-950/60 border-emerald-600/40 text-emerald-300 hover:bg-emerald-900/40\"\n                : \"bg-red-950/80 border-red-500 text-red-300 animate-pulse\"\n            }`}\n            title=\"Toggle Network Simulation (Tests Field App Offline Sync)\"\n          >\n            {isOnline ? (\n              <>\n                <Wifi className=\"w-3 h-3 text-emerald-400\" />\n                <span>Online (CIL Intranet Cloud)</span>\n              </>\n            ) : (\n              <>\n                <WifiOff className=\"w-3 h-3 text-red-400\" />\n                <span>Offline ({offlineQueueCount} queued)</span>\n              </>\n            )}\n          </button>\n\n          <span className=\"hidden md:inline text-slate-400 font-mono\">\n            IST {new Date().toLocaleTimeString(\"en-IN\", { hour: \"2-digit\", minute: \"2-digit\" })}\n          </span>\n        </div>\n      </div>\n\n      {/* Main Bar */}\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 py-3\">\n        <div className=\"flex flex-col lg:flex-row lg:items-center justify-between gap-3\">\n          {/* Brand Logo & Name */}\n          <div className=\"flex items-center space-x-3\">\n            <div className=\"relative flex items-center justify-center w-11 h-11 rounded-xl bg-gradient-to-br from-amber-500 via-orange-600 to-amber-700 text-slate-950 shadow-lg shadow-amber-600/20 border border-amber-400/40\">\n              <Layers className=\"w-6 h-6 text-slate-950 stroke-[2.5]\" />\n              <span className=\"absolute -bottom-1 -right-1 w-4 h-4 bg-emerald-500 rounded-full border-2 border-slate-900 flex items-center justify-center\">\n                <CheckCircle2 className=\"w-2.5 h-2.5 text-slate-950\" />\n              </span>\n            </div>\n            <div>\n              <div className=\"flex items-center space-x-2\">\n                <h1 className=\"text-xl font-black tracking-tight text-white flex items-center gap-1.5\">\n                  <span>Khanan</span>\n                  <span className=\"bg-gradient-to-r from-amber-400 to-orange-400 bg-clip-text text-transparent\">\n                    Drishti\n                  </span>\n                </h1>\n                <span className=\"text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 bg-amber-500/10 text-amber-400 border border-amber-500/30 rounded-full\">\n                  CoalGov AI v2.4\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-400\">\n                Integrated Smart Governance, Statutory Compliance & Field Inspection Ecosystem \342\200\242 Ministry of Coal / CIL / DGMS\n              </p>\n            </div>\n          </div>\n\n          {/* Subsidiary Filter, Mine Selection & Role Selection */}\n          <div className=\"flex flex-wrap items-center gap-2.5\">\n            {/* Subsidiary Selector */}\n            <div className=\"flex items-center space-x-1.5 bg-slate-800/80 border border-slate-700 px-2.5 py-1.5 rounded-lg text-xs\">\n              <Building2 className=\"w-3.5 h-3.5 text-amber-400 shrink-0\" />\n              <span className=\"text-slate-400 text-[11px]\">Subsidiary:</span>\n              <select\n                value={selectedSubsidiary}\n                onChange={(e) => {\n                  const val = e.target.value as Subsidiary | \"ALL\";\n                  setSubsidiary(val);\n                  const firstMine =\n                    val === \"ALL\"\n                      ? allMines[0]\n                      : allMines.find((m) => m.subsidiary === val) || allMines[0];\n                  setSelectedMineId(firstMine.id);\n                }}\n                className=\"bg-transparent text-slate-100 font-semibold focus:outline-none cursor-pointer text-xs\"\n              >\n                <option value=\"ALL\" className=\"bg-slate-800 text-white\">All Subsidiaries (CIL Pan-India)</option>\n                <option value=\"SECL\" className=\"bg-slate-800 text-white\">SECL (South Eastern Coalfields)</option>\n                <option value=\"ECL\" className=\"bg-slate-800 text-white\">ECL (Eastern Coalfields)</option>\n                <option value=\"BCCL\" className=\"bg-slate-800 text-white\">BCCL (Bharat Coking Coal)</option>\n                <option value=\"CCL\" className=\"bg-slate-800 text-white\">CCL (Central Coalfields)</option>\n                <option value=\"NCL\" className=\"bg-slate-800 text-white\">NCL (Northern Coalfields)</option>\n                <option value=\"MCL\" className=\"bg-slate-800 text-white\">MCL (Mahanadi Coalfields)</option>\n                <option value=\"WCL\" className=\"bg-slate-800 text-white\">WCL (Western Coalfields)</option>\n              </select>\n            </div>\n\n            {/* Mine Project Selector */}\n            <div className=\"flex items-center space-x-1.5 bg-slate-800/80 border border-slate-700 px-2.5 py-1.5 rounded-lg text-xs\">\n              <MapPin className=\"w-3.5 h-3.5 text-orange-400 shrink-0\" />\n              <span className=\"text-slate-400 text-[11px]\">Colliery:</span>\n              <select\n                value={selectedMine.id}\n                onChange={(e) => setSelectedMineId(e.target.value)}\n                className=\"bg-transparent text-amber-300 font-semibold focus:outline-none cursor-pointer text-xs max-w-[160px] truncate\"\n              >\n                {filteredMines.map((mine) => (\n                  <option key={mine.id} value={mine.id} className=\"bg-slate-800 text-white\">\n                    {mine.name} ({mine.subsidiary})\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            {/* Multi-Tier Role Switcher */}\n            <div className=\"flex items-center bg-slate-950 p-1 rounded-lg border border-slate-800 text-xs\">\n              <button\n                onClick={() => setRole(\"mine_official\")}\n                className={`flex items-center space-x-1.5 px-3 py-1 rounded-md font-medium transition-all ${\n                  currentRole === \"mine_official\"\n                    ? \"bg-amber-500 text-slate-950 font-bold shadow\"\n                    : \"text-slate-400 hover:text-white\"\n                }`}\n                title=\"Colliery Manager / Safety Officer / Overman View\"\n              >\n                <HardHat className=\"w-3.5 h-3.5\" />\n                <span className=\"hidden sm:inline\">Mine Official</span>\n              </button>\n\n              <button\n                onClick={() => setRole(\"corporate_hq\")}\n                className={`flex items-center space-x-1.5 px-3 py-1 rounded-md font-medium transition-all ${\n                  currentRole === \"corporate_hq\"\n                    ? \"bg-amber-500 text-slate-950 font-bold shadow\"\n                    : \"text-slate-400 hover:text-white\"\n                }`}\n                title=\"CIL / Subsidiary Corporate Director View\"\n              >\n                <Building2 className=\"w-3.5 h-3.5\" />\n                <span className=\"hidden sm:inline\">Corporate HQ</span>\n              </button>\n\n              <button\n                onClick={() => setRole(\"regulatory_authority\")}\n                className={`flex items-center space-x-1.5 px-3 py-1 rounded-md font-medium transition-all ${\n                  currentRole === \"regulatory_authority\"\n                    ? \"bg-red-500 text-white font-bold shadow\"\n                    : \"text-slate-400 hover:text-white\"\n                }`}\n                title=\"DGMS / MoEFCC / SPCB Statutory Regulator View\"\n              >\n                <Scale className=\"w-3.5 h-3.5\" />\n                <span className=\"hidden sm:inline\">Regulator (DGMS)</span>\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* Horizontal Navigation Tabs */}\n        <nav className=\"flex items-center space-x-1 mt-3.5 overflow-x-auto pb-1 text-xs scrollbar-none\">\n          {[\n            { id: \"command_hub\", label: \"Command Hub\", icon: Layers },\n            { id: \"gis_map\", label: \"GIS Spatial Map\", icon: MapPin },\n            { id: \"field_inspection\", label: \"Field Inspection App\", icon: HardHat, badge: offlineQueueCount > 0 ? `${offlineQueueCount}` : undefined },\n            { id: \"statutory_registers\", label: \"Statutory Registers\", icon: FileText },\n            { id: \"ai_sentinel\", label: \"AI Sentinel & OCR\", icon: Bot, isNew: true },\n            { id: \"contractor_labour\", label: \"Contractor & Form B\", icon: Users },\n            { id: \"workflow_audit\", label: \"CAPA & Audit Trail\", icon: GitCommit },\n            { id: \"backend_guide\", label: \"Backend Integration\", icon: Server },\n          ].map((tab) => {\n            const Icon = tab.icon;\n            const isActive = activeTab === tab.id;\n            return (\n              <button\n                key={tab.id}\n                onClick={() => setActiveTab(tab.id)}\n                className={`flex items-center space-x-2 px-3.5 py-2 rounded-lg font-medium whitespace-nowrap transition-all ${\n                  isActive\n                    ? \"bg-amber-500/15 text-amber-300 border border-amber-500/40 shadow-sm shadow-amber-500/10\"\n                    : \"text-slate-400 hover:text-slate-200 hover:bg-slate-800/60 border border-transparent\"\n                }`}\n              >\n                <Icon className={`w-4 h-4 ${isActive ? \"text-amber-400\" : \"text-slate-500\"}`} />\n                <span>{tab.label}</span>\n                {tab.isNew && (\n                  <span className=\"bg-gradient-to-r from-amber-500 to-orange-500 text-[10px] text-slate-950 font-bold px-1.5 py-0.2 rounded-full uppercase\">\n                    AI\n                  </span>\n                )}\n                {tab.badge && (\n                  <span className=\"bg-red-500 text-[10px] text-white font-bold px-1.5 py-0.2 rounded-full\">\n                    {tab.badge}\n                  </span>\n                )}\n              </button>\n            );\n          })}\n        </nav>\n      </div>\n    </header>\n  );\n};"
      replacement_content: "import React from \"react\";\nimport { UserRole, Subsidiary, MineSite } from \"../types\";\nimport {\n  Building2,\n  Scale,\n  HardHat,\n  Radio,\n  Wifi,\n  WifiOff,\n  MapPin,\n  FileText,\n  Bot,\n  Users,\n  GitCommit,\n  Server,\n  Layers,\n} from \"lucide-react\";\n\ninterface HeaderProps {\n  currentRole: UserRole;\n  setRole: (role: UserRole) => void;\n  selectedSubsidiary: Subsidiary | \"ALL\";\n  setSubsidiary: (sub: Subsidiary | \"ALL\") => void;\n  selectedMine: MineSite;\n  setSelectedMineId: (id: string) => void;\n  allMines: MineSite[];\n  activeTab: string;\n  setActiveTab: (tab: string) => void;\n  isOnline: boolean;\n  setIsOnline: (online: boolean) => void;\n  offlineQueueCount: number;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  currentRole,\n  setRole,\n  selectedSubsidiary,\n  setSubsidiary,\n  selectedMine,\n  setSelectedMineId,\n  allMines,\n  activeTab,\n  setActiveTab,\n  isOnline,\n  setIsOnline,\n  offlineQueueCount,\n}) => {\n  const filteredMines =\n    selectedSubsidiary === \"ALL\"\n      ? allMines\n      : allMines.filter((m) => m.subsidiary === selectedSubsidiary);\n\n  return (\n    <header className=\"sticky top-0 z-50 bg-[#080808] border-b border-[#222]\">\n      {/* Top Editorial Ticker Bar */}\n      <div className=\"bg-[#050505] border-b border-[#222] px-4 sm:px-8 py-2 text-xs flex flex-wrap items-center justify-between gap-2\">\n        <div className=\"flex items-center space-x-3 overflow-hidden\">\n          <span className=\"flex items-center space-x-1.5 font-bold text-[#FF4D00] shrink-0 uppercase tracking-[0.2em] text-[10px]\">\n            <span className=\"w-1.5 h-1.5 rounded-full bg-[#FF4D00] animate-pulse\"></span>\n            <span>Statutory Bulletin</span>\n          </span>\n          <span className=\"text-[#333] hidden sm:inline\">|</span>\n          <p className=\"truncate text-[#888] text-[11px] font-sans\">\n            <span className=\"text-[#ECECEC] font-mono font-medium\">[DGMS/2026/S-22(3)]:</span> Rajmahal OCP East Flank haul gradient rectified to 1:16 \342\200\242 Slope stability radar online in Gevra & Kusmunda \342\200\242 CIL Multi-Mine Star Rating 2025-26 active.\n          </p>\n        </div>\n\n        <div className=\"flex items-center space-x-4 shrink-0 text-[10px]\">\n          {/* Network Simulator Status */}\n          <button\n            onClick={() => setIsOnline(!isOnline)}\n            className={`flex items-center space-x-1.5 px-2.5 py-1 border text-[10px] uppercase tracking-wider transition-colors cursor-pointer ${\n              isOnline\n                ? \"bg-[#111] border-[#333] text-emerald-400 hover:border-emerald-500/50\"\n                : \"bg-red-950/50 border-red-500/80 text-red-400 animate-pulse\"\n            }`}\n            title=\"Toggle Network Simulation (Tests Field App Offline Sync)\"\n          >\n            {isOnline ? (\n              <>\n                <Wifi className=\"w-3 h-3 text-emerald-400\" />\n                <span>Sync: Active</span>\n              </>\n            ) : (\n              <>\n                <WifiOff className=\"w-3 h-3 text-red-400\" />\n                <span>Offline ({offlineQueueCount} queued)</span>\n              </>\n            )}\n          </button>\n\n          <span className=\"text-[#666] font-mono uppercase tracking-widest hidden md:inline\">\n            IST {new Date().toLocaleTimeString(\"en-IN\", { hour: \"2-digit\", minute: \"2-digit\" })}\n          </span>\n        </div>\n      </div>\n\n      {/* Main Header Bar */}\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-8 py-3.5\">\n        <div className=\"flex flex-col lg:flex-row lg:items-center justify-between gap-4\">\n          {/* Masthead Branding */}\n          <div className=\"flex items-center space-x-4\">\n            <div className=\"w-10 h-10 bg-[#111] border border-[#333] flex items-center justify-center shrink-0\">\n              <span className=\"font-serif italic font-bold text-[#FF4D00] text-xl\">\340\244\226</span>\n            </div>\n            <div>\n              <div className=\"flex items-center space-x-2\">\n                <span className=\"text-[10px] tracking-[0.25em] font-bold text-[#777] uppercase\">\n                  Coal India Ltd. \342\200\242 Ministry of Coal\n                </span>\n                <span className=\"px-1.5 py-0.2 text-[9px] uppercase tracking-widest border border-[#333] bg-[#111] text-[#999]\">\n                  v2.4\n                </span>\n              </div>\n              <h1 className=\"text-xl sm:text-2xl font-serif italic text-[#ECECEC] tracking-tight flex items-baseline gap-2\">\n                <span>\340\244\226\340\244\276\340\244\250\340\244\250\340\244\246\340\245\203\340\244\267\340\245\215\340\244\237\340\244\277</span>\n                <span className=\"font-sans text-xs not-italic text-[#888] font-normal tracking-widest uppercase\">\n                  (KhananDrishti \342\200\242 MineSmart)\n                </span>\n              </h1>\n            </div>\n          </div>\n\n          {/* Controls: Subsidiary, Colliery & Role Switcher */}\n          <div className=\"flex flex-wrap items-center gap-2 sm:gap-3\">\n            {/* Subsidiary Filter */}\n            <div className=\"flex items-center space-x-2 bg-[#111] border border-[#262626] px-3 py-1.5 text-xs\">\n              <span className=\"text-[10px] text-[#666] uppercase tracking-wider font-bold\">Subsidiary:</span>\n              <select\n                value={selectedSubsidiary}\n                onChange={(e) => {\n                  const val = e.target.value as Subsidiary | \"ALL\";\n                  setSubsidiary(val);\n                  const firstMine =\n                    val === \"ALL\"\n                      ? allMines[0]\n                      : allMines.find((m) => m.subsidiary === val) || allMines[0];\n                  setSelectedMineId(firstMine.id);\n                }}\n                className=\"bg-transparent text-[#ECECEC] font-medium focus:outline-none cursor-pointer text-xs\"\n              >\n                <option value=\"ALL\" className=\"bg-[#111] text-[#ECECEC]\">All (CIL Pan-India)</option>\n                <option value=\"SECL\" className=\"bg-[#111] text-[#ECECEC]\">SECL (South Eastern)</option>\n                <option value=\"ECL\" className=\"bg-[#111] text-[#ECECEC]\">ECL (Eastern Coalfields)</option>\n                <option value=\"BCCL\" className=\"bg-[#111] text-[#ECECEC]\">BCCL (Bharat Coking)</option>\n                <option value=\"CCL\" className=\"bg-[#111] text-[#ECECEC]\">CCL (Central Coalfields)</option>\n                <option value=\"NCL\" className=\"bg-[#111] text-[#ECECEC]\">NCL (Northern Coalfields)</option>\n                <option value=\"MCL\" className=\"bg-[#111] text-[#ECECEC]\">MCL (Mahanadi Coalfields)</option>\n                <option value=\"WCL\" className=\"bg-[#111] text-[#ECECEC]\">WCL (Western Coalfields)</option>\n              </select>\n            </div>\n\n            {/* Mine Project Selector */}\n            <div className=\"flex items-center space-x-2 bg-[#111] border border-[#262626] px-3 py-1.5 text-xs\">\n              <span className=\"text-[10px] text-[#666] uppercase tracking-wider font-bold\">Colliery:</span>\n              <select\n                value={selectedMine.id}\n                onChange={(e) => setSelectedMineId(e.target.value)}\n                className=\"bg-transparent text-[#FF4D00] font-medium focus:outline-none cursor-pointer text-xs max-w-[150px] truncate\"\n              >\n                {filteredMines.map((mine) => (\n                  <option key={mine.id} value={mine.id} className=\"bg-[#111] text-[#ECECEC]\">\n                    {mine.name} ({mine.subsidiary})\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            {/* Multi-Tier Role Switcher */}\n            <div className=\"flex items-center bg-[#050505] border border-[#262626] p-0.5 text-xs\">\n              <button\n                onClick={() => setRole(\"mine_official\")}\n                className={`px-3 py-1 text-[11px] uppercase tracking-wider transition-all ${\n                  currentRole === \"mine_official\"\n                    ? \"bg-[#1A1A1A] border-b-2 border-[#FF4D00] text-white font-bold\"\n                    : \"text-[#777] hover:text-[#ECECEC]\"\n                }`}\n                title=\"Colliery Manager / Safety Officer / Overman View\"\n              >\n                Mine Official\n              </button>\n\n              <button\n                onClick={() => setRole(\"corporate_hq\")}\n                className={`px-3 py-1 text-[11px] uppercase tracking-wider transition-all ${\n                  currentRole === \"corporate_hq\"\n                    ? \"bg-[#1A1A1A] border-b-2 border-[#FF4D00] text-white font-bold\"\n                    : \"text-[#777] hover:text-[#ECECEC]\"\n                }`}\n                title=\"CIL / Subsidiary Corporate Director View\"\n              >\n                Corporate HQ\n              </button>\n\n              <button\n                onClick={() => setRole(\"regulatory_authority\")}\n                className={`px-3 py-1 text-[11px] uppercase tracking-wider transition-all ${\n                  currentRole === \"regulatory_authority\"\n                    ? \"bg-[#1A1A1A] border-b-2 border-red-500 text-white font-bold\"\n                    : \"text-[#777] hover:text-[#ECECEC]\"\n                }`}\n                title=\"DGMS / MoEFCC / SPCB Statutory Regulator View\"\n              >\n                DGMS Regulator\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* Editorial Navigation Tabs */}\n        <nav className=\"flex items-center space-x-1 mt-3 overflow-x-auto pb-1 text-xs border-t border-[#1C1C1C] pt-2.5\">\n          {[\n            { id: \"command_hub\", label: \"Central Command\", icon: Layers },\n            { id: \"gis_map\", label: \"GIS Spatial Map\", icon: MapPin },\n            { id: \"field_inspection\", label: \"Field Inspection\", icon: HardHat, badge: offlineQueueCount > 0 ? `${offlineQueueCount}` : undefined },\n            { id: \"statutory_registers\", label: \"Statutory Registers\", icon: FileText },\n            { id: \"ai_sentinel\", label: \"AI Sentinel & OCR\", icon: Bot, isNew: true },\n            { id: \"contractor_labour\", label: \"Contractor & Form-B\", icon: Users },\n            { id: \"workflow_audit\", label: \"CAPA & Audit Trail\", icon: GitCommit },\n            { id: \"backend_guide\", label: \"System Architecture\", icon: Server },\n          ].map((tab) => {\n            const Icon = tab.icon;\n            const isActive = activeTab === tab.id;\n            return (\n              <button\n                key={tab.id}\n                onClick={() => setActiveTab(tab.id)}\n                className={`flex items-center space-x-2 px-3.5 py-1.5 text-xs transition-all whitespace-nowrap cursor-pointer ${\n                  isActive\n                    ? \"bg-[#111] border-b-2 border-[#FF4D00] text-[#ECECEC] font-medium\"\n                    : \"text-[#777] hover:text-[#ECECEC] hover:bg-[#111]/50 border-b-2 border-transparent\"\n                }`}\n              >\n                <Icon className={`w-3.5 h-3.5 ${isActive ? \"text-[#FF4D00]\" : \"text-[#666]\"}`} />\n                <span>{tab.label}</span>\n                {tab.isNew && (\n                  <span className=\"px-1.5 py-0.2 bg-[#FF4D00]/20 text-[#FF4D00] text-[9px] uppercase tracking-wider font-bold\">\n                    AI\n                  </span>\n                )}\n                {tab.badge && (\n                  <span className=\"px-1.5 py-0.2 bg-red-950 text-red-400 border border-red-800 text-[9px] font-mono font-bold\">\n                    {tab.badge}\n                  </span>\n                )}\n              </button>\n            );\n          })}\n        </nav>\n      </div>\n    </header>\n  );\n};\n"
    }
