  file_change {
    absolute_path_uri: "file:///src/components/LoginPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { UserSession, UserRole, Subsidiary } from \"../types\";\nimport { MOCK_USER_PERSONAS, PersonaCredentials } from \"../data/mockUsers\";\nimport {\n  Shield,\n  KeyRound,\n  Lock,\n  Building2,\n  HardHat,\n  Scale,\n  Users,\n  CheckCircle2,\n  ArrowRight,\n  Sparkles,\n  AlertTriangle,\n  FileCheck,\n  Cpu,\n  BadgeCheck,\n  LogIn,\n} from \"lucide-react\";\n\ninterface LoginPageProps {\n  onLogin: (user: UserSession) => void;\n}\n\nexport const LoginPage: React.FC<LoginPageProps> = ({ onLogin }) => {\n  const [selectedPersona, setSelectedPersona] = useState<PersonaCredentials>(\n    MOCK_USER_PERSONAS[0]\n  );\n  const [authMode, setAuthMode] = useState<\"persona\" | \"credentials\">(\"persona\");\n\n  // Form states for manual login\n  const [loginRole, setLoginRole] = useState<UserRole>(\"mine_official\");\n  const [loginId, setLoginId] = useState<string>(\"SECL-MGR-4192\");\n  const [password, setPassword] = useState<string>(\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\");\n  const [subsidiary, setSubsidiary] = useState<Subsidiary>(\"SECL\");\n  const [dscKeySelected, setDscKeySelected] = useState<boolean>(true);\n  const [captchaInput, setCaptchaInput] = useState<string>(\"7X9K2\");\n  const [captchaCode] = useState<string>(\"7X9K2\");\n  const [isLoading, setIsLoading] = useState<boolean>(false);\n  const [errorMessage, setErrorMessage] = useState<string | null>(null);\n\n  const handlePersonaSelect = (persona: PersonaCredentials) => {\n    setSelectedPersona(persona);\n    setLoginRole(persona.user.role);\n    setLoginId(persona.loginId);\n    setSubsidiary(persona.user.subsidiary);\n    setErrorMessage(null);\n  };\n\n  const handleDirectLogin = (persona: PersonaCredentials) => {\n    setIsLoading(true);\n    setTimeout(() => {\n      setIsLoading(false);\n      onLogin(persona.user);\n    }, 450);\n  };\n\n  const handleFormSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMessage(null);\n\n    if (captchaInput.trim().toUpperCase() !== captchaCode.toUpperCase()) {\n      setErrorMessage(\"Security captcha mismatch. Please re-enter the 5-character code.\");\n      return;\n    }\n\n    if (!loginId.trim()) {\n      setErrorMessage(\"Please enter an authorized Login ID / Employee EIS number.\");\n      return;\n    }\n\n    setIsLoading(true);\n    setTimeout(() => {\n      setIsLoading(false);\n      // Find matching persona or build custom session for selected role\n      const matched = MOCK_USER_PERSONAS.find((p) => p.user.role === loginRole) || selectedPersona;\n      onLogin({\n        ...matched.user,\n        subsidiary: subsidiary,\n        employeeCode: loginId,\n      });\n    }, 500);\n  };\n\n  const getRoleIcon = (role: UserRole) => {\n    switch (role) {\n      case \"mine_official\":\n        return HardHat;\n      case \"corporate_hq\":\n        return Building2;\n      case \"regulatory_authority\":\n        return Scale;\n      case \"safety_officer\":\n        return Shield;\n      case \"contractor_supervisor\":\n        return Users;\n      default:\n        return HardHat;\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#050505] text-[#ECECEC] flex flex-col justify-between selection:bg-[#FF4D00] selection:text-black\">\n      {/* Top Ministry Banner */}\n      <header className=\"border-b border-[#222] bg-[#090909] px-4 sm:px-8 py-3\">\n        <div className=\"max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3\">\n          <div className=\"flex items-center space-x-3.5\">\n            <div className=\"w-9 h-9 bg-[#111] border border-[#333] flex items-center justify-center shrink-0\">\n              <span className=\"font-serif italic font-bold text-[#FF4D00] text-lg\">\340\244\226</span>\n            </div>\n            <div>\n              <div className=\"flex items-center space-x-2\">\n                <span className=\"text-[10px] tracking-[0.25em] font-bold text-[#777] uppercase\">\n                  Govt. of India \342\200\242 Ministry of Coal \342\200\242 DGMS \342\200\242 Coal India Ltd.\n                </span>\n              </div>\n              <h1 className=\"text-lg font-serif italic text-[#ECECEC] tracking-tight\">\n                \340\244\226\340\244\276\340\244\250\340\244\250\340\244\246\340\245\203\340\244\267\340\245\215\340\244\237\340\244\277 <span className=\"font-sans text-xs not-italic text-[#888] font-normal uppercase\">(KhananDrishti \342\200\242 MineSmart Portal)</span>\n              </h1>\n            </div>\n          </div>\n\n          <div className=\"flex items-center space-x-3 text-[11px] font-mono text-neutral-400\">\n            <span className=\"flex items-center space-x-1.5 bg-[#141414] border border-[#262626] px-2.5 py-1 rounded\">\n              <Shield className=\"w-3.5 h-3.5 text-emerald-400\" />\n              <span>Role-Based Access Control (RBAC)</span>\n            </span>\n            <span className=\"hidden md:inline text-neutral-600\">|</span>\n            <span className=\"hidden md:inline text-[#FF4D00]\">Class-3 DSC Token Enabled</span>\n          </div>\n        </div>\n      </header>\n\n      {/* Main Authentication Grid */}\n      <main className=\"max-w-7xl w-full mx-auto px-4 sm:px-8 py-8 flex-1 flex flex-col justify-center\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n          \n          {/* Left Column: Role Selector / Personas (7 cols) */}\n          <div className=\"lg:col-span-7 space-y-6\">\n            <div>\n              <div className=\"flex items-center space-x-2\">\n                <span className=\"text-[10px] font-mono uppercase tracking-widest text-[#FF4D00] font-bold\">\n                  Statutory Identity Gateway\n                </span>\n                <span className=\"text-[9px] bg-[#141414] border border-[#333] text-neutral-400 px-2 py-0.5 font-mono\">\n                  Mines Act 1952 / CMR 2017\n                </span>\n              </div>\n              <h2 className=\"text-2xl sm:text-3xl font-serif font-normal text-white mt-1.5 tracking-tight\">\n                Select Your Official Role & Digital Authority\n              </h2>\n              <p className=\"text-xs text-neutral-400 font-sans mt-1 leading-relaxed max-w-2xl\">\n                Access is strictly compartmentalized based on statutory designations. Choose a pre-authorized mining persona for rapid verification or sign in via employee EIS credentials.\n              </p>\n            </div>\n\n            {/* Persona Cards List */}\n            <div className=\"space-y-3\">\n              {MOCK_USER_PERSONAS.map((persona) => {\n                const Icon = getRoleIcon(persona.user.role);\n                const isSelected = selectedPersona.user.id === persona.user.id;\n\n                return (\n                  <div\n                    key={persona.user.id}\n                    onClick={() => handlePersonaSelect(persona)}\n                    className={`p-4 rounded-xl border transition-all cursor-pointer relative ${\n                      isSelected\n                        ? \"bg-[#111] border-[#FF4D00] shadow-lg shadow-[#FF4D00]/5\"\n                        : \"bg-[#0A0A0A] border-[#222] hover:border-[#333] hover:bg-[#0E0E0E]\"\n                    }`}\n                  >\n                    <div className=\"flex flex-col sm:flex-row sm:items-start justify-between gap-3\">\n                      <div className=\"flex items-start space-x-3.5\">\n                        <div\n                          className={`p-2.5 rounded-lg border ${\n                            isSelected\n                              ? \"bg-[#1A1A1A] border-[#FF4D00] text-[#FF4D00]\"\n                              : \"bg-[#121212] border-[#262626] text-neutral-400\"\n                          }`}\n                        >\n                          <Icon className=\"w-5 h-5\" />\n                        </div>\n                        <div>\n                          <div className=\"flex flex-wrap items-center gap-2\">\n                            <h3 className=\"text-sm font-serif font-semibold text-white\">\n                              {persona.user.name}\n                            </h3>\n                            <span className={`text-[10px] font-mono px-2 py-0.2 rounded border bg-[#050505] ${persona.badgeColor}`}>\n                              {persona.user.role.replace(\"_\", \" \").toUpperCase()}\n                            </span>\n                            <span className=\"text-[10px] font-mono text-neutral-500\">\n                              {persona.user.employeeCode}\n                            </span>\n                          </div>\n\n                          <p className=\"text-xs text-neutral-300 font-medium mt-0.5\">\n                            {persona.user.designation}\n                          </p>\n\n                          <p className=\"text-[11px] text-neutral-400 font-mono mt-0.5\">\n                            {persona.user.department} \342\200\242 <strong className=\"text-neutral-300 font-normal\">{persona.user.mineName}</strong>\n                          </p>\n                        </div>\n                      </div>\n\n                      {/* Instant Sign In Button */}\n                      <button\n                        onClick={(e) => {\n                          e.stopPropagation();\n                          handleDirectLogin(persona);\n                        }}\n                        disabled={isLoading}\n                        className={`shrink-0 flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs font-mono font-semibold transition-all cursor-pointer ${\n                          isSelected\n                            ? \"bg-[#FF4D00] hover:bg-[#e04400] text-black shadow\"\n                            : \"bg-[#161616] hover:bg-[#202020] text-neutral-200 border border-[#333]\"\n                        }`}\n                      >\n                        <span>Authorize As Role</span>\n                        <ArrowRight className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </div>\n\n                    {/* Statutory Powers Preview if selected */}\n                    {isSelected && (\n                      <div className=\"mt-3.5 pt-3 border-t border-[#222] grid grid-cols-1 sm:grid-cols-2 gap-2\">\n                        {persona.statutoryPowers.map((power, idx) => (\n                          <div key={idx} className=\"flex items-start space-x-1.5 text-[11px] text-neutral-400\">\n                            <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-400 shrink-0 mt-0.5\" />\n                            <span className=\"leading-snug\">{power}</span>\n                          </div>\n                        ))}\n                      </div>\n                    )}\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Right Column: Statutory Sign-In & Security Form (5 cols) */}\n          <div className=\"lg:col-span-5 space-y-6\">\n            <div className=\"bg-[#0e0e0e] border border-[#222] rounded-xl p-6 shadow-xl relative\">\n              \n              {/* Form Header */}\n              <div className=\"flex items-center justify-between pb-4 border-b border-[#222]\">\n                <div className=\"flex items-center space-x-2.5\">\n                  <div className=\"p-2 bg-[#161616] border border-[#262626] rounded-lg text-[#FF4D00]\">\n                    <KeyRound className=\"w-4 h-4\" />\n                  </div>\n                  <div>\n                    <h3 className=\"text-base font-serif font-semibold text-white\">\n                      Official Portal Sign-In\n                    </h3>\n                    <p className=\"text-[11px] text-neutral-400 font-mono\">\n                      Single Sign-On (SSO) with Class-3 DSC Token\n                    </p>\n                  </div>\n                </div>\n\n                <div className=\"flex bg-[#050505] p-0.5 border border-[#262626] rounded text-[10px] font-mono\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setAuthMode(\"persona\")}\n                    className={`px-2 py-1 rounded transition-colors ${\n                      authMode === \"persona\" ? \"bg-[#1c1c1c] text-[#FF4D00] font-bold\" : \"text-neutral-400\"\n                    }`}\n                  >\n                    Quick Preset\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setAuthMode(\"credentials\")}\n                    className={`px-2 py-1 rounded transition-colors ${\n                      authMode === \"credentials\" ? \"bg-[#1c1c1c] text-[#FF4D00] font-bold\" : \"text-neutral-400\"\n                    }`}\n                  >\n                    Credentials\n                  </button>\n                </div>\n              </div>\n\n              {/* Active Selected Persona Highlight Banner */}\n              <div className=\"mt-4 p-3 bg-[#141414] border border-[#262626] rounded-lg flex items-center justify-between gap-3 text-xs\">\n                <div>\n                  <span className=\"text-[10px] font-mono uppercase text-neutral-500 block\">Target Authentication Profile:</span>\n                  <p className=\"font-serif font-medium text-neutral-200 mt-0.5\">\n                    {selectedPersona.user.name} ({selectedPersona.user.designation})\n                  </p>\n                  <p className=\"text-[10px] font-mono text-[#FF4D00]\">\n                    {selectedPersona.authorityLevel}\n                  </p>\n                </div>\n                <BadgeCheck className=\"w-5 h-5 text-emerald-400 shrink-0\" />\n              </div>\n\n              {errorMessage && (\n                <div className=\"mt-4 p-3 bg-red-950/40 border border-red-800/50 rounded-lg text-red-300 text-xs flex items-start space-x-2\">\n                  <AlertTriangle className=\"w-4 h-4 text-red-400 shrink-0 mt-0.5\" />\n                  <span>{errorMessage}</span>\n                </div>\n              )}\n\n              {/* Login Form */}\n              <form onSubmit={handleFormSubmit} className=\"mt-5 space-y-4 text-xs\">\n                \n                {/* Role Selector */}\n                <div>\n                  <label className=\"block text-neutral-400 font-mono text-[11px] mb-1\">\n                    Select Statutory Role Category\n                  </label>\n                  <select\n                    value={loginRole}\n                    onChange={(e) => {\n                      const r = e.target.value as UserRole;\n                      setLoginRole(r);\n                      const matched = MOCK_USER_PERSONAS.find((p) => p.user.role === r);\n                      if (matched) setSelectedPersona(matched);\n                    }}\n                    className=\"w-full bg-[#070707] border border-[#262626] rounded-lg px-3 py-2 text-neutral-100 font-mono text-xs focus:outline-none focus:border-[#FF4D00]\"\n                  >\n                    <option value=\"mine_official\">Colliery Mine Official / Mines Manager</option>\n                    <option value=\"corporate_hq\">Corporate HQ / CIL & Subsidiary Apex</option>\n                    <option value=\"regulatory_authority\">DGMS Statutory Inspector / Regulator</option>\n                    <option value=\"safety_officer\">Colliery Safety Officer & Lead Auditor</option>\n                    <option value=\"contractor_supervisor\">Authorized Contractor Representative</option>\n                  </select>\n                </div>\n\n                {/* Subsidiary & Mine */}\n                <div className=\"grid grid-cols-2 gap-3\">\n                  <div>\n                    <label className=\"block text-neutral-400 font-mono text-[11px] mb-1\">\n                      Subsidiary\n                    </label>\n                    <select\n                      value={subsidiary}\n                      onChange={(e) => setSubsidiary(e.target.value as Subsidiary)}\n                      className=\"w-full bg-[#070707] border border-[#262626] rounded-lg px-3 py-2 text-neutral-100 font-mono text-xs focus:outline-none focus:border-[#FF4D00]\"\n                    >\n                      <option value=\"SECL\">SECL (South Eastern)</option>\n                      <option value=\"ECL\">ECL (Eastern Coalfields)</option>\n                      <option value=\"BCCL\">BCCL (Bharat Coking)</option>\n                      <option value=\"CCL\">CCL (Central Coalfields)</option>\n                      <option value=\"NCL\">NCL (Northern Coalfields)</option>\n                      <option value=\"MCL\">MCL (Mahanadi Coalfields)</option>\n                      <option value=\"WCL\">WCL (Western Coalfields)</option>\n                      <option value=\"CIL_HQ\">CIL Apex HQ (Kolkata)</option>\n                    </select>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-neutral-400 font-mono text-[11px] mb-1\">\n                      Login / EIS No.\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={loginId}\n                      onChange={(e) => setLoginId(e.target.value)}\n                      placeholder=\"e.g. EIS-90214432\"\n                      className=\"w-full bg-[#070707] border border-[#262626] rounded-lg px-3 py-2 text-neutral-100 font-mono text-xs focus:outline-none focus:border-[#FF4D00]\"\n                    />\n                  </div>\n                </div>\n\n                {/* Password / PIN */}\n                <div>\n                  <label className=\"block text-neutral-400 font-mono text-[11px] mb-1\">\n                    Statutory Password / Security Token PIN\n                  </label>\n                  <div className=\"relative\">\n                    <input\n                      type=\"password\"\n                      value={password}\n                      onChange={(e) => setPassword(e.target.value)}\n                      placeholder=\"Enter 8+ digit statutory passphrase\"\n                      className=\"w-full bg-[#070707] border border-[#262626] rounded-lg pl-3 pr-8 py-2 text-neutral-100 font-mono text-xs focus:outline-none focus:border-[#FF4D00]\"\n                    />\n                    <Lock className=\"w-3.5 h-3.5 text-neutral-500 absolute right-3 top-2.5\" />\n                  </div>\n                </div>\n\n                {/* Hardware DSC Token simulation toggle */}\n                <div className=\"p-3 bg-[#070707] border border-[#222] rounded-lg space-y-2\">\n                  <div className=\"flex items-center justify-between\">\n                    <div className=\"flex items-center space-x-2\">\n                      <Cpu className=\"w-4 h-4 text-[#FF4D00]\" />\n                      <span className=\"font-mono text-[11px] text-neutral-200\">\n                        Class-3 Cryptographic USB / DSC Token\n                      </span>\n                    </div>\n                    <label className=\"relative inline-flex items-center cursor-pointer\">\n                      <input\n                        type=\"checkbox\"\n                        checked={dscKeySelected}\n                        onChange={(e) => setDscKeySelected(e.target.checked)}\n                        className=\"sr-only peer\"\n                      />\n                      <div className=\"w-8 h-4 bg-[#222] peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-black after:content-[\'\'] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-3 after:w-3.5 after:transition-all peer-checked:bg-[#FF4D00]\"></div>\n                    </label>\n                  </div>\n                  <p className=\"text-[10px] text-neutral-500 font-mono\">\n                    Token ID: {selectedPersona.dscKey} (Validated by CCA India / e-Mudhra)\n                  </p>\n                </div>\n\n                {/* Security Captcha */}\n                <div className=\"flex items-center space-x-3\">\n                  <div className=\"flex-1\">\n                    <label className=\"block text-neutral-400 font-mono text-[11px] mb-1\">\n                      Security Code\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={captchaInput}\n                      onChange={(e) => setCaptchaInput(e.target.value)}\n                      maxLength={5}\n                      className=\"w-full bg-[#070707] border border-[#262626] rounded-lg px-3 py-2 text-neutral-100 font-mono text-xs uppercase tracking-widest focus:outline-none focus:border-[#FF4D00]\"\n                    />\n                  </div>\n                  <div className=\"shrink-0 pt-5\">\n                    <div className=\"px-3.5 py-2 bg-[#181818] border border-[#333] font-mono font-bold tracking-widest text-[#FF4D00] text-sm select-none line-through\">\n                      {captchaCode}\n                    </div>\n                  </div>\n                </div>\n\n                {/* Submit Action */}\n                <button\n                  type=\"submit\"\n                  disabled={isLoading}\n                  className=\"w-full mt-2 flex items-center justify-center space-x-2 bg-[#FF4D00] hover:bg-[#e04400] text-black font-mono font-bold py-2.5 rounded-lg text-xs shadow-md transition-all cursor-pointer disabled:opacity-50\"\n                >\n                  <LogIn className=\"w-4 h-4\" />\n                  <span>\n                    {isLoading\n                      ? \"Verifying Cryptographic Credentials...\"\n                      : `Sign In as ${selectedPersona.user.name.split(\" \")[0]} (${selectedPersona.user.role.toUpperCase()})`}\n                  </span>\n                </button>\n              </form>\n\n              {/* Statutory Notice */}\n              <div className=\"mt-4 pt-3 border-t border-[#222] text-[10px] text-neutral-500 font-mono leading-relaxed\">\n                Notice: Unauthorized colliery data submission or fraudulent log alterations is a cognizable offense under Section 84 of the Mines Act, 1952. All digital actions logged in immutable hash audit trail.\n              </div>\n            </div>\n\n            {/* Quick Demo Assist Pill Box */}\n            <div className=\"p-4 bg-[#0A0A0A] border border-[#222] rounded-xl text-xs space-y-2\">\n              <div className=\"flex items-center space-x-2 text-neutral-300 font-medium font-serif\">\n                <Sparkles className=\"w-4 h-4 text-[#FF4D00]\" />\n                <span>Instant Evaluation Guide</span>\n              </div>\n              <p className=\"text-[11px] text-neutral-400 leading-relaxed font-sans\">\n                You can switch between any of the 5 roles at any time from within the portal header or log out back to this screen to verify role-based access restrictions.\n              </p>\n            </div>\n          </div>\n\n        </div>\n      </main>\n\n      {/* Footer */}\n      <footer className=\"h-10 bg-[#080808] border-t border-[#222] flex items-center px-4 sm:px-8 justify-between text-[9px] text-[#555] uppercase tracking-[0.2em]\">\n        <span>KhananDrishti \342\200\242 Coal Sector Digital Compliance Platform</span>\n        <span className=\"font-mono text-[#444] hidden sm:inline\">GOVT. OF INDIA STATUTORY COMPLIANCE SYSTEM</span>\n      </footer>\n    </div>\n  );\n};\n"
    }
