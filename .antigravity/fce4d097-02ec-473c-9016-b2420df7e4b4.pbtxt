  file_change {
    absolute_path_uri: "file:///src/components/WorkflowAuditTrail.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { AuditLogEntry, StatutoryViolation } from \"../types\";\nimport { AUDIT_TRAIL_LOGS } from \"../data/mockData\";\nimport {\n  GitCommit,\n  ShieldCheck,\n  Lock,\n  CheckCircle2,\n  AlertTriangle,\n  FileCheck2,\n  Clock,\n  KeyRound,\n  ExternalLink,\n  Search,\n} from \"lucide-react\";\n\ninterface WorkflowAuditTrailProps {\n  violations: StatutoryViolation[];\n}\n\nexport const WorkflowAuditTrail: React.FC<WorkflowAuditTrailProps> = ({\n  violations,\n}) => {\n  const [logs, setLogs] = useState<AuditLogEntry[]>(AUDIT_TRAIL_LOGS);\n  const [selectedLog, setSelectedLog] = useState<AuditLogEntry | null>(logs[0]);\n  const [signingPassword, setSigningPassword] = useState<string>(\"\");\n  const [isSigning, setIsSigning] = useState<boolean>(false);\n  const [signedNoticeId, setSignedNoticeId] = useState<string | null>(null);\n\n  const handleDigitalSign = (violationId: string) => {\n    setIsSigning(true);\n    setTimeout(() => {\n      setIsSigning(false);\n      setSignedNoticeId(violationId);\n      const newHash = `sha256-${Math.random().toString(36).substring(2, 12)}${Math.random().toString(36).substring(2, 12)}`;\n      const newEntry: AuditLogEntry = {\n        id: `LOG-SHA-${Date.now().toString().slice(-5)}`,\n        timestamp: `${new Date().toISOString().split(\"T\")[0]} ${new Date().toLocaleTimeString()} IST`,\n        actor: \"Er. Alok Kumar Sharma (Statutory Colliery Manager)\",\n        role: \"Mine Official\",\n        action: `Cryptographically counter-signed Action Taken Report for notice ${violationId}`,\n        targetRef: violationId,\n        tamperProofHash: newHash,\n        previousHash: logs[0]?.tamperProofHash || \"root\",\n        verified: true,\n      };\n      setLogs([newEntry, ...logs]);\n      setSelectedLog(newEntry);\n    }, 800);\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Top Banner */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n        <div className=\"flex items-center space-x-3.5\">\n          <div className=\"p-3 bg-amber-500/10 border border-amber-500/30 rounded-xl text-amber-400\">\n            <GitCommit className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"text-xs font-bold uppercase tracking-wider text-amber-400\">\n                Tamper-Evident Digital Governance\n              </span>\n              <span className=\"text-[10px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2 py-0.2 rounded font-mono\">\n                SHA-256 Hash Chain\n              </span>\n            </div>\n            <h2 className=\"text-lg font-bold text-white mt-0.5\">\n              Automated Escalations, CAPA Workflow & Blockchain-Style Audit Trail\n            </h2>\n            <p className=\"text-xs text-slate-400\">\n              Guaranteed accountability with non-repudiation digital signatures and multi-tier escalation triggers.\n            </p>\n          </div>\n        </div>\n\n        <div className=\"flex items-center space-x-2 bg-slate-950 p-2.5 rounded-xl border border-slate-800 text-xs\">\n          <ShieldCheck className=\"w-4 h-4 text-emerald-400\" />\n          <span className=\"text-slate-300\">All Audit Hashes: <strong className=\"text-emerald-400\">100% Cryptographically Verified</strong></span>\n        </div>\n      </div>\n\n      {/* 3-Tier Escalation Workflow Visualizer */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-4\">\n        <h3 className=\"text-sm font-bold text-white flex items-center gap-2\">\n          <Clock className=\"w-4 h-4 text-amber-400\" />\n          <span>Statutory CAPA Escalation Hierarchy & Timers</span>\n        </h3>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 text-xs\">\n          {/* Level 1 */}\n          <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-800 relative\">\n            <div className=\"flex items-center justify-between\">\n              <span className=\"text-[11px] font-bold text-emerald-400 uppercase tracking-wider\">\n                Level 1: Colliery Level\n              </span>\n              <span className=\"text-[10px] bg-emerald-950 text-emerald-300 px-2 py-0.5 rounded font-mono font-bold\">\n                0 - 7 Days\n              </span>\n            </div>\n            <p className=\"text-slate-200 font-semibold mt-2\">Colliery Safety Officer & Mines Manager</p>\n            <p className=\"text-slate-400 text-[11px] mt-1 leading-relaxed\">\n              Immediate hazard cordon, engineering remediation, and preliminary Action Taken Report (ATR) drafting.\n            </p>\n          </div>\n\n          {/* Level 2 */}\n          <div className=\"bg-slate-950 p-4 rounded-xl border border-amber-900/60 relative\">\n            <div className=\"flex items-center justify-between\">\n              <span className=\"text-[11px] font-bold text-amber-400 uppercase tracking-wider\">\n                Level 2: Subsidiary HQ\n              </span>\n              <span className=\"text-[10px] bg-amber-950 text-amber-300 px-2 py-0.5 rounded font-mono font-bold\">\n                8 - 14 Days\n              </span>\n            </div>\n            <p className=\"text-slate-200 font-semibold mt-2\">Area General Manager & Director (Technical)</p>\n            <p className=\"text-slate-400 text-[11px] mt-1 leading-relaxed\">\n              Automated SMS/Email escalation triggers; emergency fleet and civil contractors reallocated.\n            </p>\n          </div>\n\n          {/* Level 3 */}\n          <div className=\"bg-slate-950 p-4 rounded-xl border border-red-900/60 relative\">\n            <div className=\"flex items-center justify-between\">\n              <span className=\"text-[11px] font-bold text-red-400 uppercase tracking-wider\">\n                Level 3: Regulatory Red Alert\n              </span>\n              <span className=\"text-[10px] bg-red-950 text-red-300 px-2 py-0.5 rounded font-mono font-bold\">\n                &gt; 14 Days Overdue\n              </span>\n            </div>\n            <p className=\"text-slate-200 font-semibold mt-2\">DGMS Regional Office & Ministry of Coal</p>\n            <p className=\"text-slate-400 text-[11px] mt-1 leading-relaxed\">\n              Statutory prohibition notices, Star Rating penalty deduction, and physical joint re-inspection.\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {/* Audit Log Chain & Digital Signature Box */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Left 2 Cols: Immutable Audit Log List */}\n        <div className=\"lg:col-span-2 bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-4\">\n          <div className=\"flex items-center justify-between pb-3 border-b border-slate-800\">\n            <h3 className=\"text-sm font-bold text-white flex items-center gap-2\">\n              <Lock className=\"w-4 h-4 text-amber-400\" />\n              <span>Immutable Hash-Chained Audit Stream</span>\n            </h3>\n            <span className=\"text-xs text-slate-400\">{logs.length} Blocks</span>\n          </div>\n\n          <div className=\"space-y-3\">\n            {logs.map((log) => {\n              const isSelected = selectedLog?.id === log.id;\n              return (\n                <div\n                  key={log.id}\n                  onClick={() => setSelectedLog(log)}\n                  className={`p-3.5 rounded-xl border cursor-pointer transition-all ${\n                    isSelected\n                      ? \"bg-amber-500/10 border-amber-500/50\"\n                      : \"bg-slate-950/70 border-slate-800 hover:border-slate-700\"\n                  }`}\n                >\n                  <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-1 text-xs\">\n                    <div className=\"flex items-center space-x-2\">\n                      <span className=\"font-mono font-bold text-amber-400\">{log.id}</span>\n                      <span className=\"text-slate-500 font-mono text-[11px]\">{log.timestamp}</span>\n                    </div>\n                    <span className=\"text-emerald-400 text-[11px] font-semibold flex items-center\">\n                      <CheckCircle2 className=\"w-3.5 h-3.5 mr-1\" /> Verified Block\n                    </span>\n                  </div>\n\n                  <p className=\"text-slate-200 text-xs font-semibold mt-2\">{log.action}</p>\n\n                  <div className=\"mt-2 text-[11px] text-slate-400 flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-slate-800/80\">\n                    <span>Actor: <strong className=\"text-slate-300\">{log.actor}</strong></span>\n                    <span className=\"font-mono text-slate-500 truncate max-w-[200px]\">\n                      Hash: {log.tamperProofHash.slice(0, 16)}...\n                    </span>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Right Col: Digital Signature Sign-Off Console */}\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-4\">\n          <h3 className=\"text-sm font-bold text-white flex items-center gap-2 pb-3 border-b border-slate-800\">\n            <KeyRound className=\"w-4 h-4 text-amber-400\" />\n            <span>Digital Certificate Sign-Off</span>\n          </h3>\n\n          <div className=\"text-xs space-y-3\">\n            <div className=\"p-3 bg-slate-950 rounded-xl border border-slate-800 space-y-1\">\n              <span className=\"text-slate-400 block text-[11px]\">Authorized Certificate:</span>\n              <strong className=\"text-slate-200 block\">Class-3 DSC (Mine Manager - Er. Alok Sharma)</strong>\n              <span className=\"text-slate-500 font-mono text-[10px]\">Valid Until: 31-DEC-2027</span>\n            </div>\n\n            <div>\n              <label className=\"block text-slate-400 mb-1 font-semibold\">Select Pending Notice for Sign-Off</label>\n              <select className=\"w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-slate-100 text-xs focus:outline-none focus:border-amber-500\">\n                {violations.map((v) => (\n                  <option key={v.id} value={v.id}>\n                    {v.id} - {v.mineName} ({v.clause})\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            <button\n              onClick={() => handleDigitalSign(\"VIOL-2026-881\")}\n              disabled={isSigning}\n              className=\"w-full flex items-center justify-center space-x-2 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-bold py-2.5 rounded-xl text-xs shadow-lg shadow-amber-500/20 transition-all cursor-pointer disabled:opacity-50\"\n            >\n              <KeyRound className=\"w-4 h-4\" />\n              <span>{isSigning ? \"Signing & Hashing Block...\" : \"Sign Action Taken Report (DSC)\"}</span>\n            </button>\n\n            {signedNoticeId && (\n              <div className=\"p-3 bg-emerald-950/60 border border-emerald-700/50 rounded-xl text-emerald-200 text-xs\">\n                \342\234\223 Cryptographic signature appended. Audit record propagated across CIL node network.\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
