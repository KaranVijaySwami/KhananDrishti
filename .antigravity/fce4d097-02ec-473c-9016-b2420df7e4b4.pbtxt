  file_change {
    absolute_path_uri: "file:///src/components/AiSentinelOcr.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "    <div className=\"space-y-6\">\n      {/* Top Banner */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n        <div className=\"flex items-center space-x-3.5\">\n          <div className=\"p-3 bg-amber-500/10 border border-amber-500/30 rounded-xl text-amber-400\">\n            <Bot className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"text-xs font-bold uppercase tracking-wider text-amber-400\">\n                AI Sentinel & Legal Intelligence Suite\n              </span>\n              <span className=\"text-[10px] bg-gradient-to-r from-amber-500 to-orange-500 text-slate-950 font-bold px-2 py-0.2 rounded-full uppercase\">\n                Gemini 3.7 Powered\n              </span>\n            </div>\n            <h2 className=\"text-lg font-bold text-white mt-0.5\">\n              Statutory Notice OCR, Predictive Hazard Matrix & Regulatory Copilot\n            </h2>\n            <p className=\"text-xs text-slate-400\">\n              Transforming dense regulatory letters into automated compliance workflows and verified Action Taken Reports.\n            </p>\n          </div>\n        </div>\n\n        {/* Sub-tab Navigation */}\n        <div className=\"flex items-center bg-slate-950 p-1 rounded-xl border border-slate-800 text-xs\">\n          <button\n            onClick={() => setActiveSubTab(\"ocr\")}\n            className={`px-3 py-1.5 rounded-lg font-semibold transition-all ${\n              activeSubTab === \"ocr\" ? \"bg-amber-500 text-slate-950 shadow\" : \"text-slate-400 hover:text-white\"\n            }`}\n          >\n            OCR Digitizer\n          </button>\n          <button\n            onClick={() => setActiveSubTab(\"risk_engine\")}\n            className={`px-3 py-1.5 rounded-lg font-semibold transition-all ${\n              activeSubTab === \"risk_engine\" ? \"bg-amber-500 text-slate-950 shadow\" : \"text-slate-400 hover:text-white\"\n            }`}\n          >\n            Risk Analytics\n          </button>\n          <button\n            onClick={() => setActiveSubTab(\"atr_generator\")}\n            className={`px-3 py-1.5 rounded-lg font-semibold transition-all ${\n              activeSubTab === \"atr_generator\" ? \"bg-amber-500 text-slate-950 shadow\" : \"text-slate-400 hover:text-white\"\n            }`}\n          >\n            ATR Generator\n          </button>\n          <button\n            onClick={() => setActiveSubTab(\"copilot\")}\n            className={`px-3 py-1.5 rounded-lg font-semibold transition-all ${\n              activeSubTab === \"copilot\" ? \"bg-amber-500 text-slate-950 shadow\" : \"text-slate-400 hover:text-white\"\n            }`}\n          >\n            CMR Copilot\n          </button>\n        </div>\n      </div>\n\n      {/* Sub-tab 1: OCR Document Digitizer */}\n      {activeSubTab === \"ocr\" && (\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n          {/* Left: Input Notice Box */}\n          <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-4\">\n            <div className=\"flex items-center justify-between pb-3 border-b border-slate-800\">\n              <h3 className=\"text-sm font-bold text-white flex items-center gap-2\">\n                <FileSearch className=\"w-4 h-4 text-amber-400\" />\n                <span>Statutory Notice / EC Letter Input</span>\n              </h3>\n              <select\n                value={docType}\n                onChange={(e) => setDocType(e.target.value)}\n                className=\"bg-slate-950 border border-slate-700 text-xs rounded-lg px-2.5 py-1 text-slate-200 focus:outline-none\"\n              >\n                <option value=\"DGMS_Section_22_Notice\">DGMS Sec 22 Notice</option>\n                <option value=\"MoEFCC_EC_Clearance\">MoEFCC EC Clearance</option>\n                <option value=\"SPCB_Consent_Notice\">State PCB Show-Cause</option>\n              </select>\n            </div>\n\n            <textarea\n              rows={12}\n              value={sampleDocumentText}\n              onChange={(e) => setSampleDocumentText(e.target.value)}\n              placeholder=\"Paste raw text or uploaded statutory letter OCR stream...\"\n              className=\"w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-xs font-mono text-slate-300 leading-relaxed focus:outline-none focus:border-amber-500\"\n            />\n\n            <button\n              onClick={handleRunOcr}\n              disabled={isProcessingOcr}\n              className=\"w-full flex items-center justify-center space-x-2 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-bold py-2.5 rounded-xl text-xs shadow-lg shadow-amber-500/20 transition-all cursor-pointer disabled:opacity-50\"\n            >\n              <Sparkles className=\"w-4 h-4\" />\n              <span>{isProcessingOcr ? \"Extracting Legal Covenants...\" : \"Run AI OCR & Clause Extraction\"}</span>\n            </button>\n          </div>\n\n          {/* Right: Extracted Structured Covenants */}\n          <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg flex flex-col justify-between\">\n            <div>\n              <div className=\"flex items-center justify-between pb-3 border-b border-slate-800\">\n                <h3 className=\"text-sm font-bold text-white flex items-center gap-2\">\n                  <FileCheck2 className=\"w-4 h-4 text-amber-400\" />\n                  <span>Extracted Statutory Action Items</span>\n                </h3>\n                {ocrResult && (\n                  <span className=\"text-[10px] bg-red-500/20 text-red-400 border border-red-500/30 px-2 py-0.5 rounded font-bold uppercase\">\n                    {ocrResult.riskRating}\n                  </span>\n                )}\n              </div>\n\n              {ocrResult ? (\n                <div className=\"mt-4 space-y-3.5 text-xs\">\n                  <div className=\"bg-slate-950 p-3 rounded-xl border border-slate-800 space-y-1\">\n                    <div className=\"flex justify-between\">\n                      <span className=\"text-slate-400\">Issuing Body:</span>\n                      <strong className=\"text-slate-100\">{ocrResult.issuingAuthority}</strong>\n                    </div>\n                    <div className=\"flex justify-between\">\n                      <span className=\"text-slate-400\">Notice Ref:</span>\n                      <strong className=\"font-mono text-amber-300\">{ocrResult.referenceNumber}</strong>\n                    </div>\n                    <div className=\"flex justify-between\">\n                      <span className=\"text-slate-400\">Statutory Deadline:</span>\n                      <strong className=\"text-red-400 font-bold\">{ocrResult.statutoryDeadline}</strong>\n                    </div>\n                  </div>\n\n                  <div>\n                    <span className=\"text-xs font-semibold text-slate-300 block mb-1.5\">\n                      Statutory Non-Compliance Covenants:\n                    </span>\n                    <div className=\"space-y-2\">\n                      {ocrResult.covenants.map((cov, i) => (\n                        <div key={i} className=\"p-2.5 bg-slate-950 rounded-lg border border-slate-800 text-[11px]\">\n                          <strong className=\"text-amber-400 block\">{cov.clause}</strong>\n                          <span className=\"text-slate-300 block mt-0.5\">{cov.requirement}</span>\n                          <span className=\"text-red-400 font-medium block mt-1\">Status: {cov.status}</span>\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n\n                  <div>\n                    <span className=\"text-xs font-semibold text-slate-300 block mb-1.5\">\n                      Auto-Assigned Action Items:\n                    </span>\n                    <div className=\"space-y-2\">\n                      {ocrResult.actionItems.map((act, i) => (\n                        <div key={i} className=\"p-2.5 bg-slate-950 rounded-lg border border-slate-800 text-[11px] flex justify-between items-start\">\n                          <div>\n                            <strong className=\"text-slate-200 block\">{act.task}</strong>\n                            <span className=\"text-slate-400 block mt-0.5\">Assigned to: {act.assignedTo}</span>\n                          </div>\n                          <span className=\"text-red-400 font-bold shrink-0 ml-2\">Due: {act.targetDate}</span>\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n                </div>\n              ) : (\n                <div className=\"py-16 text-center text-slate-500 space-y-2\">\n                  <Cpu className=\"w-8 h-8 mx-auto text-slate-600\" />\n                  <p className=\"text-xs\">\n                    Click \"Run AI OCR\" to automatically parse statutory notice covenants, identify deadlines, and draft action items.\n                  </p>\n                </div>\n              )}\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Sub-tab 2: Risk Analytics */}\n      {activeSubTab === \"risk_engine\" && (\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-lg space-y-5\">\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-800\">\n            <div>\n              <h3 className=\"text-base font-bold text-white flex items-center gap-2\">\n                <ShieldAlert className=\"w-5 h-5 text-amber-400\" />\n                <span>Predictive Hazard Matrix & Operational Risk Engine</span>\n              </h3>\n              <p className=\"text-xs text-slate-400\">\n                Correlating real-time slope radar, CH4/CO gas sensors, dust monitors, and contractor safety records.\n              </p>\n            </div>\n            <button\n              onClick={handleAnalyzeRisk}\n              disabled={isAnalyzingRisk}\n              className=\"flex items-center space-x-2 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-bold px-4 py-2 rounded-xl text-xs shadow-lg shadow-amber-500/20 transition-all cursor-pointer disabled:opacity-50\"\n            >\n              <Sparkles className=\"w-4 h-4\" />\n              <span>{isAnalyzingRisk ? \"Computing Risk Vector...\" : \"Run AI Risk Engine\"}</span>\n            </button>\n          </div>\n\n          {riskAnalysis ? (\n            <div className=\"space-y-5 text-xs animate-in fade-in\">\n              <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-800\">\n                  <span className=\"text-slate-400 block text-[11px]\">Calculated Risk Index</span>\n                  <div className=\"flex items-baseline space-x-2 mt-1\">\n                    <span className=\"text-3xl font-black text-white\">{riskAnalysis.riskScore}</span>\n                    <span className=\"text-slate-500\">/ 100</span>\n                  </div>\n                  <span className=\"text-red-400 font-bold mt-1 block\">Level: {riskAnalysis.hazardLevel}</span>\n                </div>\n\n                <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-800 md:col-span-2\">\n                  <span className=\"text-slate-400 block text-[11px]\">Executive Summary</span>\n                  <p className=\"text-slate-200 mt-1 text-xs leading-relaxed\">{riskAnalysis.summary}</p>\n                </div>\n              </div>\n\n              <div>\n                <h4 className=\"text-xs font-bold text-slate-300 uppercase tracking-wider mb-2\">\n                  Identified High-Risk Areas & Recommended Remediation:\n                </h4>\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                  {riskAnalysis.highRiskAreas?.map((item: any, idx: number) => (\n                    <div key={idx} className=\"bg-slate-950 p-4 rounded-xl border border-red-900/40 space-y-2\">\n                      <div className=\"flex justify-between items-center\">\n                        <strong className=\"text-slate-100\">{item.area}</strong>\n                        <span className=\"text-[10px] bg-red-950 text-red-300 px-2 py-0.5 rounded font-bold\">\n                          {item.severity}\n                        </span>\n                      </div>\n                      <p className=\"text-amber-300 text-[11px] font-semibold\">{item.hazard}</p>\n                      <p className=\"text-slate-300 text-xs\">{item.recommendedAction}</p>\n                      <span className=\"text-[10px] font-mono text-slate-500 block pt-1 border-t border-slate-800\">\n                        {item.statutoryReference}\n                      </span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            </div>\n          ) : (\n            <div className=\"text-center py-12 text-slate-500 space-y-2\">\n              <Cpu className=\"w-8 h-8 mx-auto text-slate-600\" />\n              <p className=\"text-xs\">Click \"Run AI Risk Engine\" to calculate real-time hazard vectors for {selectedMine.name}.</p>\n            </div>\n          )}\n        </div>\n      )}\n\n      {/* Sub-tab 3: ATR Generator */}\n      {activeSubTab === \"atr_generator\" && (\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n          {/* Input Form */}\n          <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-4\">\n            <h3 className=\"text-sm font-bold text-white flex items-center gap-2 pb-3 border-b border-slate-800\">\n              <FileCheck2 className=\"w-4 h-4 text-amber-400\" />\n              <span>Action Taken Report (ATR) Generator</span>\n            </h3>\n\n            <div className=\"text-xs space-y-3\">\n              <div>\n                <label className=\"block text-slate-400 mb-1 font-semibold\">Violation Notice Reference</label>\n                <input\n                  type=\"text\"\n                  value={atrForm.violationRef}\n                  onChange={(e) => setAtrForm({ ...atrForm, violationRef: e.target.value })}\n                  className=\"w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-slate-100 font-mono text-xs focus:outline-none focus:border-amber-500\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-slate-400 mb-1 font-semibold\">Original Statutory Observations</label>\n                <textarea\n                  rows={3}\n                  value={atrForm.observations}\n                  onChange={(e) => setAtrForm({ ...atrForm, observations: e.target.value })}\n                  className=\"w-full bg-slate-950 border border-slate-700 rounded-xl p-3 text-slate-200 text-xs focus:outline-none focus:border-amber-500\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-slate-400 mb-1 font-semibold\">Physical Corrective Measures Executed</label>\n                <textarea\n                  rows={4}\n                  value={atrForm.actionsTaken}\n                  onChange={(e) => setAtrForm({ ...atrForm, actionsTaken: e.target.value })}\n                  className=\"w-full bg-slate-950 border border-slate-700 rounded-xl p-3 text-slate-200 text-xs focus:outline-none focus:border-amber-500\"\n                />\n              </div>\n\n              <button\n                onClick={handleGenerateAtr}\n                disabled={isGeneratingAtr}\n                className=\"w-full flex items-center justify-center space-x-2 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-bold py-2.5 rounded-xl text-xs shadow-lg shadow-amber-500/20 transition-all cursor-pointer disabled:opacity-50\"\n              >\n                <Sparkles className=\"w-4 h-4\" />\n                <span>{isGeneratingAtr ? \"Drafting Statutory ATR...\" : \"Auto-Draft Legal Action Taken Report\"}</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Generated ATR Output */}\n          <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg flex flex-col justify-between\">\n            <div>\n              <h3 className=\"text-sm font-bold text-white flex items-center gap-2 pb-3 border-b border-slate-800\">\n                <FileText className=\"w-4 h-4 text-amber-400\" />\n                <span>Certified DGMS Action Taken Report</span>\n              </h3>\n\n              {generatedAtr ? (\n                <div className=\"mt-4 space-y-3.5 text-xs animate-in fade-in\">\n                  <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2\">\n                    <h4 className=\"font-bold text-slate-100 text-xs\">{generatedAtr.title}</h4>\n                    <span className=\"text-slate-400 font-mono text-[11px] block\">{generatedAtr.refNumber}</span>\n                    <p className=\"text-slate-300 leading-relaxed text-xs\">{generatedAtr.executiveSummary}</p>\n                  </div>\n\n                  <div>\n                    <strong className=\"text-slate-300 block mb-1\">Covenants Verified Complied:</strong>\n                    <ul className=\"list-disc list-inside text-slate-400 space-y-1 text-[11px]\">\n                      {generatedAtr.statutoryProvisionsComplied?.map((p: string, i: number) => (\n                        <li key={i} className=\"text-slate-300\">{p}</li>\n                      ))}\n                    </ul>\n                  </div>\n\n                  <div className=\"p-3 bg-emerald-950/40 border border-emerald-800/40 rounded-xl text-[11px] text-emerald-300\">\n                    <strong className=\"block mb-1\">Mines Manager Statutory Declaration (Sec 17):</strong>\n                    <span>{generatedAtr.managerDeclaration}</span>\n                  </div>\n                </div>\n              ) : (\n                <div className=\"py-16 text-center text-slate-500 space-y-2\">\n                  <FileText className=\"w-8 h-8 mx-auto text-slate-600\" />\n                  <p className=\"text-xs\">Click \"Auto-Draft Legal Action Taken Report\" to produce formatted statutory submissions.</p>\n                </div>\n              )}\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Sub-tab 4: CMR Copilot */}\n      {activeSubTab === \"copilot\" && (\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg flex flex-col h-[520px]\">\n          <div className=\"pb-3 border-b border-slate-800 flex items-center justify-between\">\n            <div className=\"flex items-center space-x-2\">\n              <Bot className=\"w-5 h-5 text-amber-400\" />\n              <h3 className=\"text-sm font-bold text-white\">\n                KhananDrishti Statutory Mining Copilot (CMR 2017 & Mines Act 1952)\n              </h3>\n            </div>\n            <span className=\"text-[10px] text-slate-400\">Interactive Legal Counsel</span>\n          </div>\n\n          {/* Chat Messages Log */}\n          <div className=\"flex-1 overflow-y-auto p-3 space-y-3.5 my-3 bg-slate-950/80 rounded-xl border border-slate-800/80\">\n            {chatMessages.map((msg, idx) => (\n              <div\n                key={idx}\n                className={`flex ${msg.role === \"user\" ? \"justify-end\" : \"justify-start\"}`}\n              >\n                <div\n                  className={`max-w-[85%] p-3 rounded-2xl text-xs leading-relaxed ${\n                    msg.role === \"user\"\n                      ? \"bg-amber-500 text-slate-950 font-medium rounded-br-none\"\n                      : \"bg-slate-900 text-slate-200 border border-slate-800 rounded-bl-none shadow-sm\"\n                  }`}\n                >\n                  <p className=\"whitespace-pre-line\">{msg.content}</p>\n                  <span\n                    className={`block text-[9px] mt-1.5 ${\n                      msg.role === \"user\" ? \"text-slate-800\" : \"text-slate-500\"\n                    }`}\n                  >\n                    {msg.timestamp}\n                  </span>\n                </div>\n              </div>\n            ))}\n            {isAiReplying && (\n              <div className=\"flex justify-start\">\n                <div className=\"bg-slate-900 border border-slate-800 p-3 rounded-2xl text-xs text-amber-300 flex items-center space-x-2\">\n                  <Sparkles className=\"w-3.5 h-3.5 animate-spin\" />\n                  <span>Consulting Coal Mines Regulations 2017 database...</span>\n                </div>\n              </div>\n            )}\n          </div>\n\n          {/* Input Bar */}\n          <form onSubmit={handleSendChat} className=\"flex items-center space-x-2\">\n            <input\n              type=\"text\"\n              value={userInput}\n              onChange={(e) => setUserInput(e.target.value)}\n              placeholder=\"Ask anything on DGMS circulars, haul road slope, methane limits, or Form-B requirements...\"\n              className=\"flex-1 bg-slate-950 border border-slate-700 rounded-xl px-4 py-2.5 text-xs text-slate-100 focus:outline-none focus:border-amber-500\"\n            />\n            <button\n              type=\"submit\"\n              disabled={isAiReplying || !userInput.trim()}\n              className=\"p-2.5 bg-amber-500 hover:bg-amber-400 text-slate-950 rounded-xl font-bold transition-all disabled:opacity-50 cursor-pointer\"\n            >\n              <Send className=\"w-4 h-4\" />\n            </button>\n          </form>\n        </div>\n      )}\n    </div>"
      replacement_content: "    <div className=\"space-y-6\">\n      {/* Top Banner */}\n      <div className=\"bg-[#0e0e0e] border border-[#222] rounded-xl p-5 shadow-lg flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n        <div className=\"flex items-center space-x-3.5\">\n          <div className=\"p-3 bg-[#141414] border border-[#262626] rounded-lg text-[#FF4D00]\">\n            <Bot className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"text-[11px] font-mono tracking-widest text-[#FF4D00] uppercase font-bold\">\n                AI Sentinel & Legal Intelligence Suite\n              </span>\n              <span className=\"text-[10px] bg-[#1a1a1a] text-neutral-300 border border-[#333] font-mono px-2 py-0.5 rounded\">\n                Gemini 3.7 Core\n              </span>\n            </div>\n            <h2 className=\"text-xl font-serif font-normal text-white mt-1\">\n              Statutory Notice OCR, Predictive Hazard Matrix & Regulatory Copilot\n            </h2>\n            <p className=\"text-xs text-neutral-400 font-sans mt-0.5\">\n              Transforming dense regulatory letters into automated compliance workflows and verified Action Taken Reports.\n            </p>\n          </div>\n        </div>\n\n        {/* Sub-tab Navigation */}\n        <div className=\"flex items-center bg-[#141414] p-1 rounded-lg border border-[#222] text-xs font-mono\">\n          <button\n            onClick={() => setActiveSubTab(\"ocr\")}\n            className={`px-3 py-1.5 rounded transition-all ${\n              activeSubTab === \"ocr\" ? \"bg-[#FF4D00] text-black font-semibold shadow\" : \"text-neutral-400 hover:text-white\"\n            }`}\n          >\n            OCR Digitizer\n          </button>\n          <button\n            onClick={() => setActiveSubTab(\"risk_engine\")}\n            className={`px-3 py-1.5 rounded transition-all ${\n              activeSubTab === \"risk_engine\" ? \"bg-[#FF4D00] text-black font-semibold shadow\" : \"text-neutral-400 hover:text-white\"\n            }`}\n          >\n            Risk Analytics\n          </button>\n          <button\n            onClick={() => setActiveSubTab(\"atr_generator\")}\n            className={`px-3 py-1.5 rounded transition-all ${\n              activeSubTab === \"atr_generator\" ? \"bg-[#FF4D00] text-black font-semibold shadow\" : \"text-neutral-400 hover:text-white\"\n            }`}\n          >\n            ATR Generator\n          </button>\n          <button\n            onClick={() => setActiveSubTab(\"copilot\")}\n            className={`px-3 py-1.5 rounded transition-all ${\n              activeSubTab === \"copilot\" ? \"bg-[#FF4D00] text-black font-semibold shadow\" : \"text-neutral-400 hover:text-white\"\n            }`}\n          >\n            CMR Copilot\n          </button>\n        </div>\n      </div>\n\n      {/* Sub-tab 1: OCR Document Digitizer */}\n      {activeSubTab === \"ocr\" && (\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n          {/* Left: Input Notice Box */}\n          <div className=\"bg-[#0e0e0e] border border-[#222] rounded-xl p-5 shadow-lg space-y-4\">\n            <div className=\"flex items-center justify-between pb-3 border-b border-[#222]\">\n              <h3 className=\"text-sm font-serif font-semibold text-white flex items-center gap-2\">\n                <FileSearch className=\"w-4 h-4 text-[#FF4D00]\" />\n                <span>Statutory Notice / EC Letter Input</span>\n              </h3>\n              <select\n                value={docType}\n                onChange={(e) => setDocType(e.target.value)}\n                className=\"bg-[#141414] border border-[#333] text-xs font-mono rounded px-2.5 py-1 text-neutral-200 focus:outline-none\"\n              >\n                <option value=\"DGMS_Section_22_Notice\">DGMS Sec 22 Notice</option>\n                <option value=\"MoEFCC_EC_Clearance\">MoEFCC EC Clearance</option>\n                <option value=\"SPCB_Consent_Notice\">State PCB Show-Cause</option>\n              </select>\n            </div>\n\n            <textarea\n              rows={12}\n              value={sampleDocumentText}\n              onChange={(e) => setSampleDocumentText(e.target.value)}\n              placeholder=\"Paste raw text or uploaded statutory letter OCR stream...\"\n              className=\"w-full bg-[#070707] border border-[#222] rounded-lg p-3 text-xs font-mono text-neutral-300 leading-relaxed focus:outline-none focus:border-[#FF4D00]\"\n            />\n\n            <button\n              onClick={handleRunOcr}\n              disabled={isProcessingOcr}\n              className=\"w-full flex items-center justify-center space-x-2 bg-[#FF4D00] hover:bg-[#ff621e] text-black font-mono font-semibold py-2.5 rounded-lg text-xs transition-all cursor-pointer disabled:opacity-50\"\n            >\n              <Sparkles className=\"w-4 h-4\" />\n              <span>{isProcessingOcr ? \"Extracting Legal Covenants...\" : \"Run AI OCR & Clause Extraction\"}</span>\n            </button>\n          </div>\n\n          {/* Right: Extracted Structured Covenants */}\n          <div className=\"bg-[#0e0e0e] border border-[#222] rounded-xl p-5 shadow-lg flex flex-col justify-between\">\n            <div>\n              <div className=\"flex items-center justify-between pb-3 border-b border-[#222]\">\n                <h3 className=\"text-sm font-serif font-semibold text-white flex items-center gap-2\">\n                  <FileCheck2 className=\"w-4 h-4 text-[#FF4D00]\" />\n                  <span>Extracted Statutory Action Items</span>\n                </h3>\n                {ocrResult && (\n                  <span className=\"text-[10px] bg-red-500/15 text-red-400 border border-red-500/30 px-2 py-0.5 rounded font-mono font-bold uppercase\">\n                    {ocrResult.riskRating}\n                  </span>\n                )}\n              </div>\n\n              {ocrResult ? (\n                <div className=\"mt-4 space-y-3.5 text-xs\">\n                  <div className=\"bg-[#141414] p-3.5 rounded-lg border border-[#222] space-y-1.5 font-mono text-[11px]\">\n                    <div className=\"flex justify-between\">\n                      <span className=\"text-neutral-500\">Issuing Body:</span>\n                      <strong className=\"text-neutral-200\">{ocrResult.issuingAuthority}</strong>\n                    </div>\n                    <div className=\"flex justify-between\">\n                      <span className=\"text-neutral-500\">Notice Ref:</span>\n                      <strong className=\"text-[#FF4D00]\">{ocrResult.referenceNumber}</strong>\n                    </div>\n                    <div className=\"flex justify-between\">\n                      <span className=\"text-neutral-500\">Statutory Deadline:</span>\n                      <strong className=\"text-red-400 font-bold\">{ocrResult.statutoryDeadline}</strong>\n                    </div>\n                  </div>\n\n                  <div>\n                    <span className=\"text-xs font-mono text-neutral-400 uppercase tracking-wider block mb-1.5\">\n                      Statutory Non-Compliance Covenants:\n                    </span>\n                    <div className=\"space-y-2\">\n                      {ocrResult.covenants.map((cov, i) => (\n                        <div key={i} className=\"p-3 bg-[#121212] rounded-lg border border-[#222] text-[11px]\">\n                          <strong className=\"text-[#FF4D00] font-mono block\">{cov.clause}</strong>\n                          <span className=\"text-neutral-300 block mt-0.5\">{cov.requirement}</span>\n                          <span className=\"text-red-400 font-mono font-medium block mt-1\">Status: {cov.status}</span>\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n\n                  <div>\n                    <span className=\"text-xs font-mono text-neutral-400 uppercase tracking-wider block mb-1.5\">\n                      Auto-Assigned Action Items:\n                    </span>\n                    <div className=\"space-y-2\">\n                      {ocrResult.actionItems.map((act, i) => (\n                        <div key={i} className=\"p-3 bg-[#121212] rounded-lg border border-[#222] text-[11px] flex justify-between items-start\">\n                          <div>\n                            <strong className=\"text-neutral-200 block\">{act.task}</strong>\n                            <span className=\"text-neutral-500 block mt-0.5\">Assigned to: {act.assignedTo}</span>\n                          </div>\n                          <span className=\"text-red-400 font-mono font-bold shrink-0 ml-2\">Due: {act.targetDate}</span>\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n                </div>\n              ) : (\n                <div className=\"py-16 text-center text-neutral-500 space-y-2\">\n                  <Cpu className=\"w-8 h-8 mx-auto text-neutral-600\" />\n                  <p className=\"text-xs\">\n                    Click \"Run AI OCR\" to automatically parse statutory notice covenants, identify deadlines, and draft action items.\n                  </p>\n                </div>\n              )}\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Sub-tab 2: Risk Analytics */}\n      {activeSubTab === \"risk_engine\" && (\n        <div className=\"bg-[#0e0e0e] border border-[#222] rounded-xl p-6 shadow-lg space-y-5\">\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-[#222]\">\n            <div>\n              <h3 className=\"text-base font-serif font-semibold text-white flex items-center gap-2\">\n                <ShieldAlert className=\"w-5 h-5 text-[#FF4D00]\" />\n                <span>Predictive Hazard Matrix & Operational Risk Engine</span>\n              </h3>\n              <p className=\"text-xs text-neutral-400 mt-0.5\">\n                Correlating real-time slope radar, CH4/CO gas sensors, dust monitors, and contractor safety records.\n              </p>\n            </div>\n            <button\n              onClick={handleAnalyzeRisk}\n              disabled={isAnalyzingRisk}\n              className=\"flex items-center space-x-2 bg-[#FF4D00] hover:bg-[#ff621e] text-black font-mono font-semibold px-4 py-2 rounded-lg text-xs transition-all cursor-pointer disabled:opacity-50\"\n            >\n              <Sparkles className=\"w-4 h-4\" />\n              <span>{isAnalyzingRisk ? \"Computing Risk Vector...\" : \"Run AI Risk Engine\"}</span>\n            </button>\n          </div>\n\n          {riskAnalysis ? (\n            <div className=\"space-y-5 text-xs animate-in fade-in\">\n              <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                <div className=\"bg-[#141414] p-4 rounded-lg border border-[#222]\">\n                  <span className=\"text-neutral-400 block font-mono text-[11px]\">Calculated Risk Index</span>\n                  <div className=\"flex items-baseline space-x-2 mt-1\">\n                    <span className=\"text-3xl font-mono font-bold text-white\">{riskAnalysis.riskScore}</span>\n                    <span className=\"text-neutral-500 font-mono\">/ 100</span>\n                  </div>\n                  <span className=\"text-red-400 font-mono font-bold mt-1 block\">Level: {riskAnalysis.hazardLevel}</span>\n                </div>\n\n                <div className=\"bg-[#141414] p-4 rounded-lg border border-[#222] md:col-span-2\">\n                  <span className=\"text-neutral-400 block font-mono text-[11px]\">Executive Summary</span>\n                  <p className=\"text-neutral-200 mt-1 text-xs leading-relaxed\">{riskAnalysis.summary}</p>\n                </div>\n              </div>\n\n              <div>\n                <h4 className=\"text-xs font-mono text-neutral-400 uppercase tracking-wider mb-2\">\n                  Identified High-Risk Areas & Recommended Remediation:\n                </h4>\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                  {riskAnalysis.highRiskAreas?.map((item: any, idx: number) => (\n                    <div key={idx} className=\"bg-[#141414] p-4 rounded-lg border border-red-950/60 space-y-2\">\n                      <div className=\"flex justify-between items-center\">\n                        <strong className=\"text-neutral-200\">{item.area}</strong>\n                        <span className=\"text-[10px] bg-red-950 text-red-300 px-2 py-0.5 rounded font-mono font-bold\">\n                          {item.severity}\n                        </span>\n                      </div>\n                      <p className=\"text-[#FF4D00] text-[11px] font-semibold\">{item.hazard}</p>\n                      <p className=\"text-neutral-300 text-xs\">{item.recommendedAction}</p>\n                      <span className=\"text-[10px] font-mono text-neutral-500 block pt-1 border-t border-[#222]\">\n                        {item.statutoryReference}\n                      </span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            </div>\n          ) : (\n            <div className=\"text-center py-12 text-neutral-500 space-y-2\">\n              <Cpu className=\"w-8 h-8 mx-auto text-neutral-600\" />\n              <p className=\"text-xs\">Click \"Run AI Risk Engine\" to calculate real-time hazard vectors for {selectedMine.name}.</p>\n            </div>\n          )}\n        </div>\n      )}\n\n      {/* Sub-tab 3: ATR Generator */}\n      {activeSubTab === \"atr_generator\" && (\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n          {/* Input Form */}\n          <div className=\"bg-[#0e0e0e] border border-[#222] rounded-xl p-5 shadow-lg space-y-4\">\n            <h3 className=\"text-sm font-serif font-semibold text-white flex items-center gap-2 pb-3 border-b border-[#222]\">\n              <FileCheck2 className=\"w-4 h-4 text-[#FF4D00]\" />\n              <span>Action Taken Report (ATR) Generator</span>\n            </h3>\n\n            <div className=\"text-xs space-y-3\">\n              <div>\n                <label className=\"block text-neutral-400 mb-1 font-mono text-[11px]\">Violation Notice Reference</label>\n                <input\n                  type=\"text\"\n                  value={atrForm.violationRef}\n                  onChange={(e) => setAtrForm({ ...atrForm, violationRef: e.target.value })}\n                  className=\"w-full bg-[#070707] border border-[#222] rounded-lg px-3 py-2 text-neutral-100 font-mono text-xs focus:outline-none focus:border-[#FF4D00]\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-neutral-400 mb-1 font-mono text-[11px]\">Original Statutory Observations</label>\n                <textarea\n                  rows={3}\n                  value={atrForm.observations}\n                  onChange={(e) => setAtrForm({ ...atrForm, observations: e.target.value })}\n                  className=\"w-full bg-[#070707] border border-[#222] rounded-lg p-3 text-neutral-200 text-xs focus:outline-none focus:border-[#FF4D00]\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-neutral-400 mb-1 font-mono text-[11px]\">Physical Corrective Measures Executed</label>\n                <textarea\n                  rows={4}\n                  value={atrForm.actionsTaken}\n                  onChange={(e) => setAtrForm({ ...atrForm, actionsTaken: e.target.value })}\n                  className=\"w-full bg-[#070707] border border-[#222] rounded-lg p-3 text-neutral-200 text-xs focus:outline-none focus:border-[#FF4D00]\"\n                />\n              </div>\n\n              <button\n                onClick={handleGenerateAtr}\n                disabled={isGeneratingAtr}\n                className=\"w-full flex items-center justify-center space-x-2 bg-[#FF4D00] hover:bg-[#ff621e] text-black font-mono font-semibold py-2.5 rounded-lg text-xs transition-all cursor-pointer disabled:opacity-50\"\n              >\n                <Sparkles className=\"w-4 h-4\" />\n                <span>{isGeneratingAtr ? \"Drafting Statutory ATR...\" : \"Auto-Draft Legal Action Taken Report\"}</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Generated ATR Output */}\n          <div className=\"bg-[#0e0e0e] border border-[#222] rounded-xl p-5 shadow-lg flex flex-col justify-between\">\n            <div>\n              <h3 className=\"text-sm font-serif font-semibold text-white flex items-center gap-2 pb-3 border-b border-[#222]\">\n                <FileText className=\"w-4 h-4 text-[#FF4D00]\" />\n                <span>Certified DGMS Action Taken Report</span>\n              </h3>\n\n              {generatedAtr ? (\n                <div className=\"mt-4 space-y-3.5 text-xs animate-in fade-in\">\n                  <div className=\"bg-[#141414] p-4 rounded-lg border border-[#222] space-y-2\">\n                    <h4 className=\"font-serif font-semibold text-neutral-100 text-sm\">{generatedAtr.title}</h4>\n                    <span className=\"text-neutral-500 font-mono text-[11px] block\">{generatedAtr.refNumber}</span>\n                    <p className=\"text-neutral-300 leading-relaxed text-xs\">{generatedAtr.executiveSummary}</p>\n                  </div>\n\n                  <div>\n                    <strong className=\"text-neutral-300 font-mono text-xs block mb-1\">Covenants Verified Complied:</strong>\n                    <ul className=\"list-disc list-inside text-neutral-400 space-y-1 text-[11px]\">\n                      {generatedAtr.statutoryProvisionsComplied?.map((p: string, i: number) => (\n                        <li key={i} className=\"text-neutral-300\">{p}</li>\n                      ))}\n                    </ul>\n                  </div>\n\n                  <div className=\"p-3 bg-emerald-950/30 border border-emerald-800/40 rounded-lg text-[11px] text-emerald-300 font-mono\">\n                    <strong className=\"block mb-1 uppercase text-[10px] text-emerald-400\">Mines Manager Statutory Declaration (Sec 17):</strong>\n                    <span>{generatedAtr.managerDeclaration}</span>\n                  </div>\n                </div>\n              ) : (\n                <div className=\"py-16 text-center text-neutral-500 space-y-2\">\n                  <FileText className=\"w-8 h-8 mx-auto text-neutral-600\" />\n                  <p className=\"text-xs\">Click \"Auto-Draft Legal Action Taken Report\" to produce formatted statutory submissions.</p>\n                </div>\n              )}\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Sub-tab 4: CMR Copilot */}\n      {activeSubTab === \"copilot\" && (\n        <div className=\"bg-[#0e0e0e] border border-[#222] rounded-xl p-5 shadow-lg flex flex-col h-[520px]\">\n          <div className=\"pb-3 border-b border-[#222] flex items-center justify-between\">\n            <div className=\"flex items-center space-x-2\">\n              <Bot className=\"w-5 h-5 text-[#FF4D00]\" />\n              <h3 className=\"text-sm font-serif font-semibold text-white\">\n                KhananDrishti Statutory Mining Copilot (CMR 2017 & Mines Act 1952)\n              </h3>\n            </div>\n            <span className=\"text-[10px] font-mono text-neutral-400\">Interactive Legal Counsel</span>\n          </div>\n\n          {/* Chat Messages Log */}\n          <div className=\"flex-1 overflow-y-auto p-3 space-y-3.5 my-3 bg-[#070707] rounded-lg border border-[#222]\">\n            {chatMessages.map((msg, idx) => (\n              <div\n                key={idx}\n                className={`flex ${msg.role === \"user\" ? \"justify-end\" : \"justify-start\"}`}\n              >\n                <div\n                  className={`max-w-[85%] p-3.5 rounded-xl text-xs leading-relaxed ${\n                    msg.role === \"user\"\n                      ? \"bg-[#FF4D00] text-black font-medium\"\n                      : \"bg-[#141414] text-neutral-200 border border-[#262626] shadow-sm\"\n                  }`}\n                >\n                  <p className=\"whitespace-pre-line\">{msg.content}</p>\n                  <span\n                    className={`block text-[9px] font-mono mt-1.5 ${\n                      msg.role === \"user\" ? \"text-black/70\" : \"text-neutral-500\"\n                    }`}\n                  >\n                    {msg.timestamp}\n                  </span>\n                </div>\n              </div>\n            ))}\n            {isAiReplying && (\n              <div className=\"flex justify-start\">\n                <div className=\"bg-[#141414] border border-[#262626] p-3 rounded-lg text-xs text-[#FF4D00] flex items-center space-x-2 font-mono\">\n                  <Sparkles className=\"w-3.5 h-3.5 animate-spin\" />\n                  <span>Consulting Coal Mines Regulations 2017 database...</span>\n                </div>\n              </div>\n            )}\n          </div>\n\n          {/* Input Bar */}\n          <form onSubmit={handleSendChat} className=\"flex items-center space-x-2\">\n            <input\n              type=\"text\"\n              value={userInput}\n              onChange={(e) => setUserInput(e.target.value)}\n              placeholder=\"Ask anything on DGMS circulars, haul road slope, methane limits, or Form-B requirements...\"\n              className=\"flex-1 bg-[#070707] border border-[#222] rounded-lg px-4 py-2.5 text-xs text-neutral-100 focus:outline-none focus:border-[#FF4D00]\"\n            />\n            <button\n              type=\"submit\"\n              disabled={isAiReplying || !userInput.trim()}\n              className=\"p-2.5 bg-[#FF4D00] hover:bg-[#ff621e] text-black rounded-lg font-bold transition-all disabled:opacity-50 cursor-pointer\"\n            >\n              <Send className=\"w-4 h-4\" />\n            </button>\n          </form>\n        </div>\n      )}\n    </div>"
    }
