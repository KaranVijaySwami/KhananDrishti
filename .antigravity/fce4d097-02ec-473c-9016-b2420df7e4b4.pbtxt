  file_change {
    absolute_path_uri: "file:///src/components/StatutoryRegisters.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { MineSite, StatutoryRegisterFormB } from \"../types\";\nimport { STATUTORY_FORM_B_DATA } from \"../data/mockData\";\nimport {\n  FileText,\n  CheckCircle2,\n  AlertTriangle,\n  Award,\n  Download,\n  Users,\n  Building,\n  ShieldCheck,\n  Calendar,\n  Layers,\n  Leaf,\n  Droplets,\n  HardHat,\n  Search,\n} from \"lucide-react\";\n\ninterface StatutoryRegistersProps {\n  selectedMine: MineSite;\n}\n\nexport const StatutoryRegisters: React.FC<StatutoryRegistersProps> = ({\n  selectedMine,\n}) => {\n  const [activeRegister, setActiveRegister] = useState<\n    \"form_b\" | \"form_iv\" | \"form_ix\" | \"moefcc_enviro\" | \"star_rating\"\n  >(\"form_b\");\n\n  const [searchQuery, setSearchQuery] = useState<string>(\"\");\n\n  // Star Rating Evaluation Modules\n  const [starRatingScores, setStarRatingScores] = useState({\n    miningOps: 94,\n    environmentProtection: 88,\n    safetyHealth: 92,\n    rehabilitationResettlement: 85,\n    carbonCleanEnergy: 80,\n    welfareAadhaar: 96,\n    statutoryFiling: 98,\n  });\n\n  const overallStarScore = Math.round(\n    Object.values(starRatingScores).reduce((a, b) => a + b, 0) / 7\n  );\n\n  const starRatingLevel =\n    overallStarScore >= 90 ? 5 : overallStarScore >= 80 ? 4 : overallStarScore >= 70 ? 3 : 2;\n\n  const filteredFormB = STATUTORY_FORM_B_DATA.filter(\n    (w) =>\n      w.name.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      w.workerId.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      w.category.toLowerCase().includes(searchQuery.toLowerCase())\n  );\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Top Banner */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n        <div className=\"flex items-center space-x-3.5\">\n          <div className=\"p-3 bg-amber-500/10 border border-amber-500/30 rounded-xl text-amber-400\">\n            <FileText className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"text-xs font-bold uppercase tracking-wider text-amber-400\">\n                Paperless Statutory Mining Governance\n              </span>\n              <span className=\"text-[10px] bg-amber-500/20 text-amber-300 border border-amber-500/30 px-2 py-0.2 rounded font-mono\">\n                Mines Act 1952 / CMR 2017\n              </span>\n            </div>\n            <h2 className=\"text-lg font-bold text-white mt-0.5\">\n              Digital Statutory Registers & Ministry Returns\n            </h2>\n            <p className=\"text-xs text-slate-400\">\n              Mandatory digital logs replacing physical leather-bound colliery ledgers with cryptographic auditability.\n            </p>\n          </div>\n        </div>\n\n        {/* Export / Download Button */}\n        <button\n          onClick={() => {\n            alert(\n              `Statutory Digital Register (${activeRegister.toUpperCase()}) compiled for ${selectedMine.name}. Signed with Digital Key.`\n            );\n          }}\n          className=\"flex items-center space-x-2 bg-slate-800 hover:bg-slate-700 text-amber-300 border border-slate-700 px-4 py-2 rounded-xl text-xs font-semibold shadow-sm transition-all\"\n        >\n          <Download className=\"w-4 h-4 text-amber-400\" />\n          <span>Export DGMS Form PDF</span>\n        </button>\n      </div>\n\n      {/* Tab Selector */}\n      <div className=\"flex items-center space-x-2 border-b border-slate-800 pb-2 overflow-x-auto text-xs scrollbar-none\">\n        {[\n          { id: \"form_b\", label: \"Form B (Worker & PME Register)\", icon: Users },\n          { id: \"form_iv\", label: \"Form IV (Accidents & Dangerous Occurrences)\", icon: HardHat },\n          { id: \"form_ix\", label: \"Form IX (Statutory Inspection Register)\", icon: ShieldCheck },\n          { id: \"moefcc_enviro\", label: \"MoEFCC Half-Yearly Environmental ATR\", icon: Leaf },\n          { id: \"star_rating\", label: \"Ministry 5-Star Rating Self-Evaluation\", icon: Award },\n        ].map((tab) => {\n          const Icon = tab.icon;\n          const isActive = activeRegister === tab.id;\n          return (\n            <button\n              key={tab.id}\n              onClick={() => setActiveRegister(tab.id as any)}\n              className={`flex items-center space-x-2 px-4 py-2.5 rounded-xl font-semibold whitespace-nowrap transition-all ${\n                isActive\n                  ? \"bg-amber-500 text-slate-950 shadow-md shadow-amber-500/20\"\n                  : \"text-slate-400 hover:text-slate-200 hover:bg-slate-800/60\"\n              }`}\n            >\n              <Icon className=\"w-4 h-4\" />\n              <span>{tab.label}</span>\n            </button>\n          );\n        })}\n      </div>\n\n      {/* Dynamic Content Views */}\n      {activeRegister === \"form_b\" && (\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-4\">\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-800\">\n            <div>\n              <h3 className=\"text-base font-bold text-white flex items-center gap-2\">\n                <Users className=\"w-4 h-4 text-amber-400\" />\n                <span>Form B: Digital Register of Mine Employees & Contractor Labour</span>\n              </h3>\n              <p className=\"text-xs text-slate-400\">\n                Rule 48 & 77 of Mines Rules 1955. Real-time verification of PME medical validity, VTC safety certificates, and biometric entry authorization.\n              </p>\n            </div>\n\n            {/* Search Input */}\n            <div className=\"relative\">\n              <Search className=\"w-4 h-4 absolute left-3 top-2.5 text-slate-400\" />\n              <input\n                type=\"text\"\n                placeholder=\"Search worker by name, ID or trade...\"\n                value={searchQuery}\n                onChange={(e) => setSearchQuery(e.target.value)}\n                className=\"bg-slate-950 border border-slate-700 rounded-xl pl-9 pr-3 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-amber-500 w-64\"\n              />\n            </div>\n          </div>\n\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left text-xs\">\n              <thead>\n                <tr className=\"text-slate-400 border-b border-slate-800\">\n                  <th className=\"pb-3 font-semibold\">Worker ID</th>\n                  <th className=\"pb-3 font-semibold\">Full Name</th>\n                  <th className=\"pb-3 font-semibold\">Category / Trade</th>\n                  <th className=\"pb-3 font-semibold\">Contractor Agency</th>\n                  <th className=\"pb-3 font-semibold\">Aadhaar (Masked)</th>\n                  <th className=\"pb-3 font-semibold\">PME Validity</th>\n                  <th className=\"pb-3 font-semibold\">VTC Safety Cert</th>\n                  <th className=\"pb-3 font-semibold\">Gate Status</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-800/60\">\n                {filteredFormB.map((w) => (\n                  <tr key={w.workerId} className=\"hover:bg-slate-800/40\">\n                    <td className=\"py-3 font-mono font-bold text-amber-400\">{w.workerId}</td>\n                    <td className=\"py-3 font-medium text-slate-100\">{w.name}</td>\n                    <td className=\"py-3 text-slate-300\">{w.category.replace(\"_\", \" \")}</td>\n                    <td className=\"py-3 text-slate-400\">{w.contractorName}</td>\n                    <td className=\"py-3 font-mono text-slate-500\">{w.aadhaarMasked}</td>\n                    <td className=\"py-3\">\n                      <span\n                        className={`px-2 py-0.5 rounded text-[11px] font-bold ${\n                          w.status === \"PME_Overdue_Blocked\"\n                            ? \"bg-red-950 text-red-300 border border-red-800\"\n                            : \"bg-slate-950 text-slate-300\"\n                        }`}\n                      >\n                        Due: {w.pmeNextDue}\n                      </span>\n                    </td>\n                    <td className=\"py-3 font-mono text-[11px] text-slate-400\">{w.vtcCertificateNo}</td>\n                    <td className=\"py-3\">\n                      <span\n                        className={`px-2 py-0.5 rounded text-[10px] font-bold uppercase ${\n                          w.status === \"Active_Authorized\"\n                            ? \"bg-emerald-500/20 text-emerald-300 border border-emerald-500/30\"\n                            : \"bg-red-500/20 text-red-300 border border-red-500/30 animate-pulse\"\n                        }`}\n                      >\n                        {w.status === \"Active_Authorized\" ? \"Authorized\" : \"Blocked (PME Expired)\"}\n                      </span>\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        </div>\n      )}\n\n      {activeRegister === \"form_iv\" && (\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-4\">\n          <div className=\"flex items-center justify-between pb-3 border-b border-slate-800\">\n            <div>\n              <h3 className=\"text-base font-bold text-white flex items-center gap-2\">\n                <HardHat className=\"w-4 h-4 text-amber-400\" />\n                <span>Form IV: Register of Accidents, Dangerous Occurrences & Near Misses</span>\n              </h3>\n              <p className=\"text-xs text-slate-400\">\n                Coal Mines Regulations 2017 (CMR 2017) Regulation 8 & 9. Statutory notification within 24 hours to DGMS.\n              </p>\n            </div>\n            <span className=\"px-2.5 py-1 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-xs font-bold\">\n              Zero Fatalities Recorded in 2026\n            </span>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 text-xs\">\n            <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2\">\n              <div className=\"flex justify-between items-center\">\n                <span className=\"font-mono text-amber-400 font-bold\">INC-2026-081</span>\n                <span className=\"text-[10px] bg-amber-500/20 text-amber-300 px-2 py-0.5 rounded font-bold\">\n                  Near Miss / Machinery\n                </span>\n              </div>\n              <p className=\"text-slate-200 font-semibold\">\n                Dumper CAT-793 (Fleet #12) retarder brake high-temperature warning during downhill descent on Ramp 2.\n              </p>\n              <p className=\"text-slate-400\">\n                Corrective Action: Automatic retarder pressure valve recalibrated; operator completed 4-hr simulator refresh.\n              </p>\n              <div className=\"pt-2 border-t border-slate-800 flex justify-between text-[11px] text-slate-500\">\n                <span>Date: 2026-08-14</span>\n                <span>Investigated by: Er. Rajesh Verma</span>\n              </div>\n            </div>\n\n            <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2\">\n              <div className=\"flex justify-between items-center\">\n                <span className=\"font-mono text-amber-400 font-bold\">INC-2026-074</span>\n                <span className=\"text-[10px] bg-blue-500/20 text-blue-300 px-2 py-0.5 rounded font-bold\">\n                  Minor Injury (First Aid)\n                </span>\n              </div>\n              <p className=\"text-slate-200 font-semibold\">\n                Contractor mechanic sustained minor hand laceration while replacing hydraulic hose on Shovel #3.\n              </p>\n              <p className=\"text-slate-400\">\n                Corrective Action: Lockout/Tagout (LOTO) and Kevlar cut-resistant gloves re-briefed to contractor crew.\n              </p>\n              <div className=\"pt-2 border-t border-slate-800 flex justify-between text-[11px] text-slate-500\">\n                <span>Date: 2026-08-02</span>\n                <span>Lost Time Injury (LTI): 0 Days</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {activeRegister === \"form_ix\" && (\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-4\">\n          <div className=\"pb-3 border-b border-slate-800\">\n            <h3 className=\"text-base font-bold text-white flex items-center gap-2\">\n              <ShieldCheck className=\"w-4 h-4 text-amber-400\" />\n              <span>Form IX: Statutory Register of Inspections & Auditor Entries</span>\n            </h3>\n            <p className=\"text-xs text-slate-400\">\n              Coal Mines Regulations 2017. Section 22 notices, Safety Committee minutes, and Workmen Inspector logs.\n            </p>\n          </div>\n\n          <div className=\"space-y-3 text-xs\">\n            <div className=\"p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-2\">\n              <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n                <span className=\"font-bold text-slate-200\">\n                  Statutory Visit by Dy. Director of Mines Safety (DGMS South Eastern Zone)\n                </span>\n                <span className=\"text-slate-500 font-mono text-[11px]\">Date: 2026-08-20</span>\n              </div>\n              <p className=\"text-slate-300 leading-relaxed\">\n                \"Inspected South-West Bench 14 and East Overburden Dump. Slope monitoring radar found operational. Recommended periodic cleaning of drainage trenches along Toe of Bench 12 before upcoming monsoon cycle.\"\n              </p>\n              <div className=\"pt-2 border-t border-slate-800 flex justify-between text-[11px] text-slate-400\">\n                <span>Signed: Er. S. Bhattacharya (DDMS)</span>\n                <span className=\"text-emerald-400 font-semibold\">Counter-signed by Mines Manager</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {activeRegister === \"moefcc_enviro\" && (\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-4\">\n          <div className=\"pb-3 border-b border-slate-800\">\n            <h3 className=\"text-base font-bold text-white flex items-center gap-2\">\n              <Leaf className=\"w-4 h-4 text-emerald-400\" />\n              <span>MoEFCC Environmental Clearance (EC) & Green Audit Compliance</span>\n            </h3>\n            <p className=\"text-xs text-slate-400\">\n              Compliance monitoring against Environmental Clearance terms, Air & Water Acts, and Progressive Mine Closure Plan (PMCP).\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-xs\">\n            <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2\">\n              <span className=\"text-slate-400 font-semibold block\">Green Belt Afforestation</span>\n              <div className=\"flex items-baseline space-x-2\">\n                <span className=\"text-2xl font-bold text-emerald-400\">88.4%</span>\n                <span className=\"text-slate-500\">Survival Rate</span>\n              </div>\n              <p className=\"text-slate-300\">\n                142,000 native saplings planted in FY2025-26 over 70 hectares of reclaimed OB dump.\n              </p>\n            </div>\n\n            <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2\">\n              <span className=\"text-slate-400 font-semibold block\">Mine Closure Escrow Account</span>\n              <div className=\"flex items-baseline space-x-2\">\n                <span className=\"text-2xl font-bold text-amber-400\">\342\202\271412.8 Cr</span>\n                <span className=\"text-slate-500\">Deposited</span>\n              </div>\n              <p className=\"text-slate-300\">\n                Annual deposit verified with Coal Controller Organization (CCO) & State Bank of India.\n              </p>\n            </div>\n\n            <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2\">\n              <span className=\"text-slate-400 font-semibold block\">Dust Suppression System</span>\n              <div className=\"flex items-baseline space-x-2\">\n                <span className=\"text-2xl font-bold text-blue-400\">100%</span>\n                <span className=\"text-slate-500\">Operational</span>\n              </div>\n              <p className=\"text-slate-300\">\n                18 fixed mist cannons + 8 pressurized mobile bowsers covering 18.5 km transport haul network.\n              </p>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {activeRegister === \"star_rating\" && (\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-5\">\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-800\">\n            <div>\n              <h3 className=\"text-base font-bold text-white flex items-center gap-2\">\n                <Award className=\"w-4 h-4 text-amber-400\" />\n                <span>Ministry of Coal Star Rating Self-Evaluation Matrix (50 Parameters)</span>\n              </h3>\n              <p className=\"text-xs text-slate-400\">\n                Evaluation under 7 modules: Mining Ops, Environmental Protection, Health & Safety, R&R, Welfare, Carbon Footprint.\n              </p>\n            </div>\n\n            <div className=\"flex items-center space-x-2 bg-slate-950 px-4 py-2 rounded-xl border border-slate-800\">\n              <span className=\"text-xs text-slate-400\">Assessed Star Rating:</span>\n              <div className=\"flex items-center text-amber-400\">\n                {Array.from({ length: starRatingLevel }).map((_, i) => (\n                  <Award key={i} className=\"w-4 h-4 fill-amber-400\" />\n                ))}\n              </div>\n              <span className=\"text-sm font-black text-amber-300\">\n                ({overallStarScore}% - {starRatingLevel} Star)\n              </span>\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 text-xs\">\n            {Object.entries(starRatingScores).map(([moduleName, score]) => (\n              <div key={moduleName} className=\"bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2\">\n                <div className=\"flex justify-between items-center\">\n                  <span className=\"font-semibold text-slate-200 capitalize\">\n                    {moduleName.replace(/([A-Z])/g, \" $1\")}\n                  </span>\n                  <span className=\"font-bold text-amber-400\">{score} / 100</span>\n                </div>\n                <div className=\"w-full bg-slate-900 h-2 rounded-full overflow-hidden\">\n                  <div\n                    className=\"bg-gradient-to-r from-amber-500 to-emerald-400 h-full rounded-full\"\n                    style={{ width: `${score}%` }}\n                  />\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
