    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { ContractorRecord, MineSite } from \"../types\";\nimport { CONTRACTOR_REGISTRY } from \"../data/mockData\";\nimport {\n  Users,\n  ShieldCheck,\n  AlertTriangle,\n  HardHat,\n  Truck,\n  CheckCircle2,\n  Lock,\n  Phone,\n  FileCheck,\n  Search,\n  Filter,\n} from \"lucide-react\";\n\ninterface ContractorPortalProps {\n  selectedMine: MineSite;\n}\n\nexport const ContractorPortal: React.FC<ContractorPortalProps> = ({\n  selectedMine,\n}) => {\n  const [contractors, setContractors] = useState<ContractorRecord[]>(CONTRACTOR_REGISTRY);\n  const [search, setSearch] = useState<string>(\"\");\n  const [selectedContractor, setSelectedContractor] = useState<ContractorRecord | null>(\n    CONTRACTOR_REGISTRY[0]\n  );\n\n  const filtered = contractors.filter(\n    (c) =>\n      c.contractorName.toLowerCase().includes(search.toLowerCase()) ||\n      c.contractCode.toLowerCase().includes(search.toLowerCase())\n  );\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Top Banner */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n        <div className=\"flex items-center space-x-3.5\">\n          <div className=\"p-3 bg-amber-500/10 border border-amber-500/30 rounded-xl text-amber-400\">\n            <Users className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"text-xs font-bold uppercase tracking-wider text-amber-400\">\n                Contract Labour & Safety Governance\n              </span>\n              <span className=\"text-[10px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2 py-0.2 rounded font-mono\">\n                CLRA Act 1970 & Mines Rules 1955\n              </span>\n            </div>\n            <h2 className=\"text-lg font-bold text-white mt-0.5\">\n              Contractor Safety Scorecards & Gate Authorization\n            </h2>\n            <p className=\"text-xs text-slate-400\">\n              Biometric gate-pass control, Periodic Medical Examination (PME) tracking, and HEMM machine safety certification.\n            </p>\n          </div>\n        </div>\n\n        <div className=\"flex items-center space-x-2 bg-slate-950 p-2 rounded-xl border border-slate-800 text-xs\">\n          <ShieldCheck className=\"w-4 h-4 text-emerald-400\" />\n          <span className=\"text-slate-300\">Total Active Contractor Workforce: <strong>1,900 Personnel</strong></span>\n        </div>\n      </div>\n\n      {/* Main Grid: Contractor List & Detailed Scorecard */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Left Col: Contractor List */}\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-4\">\n          <div className=\"flex items-center justify-between pb-3 border-b border-slate-800\">\n            <h3 className=\"text-sm font-bold text-white\">Registered Contractor Agencies</h3>\n            <span className=\"text-xs text-amber-400 font-bold\">{filtered.length} Agencies</span>\n          </div>\n\n          <div className=\"relative\">\n            <Search className=\"w-4 h-4 absolute left-3 top-2.5 text-slate-400\" />\n            <input\n              type=\"text\"\n              placeholder=\"Search contractor or contract code...\"\n              value={search}\n              onChange={(e) => setSearch(e.target.value)}\n              className=\"w-full bg-slate-950 border border-slate-800 rounded-xl pl-9 pr-3 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-amber-500\"\n            />\n          </div>\n\n          <div className=\"space-y-3\">\n            {filtered.map((c) => {\n              const isSelected = selectedContractor?.id === c.id;\n              return (\n                <div\n                  key={c.id}\n                  onClick={() => setSelectedContractor(c)}\n                  className={`p-3.5 rounded-xl border cursor-pointer transition-all ${\n                    isSelected\n                      ? \"bg-amber-500/10 border-amber-500/50 shadow\"\n                      : \"bg-slate-950/70 border-slate-800 hover:border-slate-700\"\n                  }`}\n                >\n                  <div className=\"flex justify-between items-start\">\n                    <span className=\"font-bold text-slate-100 text-xs truncate max-w-[190px]\">\n                      {c.contractorName}\n                    </span>\n                    <span\n                      className={`px-2 py-0.5 rounded text-[10px] font-bold uppercase ${\n                        c.status === \"Compliant\"\n                          ? \"bg-emerald-500/20 text-emerald-300 border border-emerald-500/30\"\n                          : \"bg-red-500/20 text-red-300 border border-red-500/30\"\n                      }`}\n                    >\n                      {c.status.replace(\"_\", \" \")}\n                    </span>\n                  </div>\n\n                  <span className=\"text-[11px] font-mono text-slate-400 block mt-1\">\n                    {c.contractCode}\n                  </span>\n\n                  <div className=\"mt-2.5 flex items-center justify-between text-xs pt-2 border-t border-slate-800/80\">\n                    <span className=\"text-slate-400\">{c.totalWorkers} Workers</span>\n                    <span className=\"text-amber-400 font-semibold\">\n                      Safety Score: {c.safetyInductionScore}%\n                    </span>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Right 2 Cols: Detailed Contractor Profile & Safety Compliance */}\n        {selectedContractor && (\n          <div className=\"lg:col-span-2 bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-lg space-y-6\">\n            <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-800\">\n              <div>\n                <span className=\"text-[11px] font-mono text-amber-400 font-bold block\">\n                  {selectedContractor.contractCode}\n                </span>\n                <h3 className=\"text-lg font-bold text-white mt-0.5\">\n                  {selectedContractor.contractorName}\n                </h3>\n                <p className=\"text-xs text-slate-400\">\n                  Supervisor: {selectedContractor.supervisorName} \342\200\242 Contact: {selectedContractor.contactNumber}\n                </p>\n              </div>\n\n              <div className=\"flex items-center space-x-2\">\n                <span\n                  className={`px-3 py-1 rounded-lg text-xs font-bold ${\n                    selectedContractor.status === \"Compliant\"\n                      ? \"bg-emerald-950 text-emerald-300 border border-emerald-800\"\n                      : \"bg-red-950 text-red-300 border border-red-800 animate-pulse\"\n                  }`}\n                >\n                  {selectedContractor.status === \"Compliant\"\n                    ? \"Gate Authorized\"\n                    : \"Warning: High Risk Lapses\"}\n                </span>\n              </div>\n            </div>\n\n            {/* 4 Compliance Meters */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs\">\n              <div className=\"bg-slate-950 p-3.5 rounded-xl border border-slate-800\">\n                <span className=\"text-slate-400 block text-[11px]\">Form-B Compliance</span>\n                <span className=\"text-2xl font-bold text-slate-100 mt-1 block\">\n                  {selectedContractor.formBCompliantPct}%\n                </span>\n                <span className=\"text-emerald-400 text-[11px]\">Aadhaar/KYC Verified</span>\n              </div>\n\n              <div className=\"bg-slate-950 p-3.5 rounded-xl border border-slate-800\">\n                <span className=\"text-slate-400 block text-[11px]\">PME Medical Valid</span>\n                <span className=\"text-2xl font-bold text-amber-400 mt-1 block\">\n                  {selectedContractor.pmeValidPct}%\n                </span>\n                <span className=\"text-slate-400 text-[11px]\">Periodic Health Check</span>\n              </div>\n\n              <div className=\"bg-slate-950 p-3.5 rounded-xl border border-slate-800\">\n                <span className=\"text-slate-400 block text-[11px]\">VTC Training Cert</span>\n                <span className=\"text-2xl font-bold text-blue-400 mt-1 block\">\n                  {selectedContractor.vtcCertifiedPct}%\n                </span>\n                <span className=\"text-slate-400 text-[11px]\">Vocational Centre</span>\n              </div>\n\n              <div className=\"bg-slate-950 p-3.5 rounded-xl border border-slate-800\">\n                <span className=\"text-slate-400 block text-[11px]\">Active Machinery</span>\n                <span className=\"text-2xl font-bold text-purple-400 mt-1 block\">\n                  {selectedContractor.activeMachineryCount} Units\n                </span>\n                <span className=\"text-slate-400 text-[11px]\">AFDSS Fitted</span>\n              </div>\n            </div>\n\n            {/* Gate Pass Enforcement Widget */}\n            <div className=\"p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-3\">\n              <h4 className=\"text-xs font-bold uppercase tracking-wider text-slate-300 flex items-center gap-2\">\n                <Lock className=\"w-4 h-4 text-amber-400\" />\n                <span>Biometric Turnstile Gate-Pass Automation</span>\n              </h4>\n              <p className=\"text-xs text-slate-400 leading-relaxed\">\n                If a worker\'s Periodic Medical Examination (PME) expires or safety induction is incomplete, their RFID turnstile gate access is automatically blocked at the colliery security entry gate.\n              </p>\n              <div className=\"flex flex-wrap items-center gap-2 pt-2 text-xs\">\n                <span className=\"px-2.5 py-1 bg-emerald-950 text-emerald-300 rounded border border-emerald-800 font-semibold\">\n                  \342\234\223 100% EPF/ESIC Remittance Verified\n                </span>\n                <span className=\"px-2.5 py-1 bg-emerald-950 text-emerald-300 rounded border border-emerald-800 font-semibold\">\n                  \342\234\223 Minimum Wage Bank Credit Verified\n                </span>\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
