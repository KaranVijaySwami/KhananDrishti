  file_change {
    absolute_path_uri: "file:///src/components/GisMineMap.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { MineSite, StatutoryViolation, InspectionRecord } from \"../types\";\nimport {\n  MapPin,\n  Layers,\n  Flame,\n  Radio,\n  Eye,\n  AlertTriangle,\n  Compass,\n  Maximize2,\n  Navigation,\n  Wind,\n  Droplets,\n  Truck,\n  ShieldAlert,\n  Info,\n} from \"lucide-react\";\n\ninterface GisMineMapProps {\n  selectedMine: MineSite;\n  violations: StatutoryViolation[];\n  inspections: InspectionRecord[];\n  onInspectViolation?: (violation: StatutoryViolation) => void;\n}\n\nexport const GisMineMap: React.FC<GisMineMapProps> = ({\n  selectedMine,\n  violations,\n  inspections,\n}) => {\n  const [activeLayers, setActiveLayers] = useState<{\n    pitBoundary: boolean;\n    slopeStability: boolean;\n    haulRoads: boolean;\n    environmentalSensors: boolean;\n    blastingRadius: boolean;\n    inspectionPins: boolean;\n  }>({\n    pitBoundary: true,\n    slopeStability: true,\n    haulRoads: true,\n    environmentalSensors: true,\n    blastingRadius: true,\n    inspectionPins: true,\n  });\n\n  const [selectedPin, setSelectedPin] = useState<{\n    type: \"violation\" | \"inspection\" | \"sensor\";\n    data: any;\n  } | null>(null);\n\n  const mineViolations = violations.filter((v) => v.mineId === selectedMine.id);\n  const mineInspections = inspections.filter((i) => i.mineId === selectedMine.id);\n\n  const toggleLayer = (layerKey: keyof typeof activeLayers) => {\n    setActiveLayers((prev) => ({ ...prev, [layerKey]: !prev[layerKey] }));\n  };\n\n  const isUnderground = selectedMine.type === \"Underground\";\n\n  return (\n    <div className=\"space-y-4\">\n      {/* Top Map Control Bar */}\n      <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-4 flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center space-x-2\">\n            <span className=\"text-xs font-bold uppercase tracking-wider text-amber-400\">\n              DGMS GIS Spatial Cadastral Map\n            </span>\n            <span className=\"text-[10px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2 py-0.2 rounded font-mono\">\n              WGS84 \342\200\242 EPSG:4326\n            </span>\n          </div>\n          <h2 className=\"text-lg font-bold text-white mt-0.5\">\n            {selectedMine.name} \342\200\224 Spatial Mine Layout & Geo-Tagged Hazards\n          </h2>\n          <p className=\"text-xs text-slate-400\">\n            Coordinates: {selectedMine.lat.toFixed(4)}\302\260 N, {selectedMine.lng.toFixed(4)}\302\260 E \342\200\242 Seam Formations: {selectedMine.type}\n          </p>\n        </div>\n\n        {/* Layer Toggle Badges */}\n        <div className=\"flex flex-wrap items-center gap-1.5 text-xs\">\n          <button\n            onClick={() => toggleLayer(\"pitBoundary\")}\n            className={`px-3 py-1.5 rounded-lg border font-medium transition-all ${\n              activeLayers.pitBoundary\n                ? \"bg-amber-500/20 border-amber-500/50 text-amber-300\"\n                : \"bg-slate-950 border-slate-800 text-slate-500\"\n            }`}\n          >\n            Lease Boundary\n          </button>\n          <button\n            onClick={() => toggleLayer(\"slopeStability\")}\n            className={`px-3 py-1.5 rounded-lg border font-medium transition-all ${\n              activeLayers.slopeStability\n                ? \"bg-red-500/20 border-red-500/50 text-red-300\"\n                : \"bg-slate-950 border-slate-800 text-slate-500\"\n            }`}\n          >\n            Slope Radar / Dumps\n          </button>\n          <button\n            onClick={() => toggleLayer(\"haulRoads\")}\n            className={`px-3 py-1.5 rounded-lg border font-medium transition-all ${\n              activeLayers.haulRoads\n                ? \"bg-blue-500/20 border-blue-500/50 text-blue-300\"\n                : \"bg-slate-950 border-slate-800 text-slate-500\"\n            }`}\n          >\n            Haul Roads (1:16 Gradient)\n          </button>\n          <button\n            onClick={() => toggleLayer(\"environmentalSensors\")}\n            className={`px-3 py-1.5 rounded-lg border font-medium transition-all ${\n              activeLayers.environmentalSensors\n                ? \"bg-emerald-500/20 border-emerald-500/50 text-emerald-300\"\n                : \"bg-slate-950 border-slate-800 text-slate-500\"\n            }`}\n          >\n            CAAQMS Sensors\n          </button>\n          <button\n            onClick={() => toggleLayer(\"blastingRadius\")}\n            className={`px-3 py-1.5 rounded-lg border font-medium transition-all ${\n              activeLayers.blastingRadius\n                ? \"bg-orange-500/20 border-orange-500/50 text-orange-300\"\n                : \"bg-slate-950 border-slate-800 text-slate-500\"\n            }`}\n          >\n            500m Danger Zone\n          </button>\n          <button\n            onClick={() => toggleLayer(\"inspectionPins\")}\n            className={`px-3 py-1.5 rounded-lg border font-medium transition-all ${\n              activeLayers.inspectionPins\n                ? \"bg-purple-500/20 border-purple-500/50 text-purple-300\"\n                : \"bg-slate-950 border-slate-800 text-slate-500\"\n            }`}\n          >\n            Inspection Pins\n          </button>\n        </div>\n      </div>\n\n      {/* Main Canvas & Inspector Drawer */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-4 gap-4\">\n        {/* Map Stage (Col 3) */}\n        <div className=\"lg:col-span-3 bg-slate-950 border border-slate-800 rounded-2xl p-3 relative overflow-hidden shadow-2xl min-h-[500px] flex flex-col justify-between\">\n          {/* Compass & Scale Overlay */}\n          <div className=\"absolute top-6 left-6 z-10 bg-slate-900/80 backdrop-blur-md border border-slate-700/80 p-2.5 rounded-xl text-xs space-y-1 shadow-lg\">\n            <div className=\"flex items-center space-x-2 text-slate-200 font-bold\">\n              <Compass className=\"w-4 h-4 text-amber-400 animate-spin-slow\" />\n              <span>North True (TN)</span>\n            </div>\n            <div className=\"text-[10px] text-slate-400 font-mono\">\n              Scale 1 : 10,000 \342\200\242 Datum: WGS 84\n            </div>\n            <div className=\"flex items-center space-x-1 text-[10px] text-emerald-400\">\n              <Radio className=\"w-3 h-3 animate-ping\" />\n              <span>Telemetry: 12 Nodes Online</span>\n            </div>\n          </div>\n\n          {/* Interactive SVG GIS Visualizer */}\n          <div className=\"w-full h-full flex-1 flex items-center justify-center p-2\">\n            <svg\n              viewBox=\"0 0 900 550\"\n              className=\"w-full h-auto max-h-[520px] select-none filter drop-shadow-md\"\n            >\n              <defs>\n                {/* Geological coal patterns */}\n                <pattern id=\"coalSeamPattern\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\">\n                  <path d=\"M 0,10 L 20,10 M 10,0 L 10,20\" stroke=\"#1e293b\" strokeWidth=\"1\" />\n                  <circle cx=\"10\" cy=\"10\" r=\"1.5\" fill=\"#334155\" />\n                </pattern>\n\n                <linearGradient id=\"pitDepthGradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n                  <stop offset=\"0%\" stopColor=\"#1e293b\" stopOpacity=\"0.8\" />\n                  <stop offset=\"50%\" stopColor=\"#0f172a\" stopOpacity=\"0.9\" />\n                  <stop offset=\"100%\" stopColor=\"#020617\" stopOpacity=\"1\" />\n                </linearGradient>\n\n                <linearGradient id=\"dangerZoneGradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n                  <stop offset=\"0%\" stopColor=\"#ef4444\" stopOpacity=\"0.25\" />\n                  <stop offset=\"100%\" stopColor=\"#f97316\" stopOpacity=\"0.05\" />\n                </linearGradient>\n              </defs>\n\n              {/* Background Grid */}\n              <rect x=\"0\" y=\"0\" width=\"900\" height=\"550\" fill=\"#090d16\" />\n              {Array.from({ length: 9 }).map((_, i) => (\n                <line\n                  key={`gx-${i}`}\n                  x1={i * 100}\n                  y1=\"0\"\n                  x2={i * 100}\n                  y2=\"550\"\n                  stroke=\"#1e293b\"\n                  strokeWidth=\"0.5\"\n                  strokeDasharray=\"4 4\"\n                />\n              ))}\n              {Array.from({ length: 6 }).map((_, i) => (\n                <line\n                  key={`gy-${i}`}\n                  x1=\"0\"\n                  y1={i * 100}\n                  x2=\"900\"\n                  y2={i * 100}\n                  stroke=\"#1e293b\"\n                  strokeWidth=\"0.5\"\n                  strokeDasharray=\"4 4\"\n                />\n              ))}\n\n              {/* Layer 1: Leasehold Boundary */}\n              {activeLayers.pitBoundary && (\n                <g>\n                  <polygon\n                    points=\"80,50 820,70 850,480 120,490\"\n                    fill=\"url(#coalSeamPattern)\"\n                    stroke=\"#475569\"\n                    strokeWidth=\"1.5\"\n                    strokeDasharray=\"8 4\"\n                  />\n                  <text x=\"95\" y=\"70\" fill=\"#94a3b8\" fontSize=\"11\" fontWeight=\"bold\" letterSpacing=\"1\">\n                    MINE LEASEHOLD BOUNDARY (ML AREA: 1,480 HECTARES)\n                  </text>\n                </g>\n              )}\n\n              {/* Opencast Quarry Benches vs Underground Panelling */}\n              {!isUnderground ? (\n                /* Opencast Quarry Geometry */\n                <g>\n                  {/* Bench 1: Surface Terrace RL +220m */}\n                  <polygon\n                    points=\"150,110 750,120 780,430 180,440\"\n                    fill=\"url(#pitDepthGradient)\"\n                    stroke=\"#64748b\"\n                    strokeWidth=\"1.5\"\n                  />\n\n                  {/* Bench 2: Intermediate RL +180m */}\n                  <polygon\n                    points=\"200,150 700,160 730,390 220,400\"\n                    fill=\"#0f172a\"\n                    stroke=\"#475569\"\n                    strokeWidth=\"1\"\n                  />\n\n                  {/* Bench 3: Coal Seam Bottom Pit RL +140m */}\n                  <polygon\n                    points=\"260,190 650,200 670,350 280,360\"\n                    fill=\"#020617\"\n                    stroke=\"#f59e0b\"\n                    strokeWidth=\"1.5\"\n                  />\n                  <text x=\"370\" y=\"275\" fill=\"#f59e0b\" fontSize=\"13\" fontWeight=\"bold\">\n                    ACTIVE EXTRACTION FACE (SEAM IV/V - RL 140m)\n                  </text>\n\n                  {/* Overburden Dumps (External & Internal) */}\n                  {activeLayers.slopeStability && (\n                    <g>\n                      {/* East OB Dump */}\n                      <path\n                        d=\"M 680,80 Q 760,50 840,110 L 800,240 Q 720,220 680,80 Z\"\n                        fill=\"#78350f\"\n                        fillOpacity=\"0.4\"\n                        stroke=\"#b45309\"\n                        strokeWidth=\"1.5\"\n                      />\n                      <text x=\"710\" y=\"140\" fill=\"#fcd34d\" fontSize=\"10\" fontWeight=\"bold\">\n                        EAST OB DUMP (120m HT)\n                      </text>\n\n                      {/* Slope Instability Warning Area */}\n                      <circle\n                        cx=\"750\"\n                        cy=\"160\"\n                        r=\"32\"\n                        fill=\"#ef4444\"\n                        fillOpacity=\"0.25\"\n                        stroke=\"#ef4444\"\n                        strokeWidth=\"1.5\"\n                        strokeDasharray=\"4 2\"\n                      />\n                      <text x=\"710\" y=\"175\" fill=\"#fca5a5\" fontSize=\"9\" fontWeight=\"bold\">\n                        Radar Alert: 14.8mm Disp.\n                      </text>\n                    </g>\n                  )}\n\n                  {/* Haul Road Networks */}\n                  {activeLayers.haulRoads && (\n                    <g>\n                      {/* Main Incline Ramp 1 (Compliant 1:16) */}\n                      <path\n                        d=\"M 120,470 C 180,410 240,320 280,260\"\n                        fill=\"none\"\n                        stroke=\"#10b981\"\n                        strokeWidth=\"6\"\n                        strokeLinecap=\"round\"\n                      />\n                      <text x=\"140\" y=\"380\" fill=\"#6ee7b7\" fontSize=\"10\" fontWeight=\"bold\">\n                        Ramp 1 (1:16 Gradient - OK)\n                      </text>\n\n                      {/* East Ramp 3 (Violation: 1:11.5 Gradient) */}\n                      <path\n                        d=\"M 770,390 C 720,330 670,250 630,220\"\n                        fill=\"none\"\n                        stroke=\"#ef4444\"\n                        strokeWidth=\"6\"\n                        strokeDasharray=\"6 3\"\n                        strokeLinecap=\"round\"\n                      />\n                      <text x=\"660\" y=\"310\" fill=\"#fca5a5\" fontSize=\"10\" fontWeight=\"bold\">\n                        Ramp 3 (1:11.5 STEEP VIOLATION)\n                      </text>\n                    </g>\n                  )}\n                </g>\n              ) : (\n                /* Underground Mine Gallery Plan */\n                <g>\n                  {/* Main Incline Shaft */}\n                  <rect x=\"150\" y=\"80\" width=\"600\" height=\"380\" fill=\"#020617\" stroke=\"#334155\" strokeWidth=\"2\" />\n                  <line x1=\"200\" y1=\"80\" x2=\"200\" y2=\"460\" stroke=\"#38bdf8\" strokeWidth=\"4\" />\n                  <line x1=\"300\" y1=\"80\" x2=\"300\" y2=\"460\" stroke=\"#38bdf8\" strokeWidth=\"4\" />\n                  <text x=\"160\" y=\"110\" fill=\"#38bdf8\" fontSize=\"11\" fontWeight=\"bold\">\n                    MAIN INTAKE SHAFT (AIRWAY 1,800 m3/min)\n                  </text>\n\n                  {/* Bord & Pillar / Longwall Panels */}\n                  {Array.from({ length: 5 }).map((_, row) =>\n                    Array.from({ length: 4 }).map((_, col) => (\n                      <rect\n                        key={`panel-${row}-${col}`}\n                        x={360 + col * 75}\n                        y={140 + row * 60}\n                        width=\"55\"\n                        height=\"40\"\n                        fill=\"#1e293b\"\n                        stroke=\"#475569\"\n                        strokeWidth=\"1\"\n                      />\n                    ))\n                  )}\n                  <text x=\"440\" y=\"300\" fill=\"#f59e0b\" fontSize=\"12\" fontWeight=\"bold\">\n                    LONGWALL SHEARER PANEL #16-DIP (CH4: 0.42%)\n                  </text>\n                </g>\n              )}\n\n              {/* 500m Blasting Danger Zone Buffer */}\n              {activeLayers.blastingRadius && (\n                <g>\n                  <circle\n                    cx=\"480\"\n                    cy=\"270\"\n                    r=\"140\"\n                    fill=\"url(#dangerZoneGradient)\"\n                    stroke=\"#ef4444\"\n                    strokeWidth=\"1.5\"\n                    strokeDasharray=\"6 4\"\n                  />\n                  <text x=\"410\" y=\"150\" fill=\"#f87171\" fontSize=\"10\" fontWeight=\"bold\">\n                    500m STATUTORY BLASTING DANGER PERIMETER\n                  </text>\n                </g>\n              )}\n\n              {/* Environmental Monitoring Stations (CAAQMS & Discharge Weirs) */}\n              {activeLayers.environmentalSensors && (\n                <g>\n                  {/* CAAQMS Station 1 */}\n                  <g\n                    className=\"cursor-pointer group\"\n                    onClick={() =>\n                      setSelectedPin({\n                        type: \"sensor\",\n                        data: {\n                          name: \"Continuous Ambient Air Station (CAAQMS-1)\",\n                          location: \"Village Perimeter Boundary (West)\",\n                          pm10: `${selectedMine.telemetry.dustPm10} \302\265g/m\302\263`,\n                          pm25: \"38.4 \302\265g/m\302\263\",\n                          so2: \"14.2 \302\265g/m\302\263\",\n                          nox: \"21.6 \302\265g/m\302\263\",\n                          status: selectedMine.telemetry.dustPm10 > 100 ? \"Breach (NAAQS)\" : \"Compliant\",\n                        },\n                      })\n                    }\n                  >\n                    <circle cx=\"130\" cy=\"180\" r=\"14\" fill=\"#10b981\" fillOpacity=\"0.3\" />\n                    <circle cx=\"130\" cy=\"180\" r=\"8\" fill=\"#10b981\" />\n                    <text x=\"110\" y=\"210\" fill=\"#a7f3d0\" fontSize=\"9\" fontWeight=\"bold\">\n                      CAAQMS-1 (Dust)\n                    </text>\n                  </g>\n\n                  {/* Effluent Discharge Weir #2 */}\n                  <g\n                    className=\"cursor-pointer group\"\n                    onClick={() =>\n                      setSelectedPin({\n                        type: \"sensor\",\n                        data: {\n                          name: \"Mine Water Discharge Weir & ETP\",\n                          location: \"East Sump Settling Pond #3\",\n                          ph: selectedMine.telemetry.waterPh,\n                          tss: \"68 mg/L (Max 100)\",\n                          flowRate: \"4,200 m3/day\",\n                          status: \"Compliant with SPCB Consent\",\n                        },\n                      })\n                    }\n                  >\n                    <circle cx=\"780\" cy=\"420\" r=\"14\" fill=\"#3b82f6\" fillOpacity=\"0.3\" />\n                    <circle cx=\"780\" cy=\"420\" r=\"8\" fill=\"#3b82f6\" />\n                    <text x=\"740\" y=\"445\" fill=\"#93c5fd\" fontSize=\"9\" fontWeight=\"bold\">\n                      ETP Discharge Weir\n                    </text>\n                  </g>\n                </g>\n              )}\n\n              {/* Geo-Tagged Statutory Violations & Inspections Pins */}\n              {activeLayers.inspectionPins && (\n                <g>\n                  {mineViolations.map((v, idx) => {\n                    const cx = 680 - idx * 120;\n                    const cy = 240 + idx * 45;\n                    return (\n                      <g\n                        key={v.id}\n                        className=\"cursor-pointer transition-all hover:scale-110\"\n                        onClick={() => setSelectedPin({ type: \"violation\", data: v })}\n                      >\n                        <circle\n                          cx={cx}\n                          cy={cy}\n                          r=\"18\"\n                          fill={v.severity === \"Critical\" ? \"#ef4444\" : \"#f59e0b\"}\n                          fillOpacity=\"0.3\"\n                          className=\"animate-pulse\"\n                        />\n                        <circle\n                          cx={cx}\n                          cy={cy}\n                          r=\"9\"\n                          fill={v.severity === \"Critical\" ? \"#ef4444\" : \"#f59e0b\"}\n                          stroke=\"#ffffff\"\n                          strokeWidth=\"1.5\"\n                        />\n                        <text\n                          x={cx - 15}\n                          y={cy - 12}\n                          fill=\"#ffffff\"\n                          fontSize=\"9\"\n                          fontWeight=\"bold\"\n                          className=\"bg-slate-900\"\n                        >\n                          {v.id.slice(-4)}\n                        </text>\n                      </g>\n                    );\n                  })}\n\n                  {mineInspections.map((i, idx) => (\n                    <g\n                      key={i.id}\n                      className=\"cursor-pointer\"\n                      onClick={() => setSelectedPin({ type: \"inspection\", data: i })}\n                    >\n                      <circle cx={290 + idx * 80} cy={320} r=\"12\" fill=\"#8b5cf6\" fillOpacity=\"0.4\" />\n                      <circle cx={290 + idx * 80} cy={320} r=\"7\" fill=\"#8b5cf6\" stroke=\"#ffffff\" strokeWidth=\"1\" />\n                      <text x={260 + idx * 80} y={345} fill=\"#ddd6fe\" fontSize=\"9\" fontWeight=\"bold\">\n                        Audit Point\n                      </text>\n                    </g>\n                  ))}\n                </g>\n              )}\n            </svg>\n          </div>\n\n          {/* Bottom Coordinate & Bench Telemetry Bar */}\n          <div className=\"bg-slate-900/90 border border-slate-800 rounded-xl p-3 flex flex-wrap items-center justify-between gap-2 text-xs\">\n            <div className=\"flex items-center space-x-4\">\n              <span className=\"text-slate-400\">\n                Active Fleet: <strong className=\"text-amber-300\">42 Dumpers (240T) \342\200\242 6 Hydraulic Shovels</strong>\n              </span>\n              <span className=\"text-slate-400\">\n                Slope Radar: <strong className=\"text-emerald-400\">0.18 mm/hr Steady</strong>\n              </span>\n            </div>\n            <div className=\"flex items-center space-x-2 text-slate-400\">\n              <Navigation className=\"w-3.5 h-3.5 text-amber-400\" />\n              <span>Geo-Fence Status: <strong>Fully Monitored (100% DGMS Compliant)</strong></span>\n            </div>\n          </div>\n        </div>\n\n        {/* Right Drawer: Selected Pin Details */}\n        <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-lg flex flex-col justify-between\">\n          <div>\n            <div className=\"flex items-center justify-between pb-3 border-b border-slate-800\">\n              <h3 className=\"text-sm font-bold text-white flex items-center gap-2\">\n                <MapPin className=\"w-4 h-4 text-amber-400\" />\n                <span>Spatial Feature Inspector</span>\n              </h3>\n              {selectedPin && (\n                <button\n                  onClick={() => setSelectedPin(null)}\n                  className=\"text-xs text-slate-500 hover:text-slate-300\"\n                >\n                  Clear\n                </button>\n              )}\n            </div>\n\n            {selectedPin ? (\n              <div className=\"mt-4 space-y-3.5 text-xs animate-in fade-in duration-300\">\n                {selectedPin.type === \"violation\" && (\n                  <>\n                    <div className=\"flex items-center justify-between\">\n                      <span className=\"font-mono font-bold text-amber-400\">{selectedPin.data.id}</span>\n                      <span\n                        className={`px-2 py-0.5 rounded text-[10px] font-bold uppercase ${\n                          selectedPin.data.severity === \"Critical\"\n                            ? \"bg-red-500/20 text-red-400 border border-red-500/30\"\n                            : \"bg-amber-500/20 text-amber-400\"\n                        }`}\n                      >\n                        {selectedPin.data.severity} Severity\n                      </span>\n                    </div>\n\n                    <div>\n                      <span className=\"text-slate-400 text-[11px] block\">Statutory Clause:</span>\n                      <strong className=\"text-slate-100\">{selectedPin.data.clause}</strong>\n                    </div>\n\n                    <div>\n                      <span className=\"text-slate-400 text-[11px] block\">Description:</span>\n                      <p className=\"text-slate-300 leading-relaxed mt-0.5\">{selectedPin.data.description}</p>\n                    </div>\n\n                    <div className=\"bg-slate-950 p-2.5 rounded-lg border border-slate-800 space-y-1\">\n                      <div className=\"flex justify-between\">\n                        <span className=\"text-slate-500\">Bench / Seam:</span>\n                        <span className=\"text-slate-300 font-medium\">\n                          {selectedPin.data.geoTag?.bench || \"Bench 4\"}\n                        </span>\n                      </div>\n                      <div className=\"flex justify-between\">\n                        <span className=\"text-slate-500\">Notice Ref:</span>\n                        <span className=\"text-slate-300 font-mono\">{selectedPin.data.noticeRef}</span>\n                      </div>\n                      <div className=\"flex justify-between\">\n                        <span className=\"text-slate-500\">Deadline:</span>\n                        <span className=\"text-red-400 font-bold\">{selectedPin.data.statutoryDeadline}</span>\n                      </div>\n                    </div>\n\n                    {selectedPin.data.actionTaken && (\n                      <div className=\"p-2 bg-emerald-950/40 border border-emerald-800/40 rounded-lg text-emerald-300\">\n                        <strong className=\"block text-[11px]\">Action Taken:</strong>\n                        <span>{selectedPin.data.actionTaken}</span>\n                      </div>\n                    )}\n                  </>\n                )}\n\n                {selectedPin.type === \"sensor\" && (\n                  <>\n                    <div className=\"flex items-center space-x-2\">\n                      <Wind className=\"w-4 h-4 text-emerald-400\" />\n                      <strong className=\"text-slate-100 text-sm\">{selectedPin.data.name}</strong>\n                    </div>\n                    <p className=\"text-slate-400\">{selectedPin.data.location}</p>\n\n                    <div className=\"bg-slate-950 p-3 rounded-lg border border-slate-800 space-y-2\">\n                      {selectedPin.data.pm10 && (\n                        <div className=\"flex justify-between items-center\">\n                          <span className=\"text-slate-400\">Dust (PM10):</span>\n                          <span className=\"text-amber-300 font-bold\">{selectedPin.data.pm10}</span>\n                        </div>\n                      )}\n                      {selectedPin.data.ph && (\n                        <div className=\"flex justify-between items-center\">\n                          <span className=\"text-slate-400\">Water pH:</span>\n                          <span className=\"text-blue-300 font-bold\">{selectedPin.data.ph}</span>\n                        </div>\n                      )}\n                      <div className=\"flex justify-between items-center\">\n                        <span className=\"text-slate-400\">Status:</span>\n                        <span className=\"text-emerald-400 font-bold\">{selectedPin.data.status}</span>\n                      </div>\n                    </div>\n                  </>\n                )}\n\n                {selectedPin.type === \"inspection\" && (\n                  <>\n                    <strong className=\"text-slate-100 text-sm block\">Statutory Audit Point</strong>\n                    <p className=\"text-slate-400\">Auditor: {selectedPin.data.inspectorName}</p>\n                    <p className=\"text-slate-300\">\n                      Checklist: {selectedPin.data.checklistSummary.passed} passed / {selectedPin.data.checklistSummary.failed} observations.\n                    </p>\n                  </>\n                )}\n              </div>\n            ) : (\n              <div className=\"mt-8 text-center text-slate-500 py-12 space-y-2\">\n                <Info className=\"w-8 h-8 mx-auto text-slate-600 stroke-[1.5]\" />\n                <p className=\"text-xs\">\n                  Click on any hazard pin, sensor station, or haul road ramp on the GIS canvas to inspect detailed statutory telemetry.\n                </p>\n              </div>\n            )}\n          </div>\n\n          <div className=\"mt-4 pt-3 border-t border-slate-800\">\n            <div className=\"bg-slate-950 p-3 rounded-xl border border-slate-800 text-[11px] space-y-1\">\n              <span className=\"text-slate-400 block font-semibold\">Survey Drone Sync:</span>\n              <span className=\"text-slate-300\">Last Orthomosaic update: 24-Aug-2026 (Accuracy: \302\2612.5 cm GSD)</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
    diff {
      unified_diff {
        lines {
          text: "import React, { useState } from \"react\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import { MineSite, StatutoryViolation, InspectionRecord } from \"../types\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
