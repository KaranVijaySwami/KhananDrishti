800/40\"\n                          : \"bg-red-950/40 text-red-300 border border-red-800/40\"\n                      }`}\n                    >\n                      {c.status.replace(\"_\", \" \")}\n                    </span>\n                  </div>\n\n                  <span className=\"text-[11px] font-mono text-neutral-400 block mt-1\">\n                    {c.contractCode}\n                  </span>\n\n                  <div className=\"mt-2.5 flex items-center justify-between text-xs pt-2 border-t border-[#222] font-mono\">\n                    <span className=\"text-neutral-400\">{c.totalWorkers} Workers</span>\n                    <span className=\"text-[#FF4D00] font-semibold\">\n                      Safety Score: {c.safetyInductionScore}%\n                    </span>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Right 2 Cols: Detailed Contractor Profile & Safety Compliance */}\n        {selectedContractor && (\n          <div className=\"lg:col-span-2 bg-[#0e0e0e] border border-[#222] rounded-xl p-6 shadow-lg space-y-6\">\n            <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-[#222]\">\n              <div>\n                <span className=\"text-[11px] font-mono text-[#FF4D00] font-bold block\">\n                  {selectedContractor.contractCode}\n                </span>\n                <h3 className=\"text-lg font-serif font-semibold text-white mt-0.5\">\n                  {selectedContractor.contractorName}\n                </h3>\n                <p className=\"text-xs text-neutral-400 mt-0.5\">\n                  Supervisor: {selectedContractor.supervisorName} \342\200\242 Contact: {selectedContractor.contactNumber}\n                </p>\n              </div>\n\n              <div className=\"flex items-center space-x-2\">\n                <span\n                  className={`px-3 py-1 rounded-lg text