  file_change {
    absolute_path_uri: "file:///server.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import express, { Request, Response } from \"express\";\nimport path from \"path\";\nimport dotenv from \"dotenv\";\nimport { createServer as createViteServer } from \"vite\";\nimport { GoogleGenAI } from \"@google/genai\";\n\ndotenv.config();\n\nconst app = express();\nconst PORT = 3000;\n\napp.use(express.json({ limit: \"25mb\" }));\n\n// Lazy/Safe Gemini AI initialization\nfunction getGeminiClient(): GoogleGenAI | null {\n  const apiKey = process.env.GEMINI_API_KEY;\n  if (!apiKey) {\n    console.warn(\"GEMINI_API_KEY is not set in environment.\");\n    return null;\n  }\n  return new GoogleGenAI({\n    apiKey,\n    httpOptions: {\n      headers: {\n        \"User-Agent\": \"aistudio-build\",\n      },\n    },\n  });\n}\n\n// Health check\napp.get(\"/api/health\", (_req: Request, res: Response) => {\n  res.json({\n    status: \"ok\",\n    app: \"KhananDrishti - Coal Mining Smart Governance & Compliance Platform\",\n    version: \"2.4.0\",\n    geminiEnabled: Boolean(process.env.GEMINI_API_KEY),\n    timestamp: new Date().toISOString(),\n  });\n});\n\n// AI Compliance Risk & Hazard Engine\napp.post(\"/api/ai/analyze-risk\", async (req: Request, res: Response) => {\n  try {\n    const { mineData, violations, environmentalMetrics } = req.body;\n    const ai = getGeminiClient();\n\n    if (!ai) {\n      // Fallback deterministic analysis if Gemini key not present\n      return res.json({\n        success: true,\n        isSimulated: true,\n        riskScore: 74,\n        hazardLevel: \"High\",\n        summary: \"Calculated based on local safety telemetry: elevated OB dump slope displacement (14.2mm) and 2 overdue DGMS ventilation audits in Seam IV.\",\n        highRiskAreas: [\n          {\n            area: \"Gevra OC Pit - East Flank Bench #4\",\n            hazard: \"Slope stability factor below 1.15 (DGMS Reg 106)\",\n            severity: \"Critical\",\n            recommendedAction: \"Immediately restrict dumper haulage, deploy radar extensometers, and reslope bench angle to 45 degrees.\",\n            statutoryReference: \"CMR 2017 Reg 106 / DGMS Tech Circular 04 of 2020\",\n          },\n          {\n            area: \"Dip Side Sump & Main Return Airway\",\n            hazard: \"Methane concentration transient spike to 0.72% near fault zone\",\n            severity: \"High\",\n            recommendedAction: \"Increase auxiliary fan output to 1200 m3/min, perform flame safety lamp / multi-gas detector verification every 2 hours.\",\n            statutoryReference: \"CMR 2017 Reg 153(2) & Reg 169\",\n          },\n        ],\n        predictiveTrends: [\n          \"Without corrective haul road dust suppression, PM10 will breach NAAQS limit (100 ug/m3) within 48 hours during current dry-spell.\",\n          \"Contractor worker safety induction lapse rate is 18%, correlating with 62% of near-miss occurrences.\",\n        ],\n        complianceForecastScore: 81,\n      });\n    }\n\n    const prompt = `You are the Chief Safety & Environmental Governance Officer for Coal India Limited (CIL) and DGMS statutory auditor.\nAnalyze the following coal mining operational, environmental, and statutory compliance data:\n\nMINE DATA:\n${JSON.stringify(mineData, null, 2)}\n\nVIOLATIONS & INSPECTION FINDINGS:\n${JSON.stringify(violations, null, 2)}\n\nENVIRONMENTAL SENSOR TELEMETRY:\n${JSON.stringify(environmentalMetrics, null, 2)}\n\nProvide a strict, professional JSON response matching this schema:\n{\n  \"riskScore\": number (0-100, where 100 is highest risk),\n  \"hazardLevel\": \"Low\" | \"Medium\" | \"High\" | \"Critical\",\n  \"summary\": string (concise executive overview),\n  \"highRiskAreas\": [\n    {\n      \"area\": string,\n      \"hazard\": string,\n      \"severity\": \"Low\" | \"Medium\" | \"High\" | \"Critical\",\n      \"recommendedAction\": string,\n      \"statutoryReference\": string (e.g., Coal Mines Regulations 2017, Mines Act 1952, DGMS Circulars, MoEFCC EC Conditions)\n    }\n  ],\n  \"predictiveTrends\": [string, string, string],\n  \"complianceForecastScore\": number (0-100 expected safety score next month)\n}\nReturn ONLY valid JSON.`;\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.7-flash\",\n      contents: prompt,\n      config: {\n        responseMimeType: \"application/json\",\n        temperature: 0.2,\n      },\n    });\n\n    const parsed = JSON.parse(response.text || \"{}\");\n    res.json({ success: true, isSimulated: false, ...parsed });\n  } catch (error: any) {\n    console.error(\"AI Risk analysis error:\", error);\n    res.status(500).json({ error: error.message || \"Failed to analyze risk\" });\n  }\n});\n\n// AI OCR Document Digitization (Statutory Notice, EC letter, DGMS Notice, SPCB Consent)\napp.post(\"/api/ai/ocr-doc\", async (req: Request, res: Response) => {\n  try {\n    const { documentBase64, mimeType = \"image/png\", documentText, docType } = req.body;\n    const ai = getGeminiClient();\n\n    if (!ai) {\n      return res.json({\n        success: true,\n        isSimulated: true,\n        extractedData: {\n          issuingAuthority: \"Directorate General of Mines Safety (DGMS), South Eastern Zone\",\n          referenceNumber: \"DGMS/SEZ/SECL/Dipka-OC/2026/SEC-22(3)/884\",\n          subject: \"Notice under Section 22(3) of Mines Act, 1952 regarding Haul Road gradient & OB Dump berm heights\",\n          issueDate: \"2026-08-15\",\n          statutoryDeadline: \"2026-09-14\",\n          riskRating: \"High Penalty / Temporary Closure Warning\",\n          covenants: [\n            {\n              clause: \"Reg 107 - Haul Road Dimensions\",\n              requirement: \"Gradient shall not exceed 1 in 16 and width must be at least 3x the width of largest dumper (240T CAT 793D).\",\n              status: \"Non-Compliant (Current gradient 1 in 11.5 on Incline Ramp 3)\",\n            },\n            {\n              clause: \"DGMS Tech Circular 02/2019\",\n              requirement: \"Parapet walls/berms shall not be less than the diameter of largest tyre (3.5 meters) along quarry crest.\",\n              status: \"Partially Compliant (Berm height found at 2.1m near Bench 6)\",\n            },\n            {\n              clause: \"Mines Act 1952 Sec 22A\",\n              requirement: \"Submission of certified Action Taken Report (ATR) signed by Colliery Manager and General Manager within 30 days.\",\n              status: \"Pending Action Plan\",\n            },\n          ],\n          actionItems: [\n            {\n              task: \"Reslope Ramp 3 gradient to 1 in 16 using grader & dozer fleet.\",\n              assignedTo: \"Colliery Engineer (Civil & Excavation)\",\n              targetDate: \"2026-08-30\",\n              priority: \"Critical\",\n            },\n            {\n              task: \"Raise dump berms to 3.8m along entire 2.4 km quarry perimeter.\",\n              assignedTo: \"Overman In-Charge (OB Bench)\",\n              targetDate: \"2026-09-05\",\n              priority: \"High\",\n            },\n            {\n              task: \"Draft and upload digital Action Taken Report with geo-tagged drone orthophoto evidence.\",\n              assignedTo: \"Safety Officer / Nodal Governance Officer\",\n              targetDate: \"2026-09-10\",\n              priority: \"Urgent\",\n            },\n          ],\n        },\n      });\n    }\n\n    const parts: any[] = [];\n    if (documentBase64) {\n      parts.push({\n        inlineData: {\n          mimeType: mimeType || \"image/png\",\n          data: documentBase64,\n        },\n      });\n    }\n\n    const textPrompt = `You are an expert OCR & Statutory Mining Document Parser for Indian Coal Mines (CIL, DGMS, MoEFCC, SPCB, CCO).\nDocument Type Category: ${docType || \"Statutory Mining Notice / Environmental Clearance\"}\n\nInput text/content:\n${documentText || \"Analyze the uploaded document image.\"}\n\nExtract all statutory covenants, reference numbers, issuing authority, clauses, violations cited, compliance deadlines, penalties, and mandatory action items.\nReturn ONLY valid JSON matching this schema:\n{\n  \"extractedData\": {\n    \"issuingAuthority\": string,\n    \"referenceNumber\": string,\n    \"subject\": string,\n    \"issueDate\": string (YYYY-MM-DD),\n    \"statutoryDeadline\": string (YYYY-MM-DD),\n    \"riskRating\": string,\n    \"covenants\": [\n      {\n        \"clause\": string,\n        \"requirement\": string,\n        \"status\": string\n      }\n    ],\n    \"actionItems\": [\n      {\n        \"task\": string,\n        \"assignedTo\": string,\n        \"targetDate\": string,\n        \"priority\": \"Critical\" | \"High\" | \"Medium\" | \"Low\"\n      }\n    ]\n  }\n}`;\n\n    parts.push({ text: textPrompt });\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.7-flash\",\n      contents: { parts },\n      config: {\n        responseMimeType: \"application/json\",\n        temperature: 0.1,\n      },\n    });\n\n    const parsed = JSON.parse(response.text || \"{}\");\n    res.json({ success: true, isSimulated: false, ...parsed });\n  } catch (error: any) {\n    console.error(\"AI OCR error:\", error);\n    res.status(500).json({ error: error.message || \"Failed to parse document\" });\n  }\n});\n\n// AI Action Taken Report (ATR) Generator\napp.post(\"/api/ai/generate-atr\", async (req: Request, res: Response) => {\n  try {\n    const { mineName, subsidiary, violationRef, observations, correctiveActionsTaken } = req.body;\n    const ai = getGeminiClient();\n\n    if (!ai) {\n      return res.json({\n        success: true,\n        isSimulated: true,\n        atrReport: {\n          title: `STATUTORY ACTION TAKEN REPORT (ATR) - ${subsidiary?.toUpperCase()} / ${mineName?.toUpperCase()}`,\n          refNumber: `CIL/${subsidiary}/ATR/2026/${Date.now().toString().slice(-5)}`,\n          submissionDate: new Date().toISOString().split(\"T\")[0],\n          executiveSummary: `Action Taken Report against DGMS inspection observation (${violationRef}). All remedial civil earthworks, slope stabilization, and safety audit covenants have been executed in full compliance with Coal Mines Regulations 2017.`,\n          statutoryProvisionsComplied: [\n            \"Coal Mines Regulations 2017 - Regulation 106 & 107 (Opencast workings & Haul Roads)\",\n            \"Mines Act 1952 - Section 22(3) Compliance\",\n            \"MoEFCC Specific Condition IV (Continuous Ambient Air Quality Monitoring & Green Belt)\",\n          ],\n          tableOfActions: [\n            {\n              observation: \"Haul road ramp gradient exceeded permissible 1 in 16 slope on East Quarry Section\",\n              actionTaken: \"Regraded by CAT 16M motor grader fleet with certified 1 in 16.5 longitudinal profile confirmed via Total Station survey.\",\n              verificationStatus: \"Verified & Certified by Safety Officer\",\n              complianceDate: \"2026-08-20\",\n            },\n            {\n              observation: \"Overburden dump parapet berm height below minimum tyre height requirement\",\n              actionTaken: \"Constructed continuous 3.8m high rock-fill berm along 2.4 km crest with reflective delineators every 15 meters.\",\n              verificationStatus: \"Verified by Colliery Overman & Drone GIS orthomosaic\",\n              complianceDate: \"2026-08-22\",\n            },\n          ],\n          managerDeclaration: `I hereby declare as statutory Mines Manager under Section 17 of Mines Act 1952 that all the corrective measures documented above have been physically executed and verified under my direct supervision.`,\n        },\n      });\n    }\n\n    const prompt = `You are the Statutory Mines Manager and Legal Compliance Counsel for Coal India Limited.\nDraft an official, legally sound, and comprehensive Action Taken Report (ATR) for submission to DGMS / MoEFCC.\n\nDetails:\nMine: ${mineName}\nSubsidiary: ${subsidiary}\nViolation / Inspection Reference: ${violationRef}\nObservations Recorded: ${JSON.stringify(observations)}\nCorrective Actions Taken: ${JSON.stringify(correctiveActionsTaken)}\n\nReturn a strict JSON format:\n{\n  \"atrReport\": {\n    \"title\": string,\n    \"refNumber\": string,\n    \"submissionDate\": string,\n    \"executiveSummary\": string,\n    \"statutoryProvisionsComplied\": [string],\n    \"tableOfActions\": [\n      {\n        \"observation\": string,\n        \"actionTaken\": string,\n        \"verificationStatus\": string,\n        \"complianceDate\": string\n      }\n    ],\n    \"managerDeclaration\": string\n  }\n}\nReturn ONLY valid JSON.`;\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.7-flash\",\n      contents: prompt,\n      config: {\n        responseMimeType: \"application/json\",\n        temperature: 0.2,\n      },\n    });\n\n    const parsed = JSON.parse(response.text || \"{}\");\n    res.json({ success: true, isSimulated: false, ...parsed });\n  } catch (error: any) {\n    console.error(\"AI ATR generator error:\", error);\n    res.status(500).json({ error: error.message || \"Failed to generate ATR\" });\n  }\n});\n\n// AI Conversational Regulations & Governance Copilot\napp.post(\"/api/ai/chat-copilot\", async (req: Request, res: Response) => {\n  try {\n    const { messages, currentContext } = req.body;\n    const ai = getGeminiClient();\n\n    if (!ai) {\n      const lastMsg = messages && messages.length ? messages[messages.length - 1].content : \"\";\n      return res.json({\n        success: true,\n        isSimulated: true,\n        reply: `**Statutory Advisory (CMR 2017 & Mines Act 1952)**:\nRegarding \"${lastMsg.slice(0, 80)}...\":\n\n1. **Applicable Statutory Law**: Under **Coal Mines Regulations (CMR) 2017, Regulation 106 & 107**, opencast mine benches in hard rock must maintain bench height not exceeding the digging depth of the excavator, and haul roads must strictly maintain a maximum gradient of **1 in 16** with continuous parapet berms equal to the largest wheel diameter.\n2. **DGMS Circular Mandate**: As per DGMS Tech Circular (Safety) No. 04 of 2020, real-time slope stability radar or digital prism monitoring is mandatory for all high-wall dumps exceeding 30m height.\n3. **Action Required**: Record observations in Form IV statutory register, notify the Colliery Manager within 2 hours, and ensure digital geo-tagged logging in the KhananDrishti platform.`,\n      });\n    }\n\n    const conversationHistory = (messages || []).map((m: any) => `${m.role === \"user\" ? \"User\" : \"Assistant\"}: ${m.content}`).join(\"\\n\");\n\n    const systemPrompt = `You are \"KhananDrishti AI\", the Chief Statutory Mining Governance & Regulatory Advisor for Indian Coal Mining Operations.\nYou possess authoritative mastery of:\n- Coal Mines Regulations, 2017 (CMR 2017)\n- The Mines Act, 1952 & Mines Rules, 1955\n- DGMS Technical Circulars (Safety, Electrical, Mechanical, Ventilation, Opencast)\n- MoEFCC Environment Clearance (EC) General and Specific Conditions, Forest Clearance (FC) Act 1980\n- Central Pollution Control Board (CPCB) & State SPCB Air/Water Consent to Operate (CTO/CTE) norms\n- Star Rating of Coal Mines System (Ministry of Coal guidelines)\n- Contract Labour (Regulation and Abolition) Act, 1970 & Form B Worker Registers\n- Emergency Action Plans (EAP) & Mine Closure Plans (Progressive/Final MCP)\n\nCurrent context:\n${JSON.stringify(currentContext || {})}\n\nProvide precise, legally sound, actionable advice formatted in Markdown with bold regulation citations and bullet points.`;\n\n    const prompt = `${systemPrompt}\\n\\nConversation History:\\n${conversationHistory}\\n\\nAssistant:`;\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.7-flash\",\n      contents: prompt,\n      config: {\n        temperature: 0.25,\n      },\n    });\n\n    res.json({\n      success: true,\n      isSimulated: false,\n      reply: response.text || \"No response generated.\",\n    });\n  } catch (error: any) {\n    console.error(\"AI Chat error:\", error);\n    res.status(500).json({ error: error.message || \"Failed to generate advice\" });\n  }\n});\n\n// Setup Vite dev server or production static serving\nasync function startServer() {\n  if (process.env.NODE_ENV !== \"production\") {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \"spa\",\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.join(process.cwd(), \"dist\");\n    app.use(express.static(distPath));\n    app.get(\"*\", (_req: Request, res: Response) => {\n      res.sendFile(path.join(distPath, \"index.html\"));\n    });\n  }\n\n  app.listen(PORT, \"0.0.0.0\", () => {\n    console.log(`KhananDrishti Server active on http://0.0.0.0:${PORT}`);\n  });\n}\n\nstartServer();\n"
    }
